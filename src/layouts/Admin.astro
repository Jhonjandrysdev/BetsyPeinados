---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { demoMode } from '../lib/db';
interface Props {
  title: string;
  /** Subtítulo en escritorio (en móvil se oculta para ganar altura). */
  subtitle?: string;
  /** Subtítulo solo para móvil (p. ej., la fecha de hoy en la Agenda). */
  mobileSub?: string;
  /** Saludo «Buenos días, Betsy» (solo en la Agenda). */
  greet?: boolean;
}
const { title, subtitle, mobileSub, greet: showGreet = false } = Astro.props;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
// Aviso que pide hacer algo (no es un error del formulario): no se cierra solo.
const warn = Astro.url.searchParams.get('warn');
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';
const nav = [
  { href: '/admin', label: 'Agenda', icon: 'calendar' },
  { href: '/admin/servicios', label: 'Servicios', icon: 'scissors' },
  { href: '/admin/horario', label: 'Horario', icon: 'clock' },
  { href: '/admin/ajustes', label: 'Ajustes', icon: 'settings' },
] as const;
const hour = Number(new Intl.DateTimeFormat('es-CO', { hour: 'numeric', hour12: false, timeZone: 'America/Bogota' }).format(new Date()));
const leads: Record<string, string> = { '/admin': 'Tu', '/admin/servicios': 'Tus', '/admin/horario': 'Tu', '/admin/ajustes': 'Tus' };
const lead = leads[path];
const greet = hour < 12 ? 'Buenos días' : hour < 19 ? 'Buenas tardes' : 'Buenas noches';
---

<Base title={`${title} · Panel Betsy Peinados`} description="Panel de administración" noindex bodyClass="admin">
  <div class="a-shell">
    <aside class="a-side" aria-label="Menú del panel">
      <a href="/admin" class="a-brand">
        <img src="/logo.webp" alt="" width="44" height="44" />
        <span>Betsy <small>panel</small></span>
      </a>
      <nav class="a-nav" aria-label="Secciones">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
              <Icon name={n.icon} size={20} />
              <span>{n.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="a-side-foot">
        <a href="/" target="_blank" rel="noopener" class="a-side-link" aria-label="Ver mi página (se abre en otra pestaña)">
          <Icon name="external" size={18} /> <span>Ver mi página</span>
        </a>
        <form method="post" action="/api/admin/logout">
          <button type="submit" class="a-side-link" aria-label="Cerrar sesión"><Icon name="logout" size={18} /> <span>Salir</span></button>
        </form>
      </div>
    </aside>

    <div class="a-body" id="contenido" tabindex="-1">
      <header class="a-head">
        <div class="a-head-text">
          {showGreet && <p class="a-greet">{greet}, Betsy</p>}
          <h1>{lead && <span class="a-lead">{lead} </span>}<em>{lead ? title.toLowerCase() : title}</em></h1>
          {subtitle && <p class="a-sub">{subtitle}</p>}
          {mobileSub && <p class="a-sub-m">{mobileSub}</p>}
        </div>
        <div class="a-head-actions"><slot name="actions" /></div>
      </header>
      <main class="a-main">
        {
          demoMode && (
            <p class="a-demo">
              <i aria-hidden="true" />
              Modo de prueba: lo que hagas aquí no se guarda.
            </p>
          )
        }
        <slot />
      </main>
    </div>
  </div>

  <nav class="a-tabs" aria-label="Secciones">
    {
      nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
          <Icon name={n.icon} size={22} />
          <span>{n.label}</span>
        </a>
      ))
    }
  </nav>

  <!-- Los avisos se insertan desde <template> después de cargar para que los lectores de pantalla los anuncien. -->
  <div class="toasts" aria-live="polite"></div>
  {
    ok && (
      <template data-toast-tpl data-kind="ok" data-msg={ok}>
        <div class="toast ok">
          <span class="t-ico"><Icon name="check" size={18} /></span>
          <span class="t-txt">{ok}</span>
          <button type="button" class="t-x" aria-label="Cerrar aviso" data-toast-close><Icon name="close" size={16} /></button>
        </div>
      </template>
    )
  }
  {
    warn && (
      <template data-toast-tpl data-kind="warn" data-msg={warn}>
        <div class="toast warn">
          <span class="t-ico" aria-hidden="true">!</span>
          <span class="t-txt">{warn}</span>
          <button type="button" class="t-x" aria-label="Cerrar aviso" data-toast-close><Icon name="close" size={16} /></button>
        </div>
      </template>
    )
  }
  {
    error && (
      <template data-toast-tpl data-kind="err" data-msg={error}>
        <div class="toast err">
          <span class="t-ico" aria-hidden="true">!</span>
          <span class="t-txt">{error}</span>
          <button type="button" class="t-x" aria-label="Cerrar aviso" data-toast-close><Icon name="close" size={16} /></button>
        </div>
      </template>
    )
  }

  <dialog class="a-confirm" id="a-confirm" role="alertdialog" aria-labelledby="c-msg">
    <form method="dialog">
      <p class="c-ico"><Icon name="ban" size={26} /></p>
      <p class="c-msg" id="c-msg" data-confirm-msg></p>
      <div class="c-acts">
        <button value="cancel" class="btn btn-ghost btn-sm">No, volver</button>
        <button value="ok" class="btn btn-danger-solid btn-sm" data-confirm-ok>Sí, continuar</button>
      </div>
    </form>
  </dialog>
</Base>

<style is:global>
  body.admin {
    --side-w: 248px;
    --a-bg: #f3ebe1;
    /* Texto: 6 tamaños, mínimo 12 px */
    --t-xs: 0.75rem;
    --t-sm: 0.875rem;
    --t-md: 1rem;
    --t-lg: 1.25rem;
    --t-xl: 1.75rem;
    --t-2xl: clamp(1.9rem, 2.6vw, 2.5rem);
    /* Espaciado */
    --s-1: 4px;
    --s-2: 8px;
    --s-3: 12px;
    --s-4: 16px;
    --s-5: 24px;
    --s-6: 32px;
    --s-7: 48px;
    /* Radios */
    --r-lg: 24px;
    --r-md: 16px;
    --r-sm: 12px;
    --r-xs: 8px;
    /* Color: texto pequeño acentuado y gris con contraste AA sobre los fondos tintados */
    --accent-text: var(--clay-deep);
    --clay-ink: #a4512f;
    --muted: #6b584e;
    --field-line: color-mix(in oklab, var(--cocoa) 50%, transparent);
    --tab-h: 64px;
    background: var(--a-bg);
    font-size: 1rem;
    /* Cifras alineadas (Fraunces usa cifras de estilo antiguo en algunos tamaños) */
    font-variant-numeric: lining-nums;
  }
  @media (min-width: 861px) {
    html:has(form[data-sticky-save]) {
      scroll-padding-bottom: 110px;
    }
  }
  body.admin ::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  body.admin .field input,
  body.admin .field select,
  body.admin .field textarea,
  body.admin .input {
    border-color: var(--field-line);
    border-radius: var(--r-sm);
  }
  body.admin .field input:focus,
  body.admin .field select:focus,
  body.admin .field textarea:focus,
  body.admin .input:focus {
    border-color: var(--clay);
  }
  body.admin .field label {
    font-size: var(--t-sm);
  }
  /* Misma altura para todos los campos de una línea (fecha y hora incluidas) */
  body.admin .field > input:not([type='checkbox']):not([type='file']),
  body.admin .field > select {
    height: 52px;
    min-height: 52px;
    padding-block: 0;
  }
  body.admin input::-webkit-datetime-edit {
    padding: 0;
  }
  body.admin .field .hint {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  body.admin .field input[aria-invalid='true'],
  body.admin .input[aria-invalid='true'] {
    border-color: #b3261e;
  }

  /* ───────── Estructura ───────── */
  .a-shell {
    display: grid;
    grid-template-columns: var(--side-w) 1fr;
    min-height: 100dvh;
  }
  .a-side {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.5rem 1rem;
    background: var(--cocoa);
    color: var(--cream);
    background-image: radial-gradient(120% 60% at 0% 0%, rgb(184 96 63 / 0.35), transparent 60%),
      radial-gradient(90% 50% at 100% 100%, rgb(125 138 104 / 0.25), transparent 60%);
  }
  .a-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
  }
  .a-brand img {
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgb(255 250 244 / 0.12);
    transition: transform 0.6s var(--ease);
  }
  .a-brand:hover img {
    transform: rotate(-10deg) scale(1.05);
  }
  .a-brand span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1;
  }
  .a-brand small {
    display: block;
    margin-top: 0.25rem;
    font: 700 var(--t-xs) var(--font-body);
    font-style: normal;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--blush);
  }
  .a-nav {
    display: grid;
    gap: 0.3rem;
  }
  .a-nav a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0.95rem;
    border-radius: 14px;
    font-weight: 600;
    text-decoration: none;
    color: rgb(255 250 244 / 0.72);
    transition: background 0.25s, color 0.25s, transform 0.35s var(--ease);
  }
  .a-nav a:hover {
    background: rgb(255 250 244 / 0.07);
    color: var(--cream);
    transform: translateX(3px);
  }
  .a-nav a[aria-current='page'] {
    background: var(--cream);
    color: var(--cocoa);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.6);
  }
  .a-nav a span {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 450;
    letter-spacing: 0.005em;
  }
  .a-nav a[aria-current='page'] span {
    font-style: italic;
  }
  .a-nav a[aria-current='page'] svg {
    color: var(--clay);
  }
  .a-side-foot {
    margin-top: auto;
    display: grid;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 250 244 / 0.1);
  }
  .a-side-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.95rem;
    border-radius: var(--r-sm);
    background: none;
    border: 0;
    color: rgb(255 250 244 / 0.72);
    font: 600 var(--t-sm) var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .a-side-link svg {
    flex: none;
  }
  .a-side-link:hover {
    background: rgb(255 250 244 / 0.07);
    color: var(--cream);
  }

  .a-body {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.75rem) 4rem;
  }
  .a-body:focus {
    outline: none;
  }
  .a-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
    max-width: 1180px;
  }
  .a-greet {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .a-greet::before {
    content: '';
    width: 26px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }
  .a-head h1 {
    margin: var(--s-1) 0 0;
    font-size: var(--t-2xl);
    font-weight: 420;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }
  .a-head h1 em {
    font-style: italic;
    color: var(--clay);
  }
  .a-sub,
  .a-sub-m {
    margin: var(--s-1) 0 0;
    color: var(--muted);
    font-size: var(--t-sm);
    max-width: 52ch;
  }
  .a-sub-m {
    display: none;
  }
  .a-sub-m::first-letter {
    text-transform: uppercase;
  }
  .a-head-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .a-main {
    max-width: 1180px;
  }
  .a-main h2 {
    font-size: var(--t-lg);
    margin: 0 0 1rem;
  }

  /* Aviso de modo de prueba: una sola línea, sin rojo de error */
  .a-demo {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0 0 var(--s-4);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--cream-2);
    color: var(--cocoa-2);
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1.4;
  }
  .a-demo i {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c99a2e;
  }

  /* Entrada escalonada */
  @media (prefers-reduced-motion: no-preference) {
    .a-head,
    .a-main > * {
      animation: a-rise 0.6s var(--ease) backwards;
    }
    .a-main > *:nth-child(1) { animation-delay: 0.05s; }
    .a-main > *:nth-child(2) { animation-delay: 0.1s; }
    .a-main > *:nth-child(3) { animation-delay: 0.15s; }
    .a-main > *:nth-child(4) { animation-delay: 0.2s; }
    .a-main > *:nth-child(n + 5) { animation-delay: 0.25s; }
  }
  @keyframes a-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Resaltado del elemento recién guardado */
  .just-saved {
    outline: 2.5px solid var(--sage) !important;
    outline-offset: 4px;
    transition: outline-color 0.6s;
  }

  /* Escritorio estrecho: un poco más de ancho para el calendario */
  @media (min-width: 861px) and (max-width: 1200px) {
    body.admin {
      --side-w: 208px;
    }
  }

  /* Barra inferior móvil: anclada abajo, no flotante */
  .a-tabs {
    display: none;
  }
  @media (max-width: 860px) {
    html:has(body.admin) {
      /* Lo enfocado o desplazado con scrollIntoView no queda debajo de la barra inferior. */
      scroll-padding-bottom: calc(64px + 2.5rem + env(safe-area-inset-bottom));
      scroll-padding-top: 1rem;
    }
    /* Con la barra fija de guardar encima de la de pestañas, lo enfocado no queda tapado. */
    html:has(form.dirty[data-sticky-save]) {
      scroll-padding-bottom: calc(64px + 110px + env(safe-area-inset-bottom));
    }
    .a-shell {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .a-side {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      padding: 10px 16px;
      gap: 1rem;
    }
    .a-brand img {
      width: 36px;
      height: 36px;
    }
    .a-brand span {
      font-size: 1.2rem;
    }
    .a-side .a-nav {
      display: none;
    }
    .a-side-foot {
      margin: 0 0 0 auto;
      padding: 0;
      border: 0;
      display: flex;
    }
    /* Solo oculto a la vista: los lectores de pantalla lo siguen leyendo. */
    .a-side-link span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .a-side-link {
      width: auto;
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
      padding: 12px;
    }
    .a-side-foot form {
      display: flex;
    }
    .a-body {
      padding: var(--s-4) var(--s-4) calc(var(--tab-h) + var(--s-6) + env(safe-area-inset-bottom));
    }
    body.admin:has(.fab) .a-body {
      padding-bottom: calc(var(--tab-h) + var(--s-6) + 64px + env(safe-area-inset-bottom));
    }
    .a-head {
      margin-bottom: var(--s-4);
    }
    .a-head h1 {
      font-size: 1.75rem;
    }
    .a-sub {
      display: none;
    }
    .a-sub-m {
      display: block;
    }
    .a-tabs {
      position: fixed;
      z-index: 40;
      left: 0;
      right: 0;
      bottom: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      height: calc(var(--tab-h) + env(safe-area-inset-bottom));
      padding: 6px 8px env(safe-area-inset-bottom);
      border-radius: 20px 20px 0 0;
      background: var(--cocoa);
      box-shadow: 0 -8px 24px -12px rgb(42 28 22 / 0.35);
    }
    .a-tabs a {
      position: relative;
      display: grid;
      justify-items: center;
      align-content: center;
      gap: 2px;
      min-height: 52px;
      border-radius: var(--r-md);
      color: rgb(255 250 244 / 0.7);
      font-size: var(--t-xs);
      font-weight: 700;
      text-decoration: none;
      transition: background 0.25s, color 0.25s;
    }
    .a-tabs a[aria-current='page'] {
      background: rgb(255 250 244 / 0.1);
      color: var(--cream);
    }
    .a-tabs a[aria-current='page']::before {
      content: '';
      position: absolute;
      top: 4px;
      width: 20px;
      height: 3px;
      border-radius: 3px;
      background: var(--blush);
    }
  }

  /* ───────── Componentes ───────── */
  .panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.1rem, 3vw, 1.75rem);
    margin-bottom: 1.25rem;
    box-shadow: 0 1px 2px rgb(42 28 22 / 0.04), 0 18px 40px -30px rgb(42 28 22 / 0.35);
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .panel-head h2 {
    margin: 0 !important;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  .grid-2 .full {
    grid-column: 1 / -1;
  }
  .row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .muted {
    color: var(--muted);
    font-size: var(--t-sm);
  }

  /* Botones del panel */
  body.admin .btn {
    white-space: nowrap;
    position: relative;
    min-height: 46px;
    padding: 0.7rem 1.25rem;
    font-size: var(--t-md);
  }
  body.admin .btn-clay {
    --b-bg: var(--clay-ink);
  }
  body.admin .btn-clay:hover {
    --b-bg: var(--clay-deep);
  }
  body.admin .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -12px rgb(42 28 22 / 0.5);
  }
  body.admin .btn:active {
    transform: scale(0.97);
    transition-duration: 0.1s;
  }
  body.admin .btn-sm {
    min-height: 44px;
    padding: 0.45rem 0.95rem;
    font-size: var(--t-sm);
    gap: 0.4rem;
  }
  body.admin .btn-sm svg {
    width: 16px;
    height: 16px;
  }
  .btn-soft {
    --b-bg: var(--cream-2);
    --b-fg: var(--cocoa);
    border-color: transparent;
  }
  .btn-soft:hover {
    --b-bg: var(--sand);
  }
  .btn-wa {
    --b-bg: #e3f1e4;
    --b-fg: #1e6b34;
    border-color: transparent;
  }
  .btn-wa:hover {
    --b-bg: #cfe8d2;
  }
  .btn-danger {
    --b-bg: transparent;
    --b-fg: #9c2a1a;
    border-color: #ebc3bb;
  }
  .btn-danger:hover {
    --b-bg: #f9e3de;
  }
  .btn-danger-solid {
    --b-bg: #a83a26;
    --b-fg: #fff;
  }
  .btn-danger-solid:hover {
    --b-bg: #8b2c1b;
  }
  .btn-icon {
    min-height: 44px !important;
    width: 44px;
    padding: 0 !important;
  }
  .btn.loading {
    color: transparent !important;
    pointer-events: none;
  }
  .btn.loading::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--b-fg);
    border-right-color: transparent;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Etiquetas de estado */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-family: var(--font-body);
    white-space: nowrap;
    background: var(--sage-soft);
    color: #3f4a2f;
  }
  .tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .tag.plain::before {
    display: none;
  }
  .tag.cancelada {
    background: #f6dcd6;
    color: #8b2c1b;
  }
  .tag.completada {
    background: #ebe4da;
    color: #5c4a40;
  }
  .tag.pendiente {
    background: #f6e7c1;
    color: #6b4f10;
  }

  /* Interruptores (en lugar de checkbox) */
  .check {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }
  .check input[type='checkbox'] {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    position: relative;
    width: 44px;
    height: 26px;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #8f7a6c;
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }
  .check input[type='checkbox']::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 6px rgb(42 28 22 / 0.25);
    transition: transform 0.35s var(--ease);
  }
  .check input[type='checkbox']:checked {
    background: var(--sage);
  }
  .check input[type='checkbox']:checked::after {
    transform: translateX(18px);
  }

  /* Acordeones */
  details.panel > summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  details.panel > summary::-webkit-details-marker {
    display: none;
  }
  details.panel > summary::after {
    content: '';
    margin-left: auto;
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translateY(-3px);
    transition: transform 0.35s var(--ease);
  }
  details.panel[open] > summary::after {
    transform: rotate(-135deg) translateY(-3px);
  }
  details.panel[open] > summary {
    margin-bottom: 1.1rem;
  }
  details.panel[open] > :not(summary) {
    animation: a-rise 0.45s var(--ease) backwards;
  }

  /* Avisos flotantes */
  .toasts {
    position: fixed;
    z-index: 60;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    gap: 0.6rem;
    width: min(400px, calc(100% - 2rem));
  }
  @media (max-width: 860px) {
    .toasts {
      right: 1rem;
      bottom: calc(var(--tab-h) + var(--s-4) + env(safe-area-inset-bottom));
    }
    body.admin:has(.fab) .toasts {
      bottom: calc(var(--tab-h) + var(--s-4) + 64px + env(safe-area-inset-bottom));
    }
  }
  .toast {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.6rem 0.6rem 0.9rem;
    border-radius: var(--r-md);
    background: var(--cocoa);
    color: var(--cream);
    font-weight: 600;
    font-size: var(--t-sm);
    line-height: 1.4;
    box-shadow: 0 20px 44px -18px rgb(42 28 22 / 0.65);
    animation: toast-in 0.5s var(--ease) both;
  }
  .toast.err {
    background: #5e1d12;
  }
  .toast.hide {
    animation: toast-out 0.35s var(--ease) both;
  }
  .t-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sage);
    font-weight: 800;
  }
  .toast.err .t-ico {
    background: #c4533c;
  }
  .toast.warn .t-ico {
    background: #c99a2e;
    color: var(--cocoa);
  }
  .t-txt {
    flex: 1;
    min-width: 0;
  }
  .t-x {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    opacity: 0.75;
    cursor: pointer;
  }
  .t-x:hover {
    opacity: 1;
    background: rgb(255 250 244 / 0.1);
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  @keyframes toast-out {
    to {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }

  /* Diálogos */
  body.admin dialog {
    border: 0;
    padding: 0;
    border-radius: var(--r-lg);
    background: var(--white);
    color: var(--cocoa);
    box-shadow: var(--shadow-lg);
    width: min(520px, calc(100% - 1.5rem));
    max-height: calc(100dvh - 2rem);
  }
  body.admin dialog[open] {
    animation: dlg-in 0.4s var(--ease) both;
  }
  body.admin dialog::backdrop {
    background: rgb(42 28 22 / 0.45);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: fade 0.3s both;
  }
  @keyframes dlg-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .a-confirm form {
    padding: 1.75rem;
    text-align: center;
  }
  .c-ico {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 0.75rem;
    border-radius: 50%;
    background: #f9e3de;
    color: #a83a26;
  }
  .c-msg {
    margin: 0 0 1.5rem;
    font-weight: 600;
    font-size: var(--t-md);
  }
  .c-acts {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  @media (prefers-reduced-motion: reduce) {
    body.admin *,
    body.admin *::before,
    body.admin *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // sessionStorage puede fallar (modo privado o bloqueado): nunca rompe la página.
  const store = {
    get: (k: string) => {
      try {
        return sessionStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set: (k: string, v: string) => {
      try {
        sessionStorage.setItem(k, v);
      } catch {
        /* sin almacenamiento: se sigue sin borrador */
      }
    },
    del: (k: string) => {
      try {
        sessionStorage.removeItem(k);
      } catch {
        /* nada */
      }
    },
    keys: () => {
      try {
        return Object.keys(sessionStorage);
      } catch {
        return [] as string[];
      }
    },
  };
  /** Borra todo lo que el panel guardó en esta pestaña (borradores con datos de clientas, posición). */
  const forget = () => store.keys().forEach((k) => k.startsWith('bp-') && store.del(k));

  // Seguridad: cierra la sesión tras 30 min sin actividad (por si el equipo queda desatendido).
  {
    const IDLE_MS = 30 * 60 * 1000;
    let last = Date.now();
    const bump = () => (last = Date.now());
    for (const ev of ['pointerdown', 'keydown', 'scroll', 'touchstart']) addEventListener(ev, bump, { passive: true });
    const logout = () => {
      forget();
      const f = Object.assign(document.createElement('form'), { method: 'post', action: '/api/admin/logout?motivo=inactividad' });
      document.body.append(f);
      f.submit();
    };
    const check = () => {
      if (Date.now() - last >= IDLE_MS) logout();
    };
    setInterval(check, 30_000);
    document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && check());
  }

  const PATH = location.pathname.replace(/\/$/, '') || '/admin';
  const tplOk = document.querySelector<HTMLTemplateElement>('template[data-toast-tpl][data-kind="ok"]');
  const tplWarn = document.querySelector<HTMLTemplateElement>('template[data-toast-tpl][data-kind="warn"]');
  const tplErr = document.querySelector<HTMLTemplateElement>('template[data-toast-tpl][data-kind="err"]');
  const saved = tplOk || tplWarn;
  const MAX_AGE = 2 * 60 * 1000;

  // Avisos: se insertan tras cargar (así se anuncian). El de éxito se cierra solo (pausa al pasar el
  // mouse o enfocar); el de error y el de "haz esto" se quedan hasta que se cierren con la ✕.
  const box = document.querySelector<HTMLElement>('.toasts');
  const hide = (t: HTMLElement) => {
    t.classList.add('hide');
    t.addEventListener('animationend', () => t.remove(), { once: true });
  };
  const wire = (t: HTMLElement) => {
    t.querySelector('[data-toast-close]')?.addEventListener('click', () => hide(t));
    if (!t.classList.contains('ok')) return;
    let timer = 0;
    // Más tiempo para leer los mensajes largos.
    const ms = 4500 + (t.textContent?.length ?? 0) * 45;
    const stop = () => clearTimeout(timer);
    const start = () => {
      stop();
      timer = window.setTimeout(() => hide(t), ms);
    };
    t.addEventListener('mouseenter', stop);
    t.addEventListener('focusin', stop);
    t.addEventListener('mouseleave', start);
    t.addEventListener('focusout', start);
    start();
  };
  const showToasts = (skipErr: boolean) => {
    if (!box) return;
    const list = [skipErr ? null : tplErr, tplWarn, tplOk].filter(Boolean) as HTMLTemplateElement[];
    if (list.some((tp) => tp !== tplOk)) box.setAttribute('aria-live', 'assertive');
    setTimeout(() => {
      for (const tp of list) {
        const t = tp.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
        if (!t) continue;
        box.append(t);
        wire(t);
      }
    }, 150);
  };
  if (tplOk || tplErr || tplWarn) {
    const u = new URL(location.href);
    ['ok', 'error', 'warn'].forEach((k) => u.searchParams.delete(k));
    history.replaceState(null, '', u.pathname + u.search + u.hash);
  }

  // Borrador y posición: al enviar se recuerda SOLO el formulario enviado (con la hora) y dónde
  // estaba Betsy. En la carga siguiente: si volvió con error en menos de 2 min se rellena ese
  // formulario; en cualquier otro caso los borradores se borran (nada de borradores huérfanos).
  type Last = { path: string; t: number; key: string | null; y: number; keep: string | null; day: string | null };
  const draftKey = (form: HTMLFormElement) => `bp-draft:${PATH}:${form.dataset.draft}`;
  const remember = (form: HTMLFormElement) => {
    forget();
    let key: string | null = null;
    if (form.dataset.draft) {
      const data: [string, string][] = [];
      new FormData(form).forEach((v, k) => {
        if (typeof v === 'string') data.push([k, v]);
      });
      key = draftKey(form);
      store.set(key, JSON.stringify(data));
    }
    const keep = form.closest<HTMLElement>('[data-keep]');
    const chip = document.querySelector<HTMLElement>('.chip[aria-pressed="true"]');
    const last: Last = { path: PATH, t: Date.now(), key, y: scrollY, keep: keep?.id ?? null, day: form.dataset.posDay ?? chip?.dataset.day ?? null };
    store.set('bp-last', JSON.stringify(last));
  };
  const restore = () => {
    let last: Last | null = null;
    try {
      last = JSON.parse(store.get('bp-last') ?? 'null');
    } catch {
      last = null;
    }
    const raw = last?.key ? store.get(last.key) : null;
    forget();
    const fresh = Boolean(last && last.path === PATH && Date.now() - last.t < MAX_AGE && (saved || tplErr));
    let handledErr = false;
    if (fresh && tplErr && last?.key && raw) {
      const form = [...document.querySelectorAll<HTMLFormElement>('form[data-draft]')].find((f) => draftKey(f) === last!.key);
      let data: [string, string][] = [];
      try {
        data = JSON.parse(raw);
      } catch {
        data = [];
      }
      if (form && data.length) {
        const vals = new Map<string, string>();
        data.forEach(([k, v]) => vals.set(k, v));
        for (const el of Array.from(form.elements) as HTMLInputElement[]) {
          if (!el.name || el.type === 'hidden' || el.type === 'file' || el.type === 'submit') continue;
          if (el.type === 'checkbox' || el.type === 'radio') el.checked = vals.has(el.name) && (el.type === 'checkbox' || vals.get(el.name) === el.value);
          else if (vals.has(el.name)) el.value = vals.get(el.name)!;
        }
        // Si la página muestra el error dentro del formulario (preventDefault), no se repite en el aviso.
        const ev = new CustomEvent('bp:restored', { cancelable: true, detail: { message: tplErr.dataset.msg ?? '' } });
        handledErr = !form.dispatchEvent(ev);
      }
    }
    showToasts(handledErr);
    if (!fresh || !last) return;
    if (last.day) document.querySelector<HTMLElement>(`.chip[data-day="${last.day}"]`)?.click();
    const el = last.keep ? document.getElementById(last.keep) : null;
    if (el) {
      if (el instanceof HTMLDetailsElement) el.open = true;
      el.scrollIntoView({ block: 'center', behavior: 'instant' });
      if (saved) {
        el.classList.add('just-saved');
        setTimeout(() => el.classList.remove('just-saved'), 1800);
      }
    } else if (!last.day) window.scrollTo({ top: last.y, behavior: 'instant' });
  };
  // Después de que cada página haya conectado sus propios scripts.
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', restore);
  else setTimeout(restore, 0);

  // Confirmación con diálogo propio + estado "cargando" en los botones.
  const dlg = document.getElementById('a-confirm') as HTMLDialogElement | null;
  const msg = dlg?.querySelector('[data-confirm-msg]');
  const okBtn = dlg?.querySelector<HTMLButtonElement>('[data-confirm-ok]');
  document.addEventListener(
    'submit',
    (e) => {
      const form = e.target as HTMLFormElement;
      if (form.method === 'dialog') return;
      const btn = ((e as SubmitEvent).submitter ?? form.querySelector('button:not([type=button])')) as HTMLButtonElement | null;
      if (form.dataset.confirm && form.dataset.confirmed !== '1' && dlg && msg) {
        e.preventDefault();
        msg.textContent = form.dataset.confirm;
        if (okBtn) okBtn.textContent = form.dataset.confirmYes ?? 'Sí, continuar';
        dlg.returnValue = '';
        dlg.showModal();
        dlg.addEventListener(
          'close',
          () => {
            if (dlg.returnValue === 'ok') {
              form.dataset.confirmed = '1';
              btn ? form.requestSubmit(btn) : form.requestSubmit();
            }
          },
          { once: true },
        );
        return;
      }
      // Cerrar sesión: no dejar datos de clientas en la pestaña (de inmediato, antes de salir).
      // getAttribute: los formularios tienen un campo name="action" que tapa form.action.
      const isLogout = (form.getAttribute('action') ?? '').includes('/api/admin/logout');
      if (isLogout) forget();
      setTimeout(() => {
        if (e.defaultPrevented) return;
        if (!isLogout) remember(form);
        btn?.classList.add('loading');
      }, 0);
    },
    true,
  );
  // Enlaces que tardan (semana anterior/siguiente, conectar Google): señal de carga.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.btn[href]');
    if (!a || a.target || a.getAttribute('href')!.startsWith('#') || e.metaKey || e.ctrlKey || e.shiftKey) return;
    a.classList.add('loading');
  });
  // Al volver con el botón atrás: quitar estados de carga y confirmaciones ya usadas.
  window.addEventListener('pageshow', () => {
    document.querySelectorAll('.btn.loading').forEach((b) => b.classList.remove('loading'));
    document.querySelectorAll<HTMLFormElement>('form[data-confirmed]').forEach((f) => delete f.dataset.confirmed);
  });
</script>
