---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { demoMode } from '../lib/db';
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const path = Astro.url.pathname.replace(/\/$/, '') || '/admin';
const nav = [
  { href: '/admin', label: 'Agenda', icon: 'calendar' },
  { href: '/admin/servicios', label: 'Servicios', icon: 'scissors' },
  { href: '/admin/horario', label: 'Horario', icon: 'clock' },
  { href: '/admin/ajustes', label: 'Ajustes', icon: 'settings' },
] as const;
const hour = Number(new Intl.DateTimeFormat('es-CO', { hour: 'numeric', hour12: false, timeZone: 'America/Bogota' }).format(new Date()));
const leads: Record<string, string> = { '/admin': 'Tu', '/admin/servicios': 'Tus', '/admin/horario': 'Tu', '/admin/ajustes': 'Tus' };
const lead = leads[path];
const greet = hour < 12 ? 'Buenos días' : hour < 19 ? 'Buenas tardes' : 'Buenas noches';
---

<Base title={`${title} · Panel Betsy Peinados`} description="Panel de administración" noindex bodyClass="admin">
  <div class="a-shell">
    <aside class="a-side" aria-label="Menú del panel">
      <a href="/admin" class="a-brand">
        <img src="/logo.webp" alt="" width="44" height="44" />
        <span>Betsy <small>panel</small></span>
      </a>
      <nav class="a-nav">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
              <Icon name={n.icon} size={20} />
              <span>{n.label}</span>
            </a>
          ))
        }
      </nav>
      <div class="a-side-foot">
        <a href="/" target="_blank" rel="noopener" class="a-side-link"><Icon name="external" size={18} /> <span>Ver sitio</span></a>
        <form method="post" action="/api/admin/logout">
          <button type="submit" class="a-side-link"><Icon name="logout" size={18} /> <span>Salir</span></button>
        </form>
      </div>
    </aside>

    <div class="a-body">
      <header class="a-head">
        <div class="a-head-text">
          <p class="a-greet">{greet}, Betsy</p>
          <h1>{lead && <span class="a-lead">{lead} </span>}<em>{lead ? title.toLowerCase() : title}</em></h1>
          {subtitle && <p class="a-sub">{subtitle}</p>}
        </div>
        <div class="a-head-actions"><slot name="actions" /></div>
      </header>
      <main id="contenido" class="a-main">
        {demoMode && <p class="notice error">Modo demo: Supabase aún no está conectado, los cambios no se guardan de forma permanente.</p>}
        <slot />
      </main>
    </div>
  </div>

  <nav class="a-tabs" aria-label="Panel">
    {
      nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
          <Icon name={n.icon} size={22} />
          <span>{n.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="toasts" aria-live="polite">
    {
      ok && (
        <div class="toast ok" role="status" data-toast>
          <span class="t-ico"><Icon name="check" size={18} /></span>
          <span>{ok}</span>
          <button type="button" class="t-x" aria-label="Cerrar" data-toast-close><Icon name="close" size={16} /></button>
        </div>
      )
    }
    {
      error && (
        <div class="toast err" role="alert" data-toast>
          <span class="t-ico">!</span>
          <span>{error}</span>
          <button type="button" class="t-x" aria-label="Cerrar" data-toast-close><Icon name="close" size={16} /></button>
        </div>
      )
    }
  </div>

  <dialog class="a-confirm" id="a-confirm">
    <form method="dialog">
      <p class="c-ico"><Icon name="ban" size={26} /></p>
      <p class="c-msg" data-confirm-msg></p>
      <div class="c-acts">
        <button value="cancel" class="btn btn-ghost btn-sm">Volver</button>
        <button value="ok" class="btn btn-danger-solid btn-sm" data-confirm-ok>Sí, continuar</button>
      </div>
    </form>
  </dialog>
</Base>

<style is:global>
  body.admin {
    --side-w: 248px;
    --a-bg: #f3ebe1;
    background: var(--a-bg);
    font-size: 1rem;
    /* Cifras alineadas (Playfair usa números antiguos por defecto) */
    font-variant-numeric: lining-nums;
  }

  /* ───────── Estructura ───────── */
  .a-shell {
    display: grid;
    grid-template-columns: var(--side-w) 1fr;
    min-height: 100dvh;
  }
  .a-side {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1.5rem 1rem;
    background: var(--cocoa);
    color: var(--cream);
    background-image: radial-gradient(120% 60% at 0% 0%, rgb(184 96 63 / 0.35), transparent 60%),
      radial-gradient(90% 50% at 100% 100%, rgb(125 138 104 / 0.25), transparent 60%);
  }
  .a-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.25rem 0.5rem;
    text-decoration: none;
  }
  .a-brand img {
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgb(255 250 244 / 0.12);
    transition: transform 0.6s var(--ease);
  }
  .a-brand:hover img {
    transform: rotate(-10deg) scale(1.05);
  }
  .a-brand span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1;
  }
  .a-brand small {
    display: block;
    margin-top: 0.25rem;
    font: 700 0.62rem var(--font-body);
    font-style: normal;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--blush);
  }
  .a-nav {
    display: grid;
    gap: 0.3rem;
  }
  .a-nav a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 0.95rem;
    border-radius: 14px;
    font-weight: 600;
    text-decoration: none;
    color: rgb(255 250 244 / 0.72);
    transition: background 0.25s, color 0.25s, transform 0.35s var(--ease);
  }
  .a-nav a:hover {
    background: rgb(255 250 244 / 0.07);
    color: var(--cream);
    transform: translateX(3px);
  }
  .a-nav a[aria-current='page'] {
    background: var(--cream);
    color: var(--cocoa);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.6);
  }
  .a-nav a span {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 450;
    letter-spacing: 0.005em;
  }
  .a-nav a[aria-current='page'] span {
    font-style: italic;
  }
  .a-nav a[aria-current='page'] svg {
    color: var(--clay);
  }
  .a-side-foot {
    margin-top: auto;
    display: grid;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 250 244 / 0.1);
  }
  .a-side-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0.65rem 0.95rem;
    border-radius: 12px;
    background: none;
    border: 0;
    color: rgb(255 250 244 / 0.65);
    font: 600 0.9rem var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .a-side-link svg {
    flex: none;
  }
  .a-side-link:hover {
    background: rgb(255 250 244 / 0.07);
    color: var(--cream);
  }

  .a-body {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.75rem) 4rem;
  }
  .a-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    max-width: 1180px;
  }
  .a-greet {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .a-greet::before {
    content: '';
    width: 26px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }
  .a-head h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(2.3rem, 4.6vw, 3.4rem);
    font-weight: 420;
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .a-head h1 em {
    font-style: italic;
    color: var(--clay);
  }
  .a-sub {
    margin: 0.4rem 0 0;
    color: var(--muted);
    max-width: 60ch;
  }
  .a-head-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .a-main {
    max-width: 1180px;
  }
  .a-main h2 {
    font-size: 1.35rem;
    margin: 0 0 1rem;
  }
  .a-main .notice {
    margin-bottom: 1rem;
  }

  /* Entrada escalonada */
  @media (prefers-reduced-motion: no-preference) {
    .a-head,
    .a-main > * {
      animation: a-rise 0.6s var(--ease) backwards;
    }
    .a-main > *:nth-child(1) { animation-delay: 0.05s; }
    .a-main > *:nth-child(2) { animation-delay: 0.1s; }
    .a-main > *:nth-child(3) { animation-delay: 0.15s; }
    .a-main > *:nth-child(4) { animation-delay: 0.2s; }
    .a-main > *:nth-child(n + 5) { animation-delay: 0.25s; }
  }
  @keyframes a-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Barra inferior móvil */
  .a-tabs {
    display: none;
  }
  @media (max-width: 860px) {
    .a-shell {
      grid-template-columns: 1fr;
    }
    .a-side {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      padding: 0.75rem 1rem;
      gap: 1rem;
    }
    .a-side .a-nav {
      display: none;
    }
    .a-side-foot {
      margin: 0 0 0 auto;
      padding: 0;
      border: 0;
      display: flex;
    }
    .a-side-link span {
      display: none;
    }
    .a-side-link {
      width: auto;
      padding: 0.6rem;
    }
    .a-side-foot form {
      display: flex;
    }
    .a-body {
      padding-bottom: 6.5rem;
    }
    .a-tabs {
      position: fixed;
      z-index: 40;
      left: 0.75rem;
      right: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding: 0.4rem;
      border-radius: 22px;
      background: color-mix(in oklab, var(--cocoa) 92%, transparent);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      box-shadow: 0 18px 40px -16px rgb(42 28 22 / 0.6);
    }
    .a-tabs a {
      display: grid;
      justify-items: center;
      gap: 0.2rem;
      padding: 0.55rem 0.25rem;
      border-radius: 16px;
      color: rgb(255 250 244 / 0.62);
      font-size: 0.7rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.25s, color 0.25s;
    }
    .a-tabs a[aria-current='page'] {
      background: var(--cream);
      color: var(--clay);
    }
  }

  /* ───────── Componentes ───────── */
  .panel {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: clamp(1.1rem, 3vw, 1.75rem);
    margin-bottom: 1.25rem;
    box-shadow: 0 1px 2px rgb(42 28 22 / 0.04), 0 18px 40px -30px rgb(42 28 22 / 0.35);
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .panel-head h2 {
    margin: 0 !important;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  .grid-2 .full {
    grid-column: 1 / -1;
  }
  .row {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .muted {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Botones del panel */
  body.admin .btn {
    position: relative;
    min-height: 46px;
    padding: 0.7rem 1.25rem;
    font-size: 0.93rem;
  }
  body.admin .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -12px rgb(42 28 22 / 0.5);
  }
  body.admin .btn:active {
    transform: scale(0.97);
    transition-duration: 0.1s;
  }
  body.admin .btn-sm {
    min-height: 38px;
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    gap: 0.4rem;
  }
  body.admin .btn-sm svg {
    width: 16px;
    height: 16px;
  }
  .btn-soft {
    --b-bg: var(--cream-2);
    --b-fg: var(--cocoa);
    border-color: transparent;
  }
  .btn-soft:hover {
    --b-bg: var(--sand);
  }
  .btn-wa {
    --b-bg: #e3f1e4;
    --b-fg: #1e6b34;
    border-color: transparent;
  }
  .btn-wa:hover {
    --b-bg: #cfe8d2;
  }
  .btn-danger {
    --b-bg: transparent;
    --b-fg: #9c2a1a;
    border-color: #ebc3bb;
  }
  .btn-danger:hover {
    --b-bg: #f9e3de;
  }
  .btn-danger-solid {
    --b-bg: #a83a26;
    --b-fg: #fff;
  }
  .btn-danger-solid:hover {
    --b-bg: #8b2c1b;
  }
  .btn-icon {
    min-height: 40px !important;
    width: 40px;
    padding: 0 !important;
  }
  .btn.loading {
    color: transparent !important;
    pointer-events: none;
  }
  .btn.loading::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--b-fg);
    border-right-color: transparent;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Etiquetas de estado */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    font-family: var(--font-body);
    white-space: nowrap;
    background: var(--sage-soft);
    color: #3f4a2f;
  }
  .tag::first-letter {
    text-transform: uppercase;
  }
  .tag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .tag.plain::before {
    display: none;
  }
  .tag.cancelada {
    background: #f6dcd6;
    color: #8b2c1b;
  }
  .tag.completada {
    background: #ebe4da;
    color: var(--muted);
  }
  .tag.pendiente {
    background: #f6e7c1;
    color: #7a5a12;
  }

  /* Interruptores (en lugar de checkbox) */
  .check {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
  }
  .check input[type='checkbox'] {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    position: relative;
    width: 44px;
    height: 26px;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #d8cbbd;
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }
  .check input[type='checkbox']::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 6px rgb(42 28 22 / 0.25);
    transition: transform 0.35s var(--ease);
  }
  .check input[type='checkbox']:checked {
    background: var(--sage);
  }
  .check input[type='checkbox']:checked::after {
    transform: translateX(18px);
  }

  /* Acordeones */
  details.panel > summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  details.panel > summary::-webkit-details-marker {
    display: none;
  }
  details.panel > summary::after {
    content: '';
    margin-left: auto;
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translateY(-3px);
    transition: transform 0.35s var(--ease);
  }
  details.panel[open] > summary::after {
    transform: rotate(-135deg) translateY(-3px);
  }
  details.panel[open] > summary {
    margin-bottom: 1.1rem;
  }
  details.panel[open] > :not(summary) {
    animation: a-rise 0.45s var(--ease) backwards;
  }

  /* Avisos flotantes */
  .toasts {
    position: fixed;
    z-index: 60;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    gap: 0.6rem;
    width: min(380px, calc(100% - 2rem));
  }
  @media (max-width: 860px) {
    .toasts {
      right: 1rem;
      bottom: calc(6.25rem + env(safe-area-inset-bottom));
    }
  }
  .toast {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0.9rem;
    border-radius: 18px;
    background: var(--cocoa);
    color: var(--cream);
    font-weight: 600;
    font-size: 0.93rem;
    box-shadow: 0 20px 44px -18px rgb(42 28 22 / 0.65);
    animation: toast-in 0.5s var(--ease) both;
  }
  .toast.hide {
    animation: toast-out 0.35s var(--ease) both;
  }
  .t-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sage);
    font-weight: 800;
  }
  .toast.err .t-ico {
    background: #c4533c;
  }
  .t-x {
    margin-left: auto;
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    opacity: 0.6;
    cursor: pointer;
  }
  .t-x:hover {
    opacity: 1;
    background: rgb(255 250 244 / 0.1);
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
  @keyframes toast-out {
    to {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }

  /* Diálogos */
  body.admin dialog {
    border: 0;
    padding: 0;
    border-radius: 26px;
    background: var(--white);
    color: var(--cocoa);
    box-shadow: var(--shadow-lg);
    width: min(520px, calc(100% - 1.5rem));
    max-height: calc(100dvh - 2rem);
  }
  body.admin dialog[open] {
    animation: dlg-in 0.4s var(--ease) both;
  }
  body.admin dialog::backdrop {
    background: rgb(42 28 22 / 0.45);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: fade 0.3s both;
  }
  @keyframes dlg-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .a-confirm form {
    padding: 1.75rem;
    text-align: center;
  }
  .c-ico {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 0.75rem;
    border-radius: 50%;
    background: #f9e3de;
    color: #a83a26;
  }
  .c-msg {
    margin: 0 0 1.5rem;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .c-acts {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
  }
  @media (prefers-reduced-motion: reduce) {
    body.admin *,
    body.admin *::before,
    body.admin *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  // Seguridad: cierra la sesión tras 30 min sin actividad (por si el equipo queda desatendido).
  {
    const IDLE_MS = 30 * 60 * 1000;
    let last = Date.now();
    const bump = () => (last = Date.now());
    for (const ev of ['pointerdown', 'keydown', 'scroll', 'touchstart']) addEventListener(ev, bump, { passive: true });
    const logout = () => {
      const f = Object.assign(document.createElement('form'), { method: 'post', action: '/api/admin/logout?motivo=inactividad' });
      document.body.append(f);
      f.submit();
    };
    const check = () => {
      if (Date.now() - last >= IDLE_MS) logout();
    };
    setInterval(check, 30_000);
    document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && check());
  }

  // Avisos: se cierran solos y limpian ?ok=/?error= de la URL.
  const toasts = document.querySelectorAll<HTMLElement>('[data-toast]');
  const hide = (t: HTMLElement) => {
    t.classList.add('hide');
    t.addEventListener('animationend', () => t.remove(), { once: true });
  };
  toasts.forEach((t) => {
    t.querySelector('[data-toast-close]')?.addEventListener('click', () => hide(t));
    setTimeout(() => hide(t), t.classList.contains('err') ? 7000 : 4200);
  });
  if (toasts.length) {
    const u = new URL(location.href);
    u.searchParams.delete('ok');
    u.searchParams.delete('error');
    history.replaceState(null, '', u.pathname + u.search + u.hash);
  }

  // Confirmación con diálogo propio + estado "cargando" en los botones.
  const dlg = document.getElementById('a-confirm') as HTMLDialogElement | null;
  const msg = dlg?.querySelector('[data-confirm-msg]');
  document.addEventListener(
    'submit',
    (e) => {
      const form = e.target as HTMLFormElement;
      if (form.method === 'dialog') return;
      const btn = ((e as SubmitEvent).submitter ?? form.querySelector('button:not([type=button])')) as HTMLButtonElement | null;
      if (form.dataset.confirm && form.dataset.confirmed !== '1' && dlg && msg) {
        e.preventDefault();
        msg.textContent = form.dataset.confirm;
        dlg.returnValue = '';
        dlg.showModal();
        dlg.addEventListener(
          'close',
          () => {
            if (dlg.returnValue === 'ok') {
              form.dataset.confirmed = '1';
              btn ? form.requestSubmit(btn) : form.requestSubmit();
            }
          },
          { once: true },
        );
        return;
      }
      if (btn) setTimeout(() => btn.classList.add('loading'), 0);
    },
    true,
  );
  // Al volver con el botón atrás, quitar estados de carga.
  window.addEventListener('pageshow', () => document.querySelectorAll('.btn.loading').forEach((b) => b.classList.remove('loading')));
</script>
