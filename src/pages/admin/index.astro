<script>
  // Coloca citas, franjas de horario y la línea de "ahora" según sus minutos.
  const week = document.querySelector<HTMLElement>('[data-week]');
  if (week) {
    const startMin = Number(week.dataset.start);
    week.querySelectorAll<HTMLElement>('[data-s]').forEach((el) => {
      el.style.setProperty('--s', el.dataset.s!);
      el.style.setProperty('--d', el.dataset.d!);
    });
    const axis = week.querySelectorAll('.w-axis span').length;
    week.style.setProperty('--hours', String(axis));

    const nowEl = week.querySelector<HTMLElement>('[data-now]');
    const body = week.querySelector<HTMLElement>('.w-body');
    const placeNow = () => {
      const parts = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Bogota' }).format(new Date());
      const [h, m] = parts.split(':').map(Number);
      const off = h * 60 + m - startMin;
      if (!nowEl) return off;
      nowEl.hidden = off < 0 || off > axis * 60;
      nowEl.style.setProperty('--s', String(off));
      return off;
    };
    const off = placeNow();
    setInterval(placeNow, 60_000);
    // Desplaza para mostrar la hora actual (o la primera cita).
    const first = week.querySelector<HTMLElement>('.ev');
    const target = nowEl && !nowEl.hidden ? off - 60 : first ? Number(first.dataset.s) - 30 : 0;
    if (body && target > 0) body.scrollTop = target * 1.15;

    // Clic en un espacio vacío: nueva cita en ese día y hora.
    week.querySelectorAll<HTMLElement>('.w-col:not(.closed)').forEach((col) =>
      col.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.ev')) return;
        const y = e.clientY - col.getBoundingClientRect().top;
        const mins = Math.round((y / 1.15 + startMin) / 30) * 30;
        const t = `${String(Math.floor(mins / 60)).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
        openNew(col.dataset.col!, t);
      }),
    );
  }

  // Diálogos de detalle.
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement | null)?.showModal()),
  );
  // Cerrar diálogos al tocar fuera.
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((d) =>
    d.addEventListener('click', (e) => {
      if (e.target === d) d.close();
    }),
  );

  // Nueva cita.
  const dlgNew = document.getElementById('new-appt') as HTMLDialogElement | null;
  function openNew(date?: string, time?: string) {
    if (!dlgNew) return;
    const dateEl = dlgNew.querySelector<HTMLInputElement>('#m-date');
    const timeEl = dlgNew.querySelector<HTMLInputElement>('#m-time');
    if (date && dateEl && date >= dateEl.min) dateEl.value = date;
    if (time && timeEl) timeEl.value = time;
    dlgNew.showModal();
    dlgNew.querySelector<HTMLInputElement>('#m-name')?.focus();
  }
  document.querySelectorAll<HTMLElement>('[data-open-new]').forEach((b) => b.addEventListener('click', () => openNew(b.dataset.date)));
  dlgNew?.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlgNew.close()));

  // Tira de días (móvil).
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-selected', String(x === c)));
      document.querySelectorAll<HTMLElement>('[data-daylist]').forEach((s) => (s.hidden = s.dataset.daylist !== c.dataset.day));
    }),
  );
</script>
