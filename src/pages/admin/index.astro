---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { getAppointment, getAppointments, getBlockedDates, getGoogleConnection, getHours, getServices, updateAppointment } from '../../lib/db';
import { book, BookingError, bookingSchema } from '../../lib/booking';
import { cancelCalendarEvent } from '../../lib/google';
import { addDays, formatCOP, fromLocal, isDate, localDate, localTime, minutesOf, prettyDate, prettyTime, weekdayOf } from '../../lib/time';
import { isUuid, str } from '../../lib/admin';
import type { Appointment, AppointmentStatus } from '../../lib/types';

/** Lunes de la semana que contiene la fecha. */
const mondayOf = (d: string) => addDays(d, -((weekdayOf(d) + 6) % 7));
const firstName = (n: string) => n.split(' ')[0];

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  const desde = str(fd, 'desde', 10);
  const go = (kind: 'ok' | 'error', msg: string, week = desde) =>
    new Response(null, {
      status: 303,
      headers: { Location: `/admin?${isDate(week) ? `desde=${week}&` : ''}${kind}=${encodeURIComponent(msg)}` },
    });
  const OOPS = 'Algo salió mal. Recarga la página e intenta de nuevo.';

  if (action === 'status') {
    const id = str(fd, 'id', 40);
    const status = str(fd, 'status', 20) as AppointmentStatus;
    if (!isUuid(id) || !['confirmada', 'cancelada', 'completada'].includes(status)) return go('error', OOPS);
    const appt = await getAppointment(id);
    if (!appt) return go('error', 'No encontramos esa cita. Recarga la página.');
    const prev = appt.status;
    await updateAppointment(id, { status });
    if (status === 'cancelada' && appt.google_event_id) {
      try {
        await cancelCalendarEvent(appt.google_event_id, Boolean(appt.customer_email));
        await updateAppointment(id, { google_event_id: null });
      } catch (e) {
        console.error(e);
        return go('error', 'Cita cancelada, pero no se pudo borrar de tu Google Calendar. Bórrala a mano allá.');
      }
    }
    const who = firstName(appt.customer_name);
    return go(
      'ok',
      status === 'cancelada'
        ? `Cita de ${who} cancelada. El horario quedó libre.`
        : status === 'completada'
          ? `¡Listo! Cita de ${who} marcada como realizada.`
          : prev === 'completada'
            ? `La cita de ${who} ya no está marcada como realizada.`
            : `Cita de ${who} confirmada`,
    );
  }

  if (action === 'create') {
    const parsed = bookingSchema.safeParse({
      service_id: str(fd, 'service_id', 40),
      date: str(fd, 'date', 10),
      time: str(fd, 'time', 5),
      name: str(fd, 'name', 80),
      phone: str(fd, 'phone', 20),
      email: str(fd, 'email', 120),
      notes: str(fd, 'notes', 500),
    });
    if (!parsed.success) {
      // Los mensajes del esquema le hablan a la clienta de la web; aquí se le habla a Betsy.
      const field = String(parsed.error.issues[0]?.path[0] ?? '');
      const msgs: Record<string, string> = {
        name: 'Escribe el nombre de la clienta',
        phone: 'Revisa el WhatsApp de la clienta. Ej.: 300 123 4567',
        email: 'Ese correo no parece válido. Si no lo tienes, déjalo vacío.',
        date: 'Elige la fecha y la hora de la cita',
        time: 'Elige la fecha y la hora de la cita',
        service_id: 'Elige un servicio',
      };
      return go('error', msgs[field] ?? 'Revisa los datos de la cita.');
    }
    try {
      const appt = await book(parsed.data, 'admin');
      const who = firstName(parsed.data.name);
      const week = mondayOf(parsed.data.date);
      // El aviso solo menciona Google si de verdad quedó anotada allá.
      if (appt.google_event_id) return go('ok', `Cita de ${who} guardada y anotada en tu Google Calendar`, week);
      if (await getGoogleConnection()) return go('ok', `Cita de ${who} guardada, pero no se pudo anotar en tu Google Calendar. Agrégala a mano allá.`, week);
      return go('ok', `Cita de ${who} guardada`, week);
    } catch (e) {
      if (e instanceof BookingError) return go('error', e.status === 409 ? 'Ya tienes una cita a esa hora. Elige otra hora.' : e.message);
      return go('error', 'No se pudo guardar la cita. Intenta de nuevo.');
    }
  }
  return go('error', OOPS);
}

// ───────── Datos de la semana ─────────
const now = new Date();
const today = localDate(now);
const tomorrow = addDays(today, 1);
const qDesde = Astro.url.searchParams.get('desde');
const start = mondayOf(isDate(qDesde) ? qDesde : today);
const end = addDays(start, 7);
const weekDays = Array.from({ length: 7 }, (_, i) => addDays(start, i));
const thisWeek = weekDays.includes(today);

const [appts, services, hours, blocked, upcoming, todayAll, google] = await Promise.all([
  getAppointments({ from: fromLocal(start, '00:00'), to: fromLocal(end, '00:00') }),
  getServices(false),
  getHours(),
  getBlockedDates(start < today ? start : today),
  getAppointments({ from: now, to: new Date(now.getTime() + 90 * 864e5), activeOnly: true }),
  getAppointments({ from: fromLocal(today, '00:00'), to: fromLocal(tomorrow, '00:00') }),
  getGoogleConnection(),
]);

const isActive = (a: Appointment) => a.status === 'confirmada' || a.status === 'pendiente';
const started = (a: Appointment) => new Date(a.starts_at) <= now;
const byDay = new Map<string, Appointment[]>(weekDays.map((d) => [d, []]));
for (const a of appts) byDay.get(localDate(new Date(a.starts_at)))?.push(a);
const todayList = todayAll.filter((a) => a.status !== 'cancelada' && localDate(new Date(a.starts_at)) === today);

const blockedMap = new Map(blocked.map((b) => [b.day, b.reason || 'Día bloqueado']));
const hourOf = (d: string) => hours.find((h) => h.weekday === weekdayOf(d));
const offOf = (d: string) => blockedMap.get(d) ?? (!hourOf(d)?.enabled ? 'Cerrado' : null);

// Rango visible del calendario: horario de atención + citas fuera de él.
const enabled = hours.filter((h) => h.enabled);
let minM = enabled.length ? Math.min(...enabled.map((h) => minutesOf(h.open_time))) : 8 * 60;
let maxM = enabled.length ? Math.max(...enabled.map((h) => minutesOf(h.close_time))) : 18 * 60;
for (const a of appts) {
  minM = Math.min(minM, minutesOf(localTime(new Date(a.starts_at))));
  const e = localTime(new Date(a.ends_at));
  maxM = Math.max(maxM, e === '00:00' ? 24 * 60 : minutesOf(e));
}
const dayStart = Math.floor(minM / 60) * 60;
const dayEnd = Math.min(24 * 60, Math.ceil(maxM / 60) * 60);
const hourMarks = Array.from({ length: (dayEnd - dayStart) / 60 }, (_, i) => dayStart + i * 60);
const offsetOf = (iso: string) => minutesOf(localTime(new Date(iso))) - dayStart;
const durOf = (a: Appointment) => Math.max(20, (new Date(a.ends_at).getTime() - new Date(a.starts_at).getTime()) / 60000);

// Indicadores (cifras reales de la semana mostrada)
const priceOf = new Map(services.map((s) => [s.id, s.price_from ?? 0]));
const weekActive = appts.filter(isActive);
const income = appts.filter((a) => a.status !== 'cancelada').reduce((t, a) => t + (a.service_id ? (priceOf.get(a.service_id) ?? 0) : 0), 0);
const next = upcoming.find((a) => new Date(a.starts_at) > now);
const present = new Set(appts.filter((a) => a.status !== 'cancelada').map((a) => a.status));

// Formatos
const statusLabel: Record<AppointmentStatus, string> = { confirmada: 'Confirmada', pendiente: 'Pendiente', completada: 'Realizada', cancelada: 'Cancelada' };
const fmtDayShort = new Intl.DateTimeFormat('es-CO', { weekday: 'short', timeZone: 'UTC' });
const fmtDayLong = new Intl.DateTimeFormat('es-CO', { weekday: 'long', timeZone: 'UTC' });
const fmtMonth = new Intl.DateTimeFormat('es-CO', { month: 'long', timeZone: 'UTC' });
const fmtNum = (d: string) => Number(d.slice(8, 10));
const atNoon = (d: string) => new Date(`${d}T12:00:00Z`);
const dayShort = (d: string) => fmtDayShort.format(atNoon(d)).replace('.', '');
const monthOf = (d: string) => fmtMonth.format(atNoon(d));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const last = weekDays[6];
const sameMonth = monthOf(start) === monthOf(last);
const weekTitle = sameMonth ? `${fmtNum(start)} – ${fmtNum(last)} de ${monthOf(start)}` : `${fmtNum(start)} de ${monthOf(start)} – ${fmtNum(last)} de ${monthOf(last)}`;
const weekSpoken = sameMonth ? `${fmtNum(start)} al ${fmtNum(last)} de ${monthOf(start)}` : `${fmtNum(start)} de ${monthOf(start)} al ${fmtNum(last)} de ${monthOf(last)}`;
const todayLabel = `${cap(fmtDayLong.format(atNoon(today)))} ${fmtNum(today)}`;
const hourLabel = (m: number) => {
  const h = Math.floor(m / 60);
  return `${h % 12 || 12} ${h < 12 ? 'a. m.' : 'p. m.'}`;
};
const relDay = (iso: string) => {
  const d = localDate(new Date(iso));
  if (d === today) return 'Hoy';
  if (d === tomorrow) return 'Mañana';
  return prettyDate(iso);
};
const shortWhen = (iso: string) => {
  const d = localDate(new Date(iso));
  const day = d === today ? 'hoy' : d === tomorrow ? 'mañana' : `${dayShort(d)} ${fmtNum(d)}`;
  return `${day}, ${prettyTime(iso)}`;
};

// WhatsApp: el mensaje depende del estado (no se le "recuerda" una cita cancelada o pasada).
type WaKind = 'remind' | 'thanks' | 'hello';
const waKind = (a: Appointment): WaKind => (a.status === 'completada' ? 'thanks' : isActive(a) && !started(a) ? 'remind' : 'hello');
const waText = (a: Appointment) => {
  const who = firstName(a.customer_name);
  const kind = waKind(a);
  if (kind === 'remind') {
    const d = localDate(new Date(a.starts_at));
    const when = d === today ? 'de hoy' : d === tomorrow ? 'de mañana' : `del ${prettyDate(a.starts_at).toLowerCase()}`;
    return `Hola ${who} 👋 Te escribe Betsy Peinados para recordarte tu cita ${when} a las ${prettyTime(a.starts_at)} ¡Te espero! ✨`;
  }
  if (kind === 'thanks') return `Hola ${who} 👋 Te escribe Betsy Peinados. ¡Gracias por venir! ✨`;
  return `Hola ${who} 👋 Te escribe Betsy Peinados.`;
};
const waLink = (a: Appointment) => `https://wa.me/${a.customer_phone}?text=${encodeURIComponent(waText(a))}`;
const waLabel = (a: Appointment) => (waKind(a) === 'remind' ? 'Recordar por WhatsApp' : 'Escribir por WhatsApp');

const initials = (n: string) =>
  n
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join('');
const prettyPhone = (p: string) => {
  const m = p.match(/^57(3\d{2})(\d{3})(\d{4})$/);
  return m ? `+57 ${m[1]} ${m[2]} ${m[3]}` : `+${p}`;
};
const durLabel = (a: Appointment) => {
  const m = Math.round(durOf(a));
  const h = Math.floor(m / 60);
  const r = m % 60;
  return h ? `${h} h${r ? ` ${r} min` : ''}` : `${r} min`;
};
const cancelMsg = (a: Appointment) => {
  const who = firstName(a.customer_name);
  if (a.google_event_id && a.customer_email) return `¿Cancelar la cita de ${who}? El horario queda libre, se borra de tu Google Calendar y Google le avisa por correo.`;
  if (a.google_event_id) return `¿Cancelar la cita de ${who}? El horario queda libre y se borra de tu Google Calendar. Recuerda avisarle por WhatsApp.`;
  return `¿Cancelar la cita de ${who}? El horario queda libre. Recuerda avisarle por WhatsApp.`;
};
const selectedDay = thisWeek ? today : start;

// Un diálogo de detalle por cita (semana + hoy + próxima), sin duplicados.
const dialogAppts = [...new Map([...appts, ...todayAll, ...(next ? [next] : [])].map((a) => [a.id, a])).values()];
const todayOff = offOf(today);
---

<Admin title="Agenda" greet mobileSub={thisWeek ? prettyDate(now) : `Semana del ${weekSpoken}`}>
  <button slot="actions" type="button" class="btn btn-clay head-new" data-open-new>
    <Icon name="plus" /> Nueva cita
  </button>

  <!-- Acción rápida en móvil: al alcance del pulgar, encima de la barra inferior -->
  <button type="button" class="btn btn-clay fab" data-open-new data-fab>
    <Icon name="plus" /> Nueva cita
  </button>

  <!-- Hoy (escritorio y tableta) -->
  <section class="hoy panel" aria-labelledby="today-t">
    <div class="t-date">
      <p class="t-eyebrow" id="today-t">Hoy</p>
      <p class="t-day">{todayLabel}</p>
      <p class="muted">{todayList.length === 0 ? 'Sin citas' : todayList.length === 1 ? '1 cita' : `${todayList.length} citas`}</p>
    </div>
    <div class="t-list">
      {
        todayList.length ? (
          <ul>
            {todayList.slice(0, 4).map((a) => (
              <li class:list={['t-row', a.status]}>
                <button type="button" class="t-open" data-open={`ap-${a.id}`}>
                  <span class="t-time">{prettyTime(a.starts_at)}</span>
                  <span class="t-who">
                    <b>{a.customer_name}</b>
                    <span class="muted"> · {a.service_name}</span>
                    {next?.id === a.id && <span class="tag plain t-next">Sigue</span>}
                    {a.status === 'completada' && <span class="tag completada">Realizada</span>}
                  </span>
                </button>
                <a class="btn btn-wa btn-icon" href={waLink(a)} target="_blank" rel="noopener" aria-label={`${waLabel(a)} a ${a.customer_name}`}>
                  <Icon name="whatsapp" />
                </a>
              </li>
            ))}
            {todayList.length > 4 && <li class="t-more muted">+{todayList.length - 4} más en el calendario de abajo</li>}
          </ul>
        ) : (
          <div class="t-empty">
            <p class="t-empty-h">{todayOff ? `Hoy no atiendes · ${todayOff}` : 'Hoy no tienes citas.'}</p>
            {!todayOff && (
              <button type="button" class="btn btn-soft btn-sm" data-open-new data-date={today}>
                <Icon name="plus" /> Agendar para hoy
              </button>
            )}
            {next && (
              <button type="button" class="t-nextline" data-open={`ap-${next.id}`}>
                Próxima: <b>{firstName(next.customer_name)} · {next.service_name}</b> — {shortWhen(next.starts_at)}
              </button>
            )}
          </div>
        )
      }
    </div>
    <div class="t-week">
      <p>
        <strong>{weekActive.length}</strong>
        <span>{weekActive.length === 1 ? 'cita activa' : 'citas activas'} {thisWeek ? 'esta semana' : 'en la semana mostrada'}</span>
      </p>
      <p>
        <strong>{formatCOP(income)}</strong>
        <span>mínimo estimado de la semana</span>
      </p>
      {!thisWeek && <a class="t-back" href="/admin">Volver a esta semana</a>}
    </div>
  </section>

  <!-- Calendario -->
  <section class="cal panel" aria-label="Calendario semanal">
    <div class="cal-top">
      <div class="cal-nav">
        <a class="btn btn-soft btn-sm btn-icon" href={`/admin?desde=${addDays(start, -7)}`} aria-label="Semana anterior"><span class="flip"><Icon name="chevron" /></span></a>
        <a class="btn btn-soft btn-sm" href="/admin" aria-current={thisWeek ? 'true' : undefined}>Hoy</a>
        <a class="btn btn-soft btn-sm btn-icon" href={`/admin?desde=${addDays(start, 7)}`} aria-label="Semana siguiente"><Icon name="chevron" /></a>
      </div>
      <h2 class="cal-title">{cap(weekTitle)}</h2>
      {
        present.size > 0 && (
          <ul class="legend" aria-label="Leyenda">
            {(['confirmada', 'pendiente', 'completada'] as const).filter((s) => present.has(s)).map((s) => (
              <li>
                <i class:list={['lg', s]} /> {statusLabel[s]}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Tira de días (móvil) -->
    <div class="strip" role="group" aria-label="Elegir día">
      {
        weekDays.map((d) => {
          const n = (byDay.get(d) ?? []).filter((a) => a.status !== 'cancelada').length;
          const off = Boolean(offOf(d));
          return (
            <button type="button" class:list={['chip', { today: d === today, off }]} aria-pressed={d === selectedDay ? 'true' : 'false'} data-day={d}>
              <small>{dayShort(d)}</small>
              <b>{fmtNum(d)}</b>
              <i class="dots" aria-hidden="true">
                {Array.from({ length: Math.min(n, 3) }, () => (
                  <span />
                ))}
              </i>
              <span class="sr-only">
                {d === today ? ', hoy' : ''}, {n ? `${n} ${n === 1 ? 'cita' : 'citas'}` : 'sin citas'}
                {off ? ', no atiendes' : ''}
              </span>
            </button>
          );
        })
      }
    </div>

    <!-- Vista semanal (escritorio) -->
    <div class="week" data-week data-start={dayStart} data-today={today}>
      <div class="w-head">
        <span></span>
        {
          weekDays.map((d) => (
            <div class:list={['w-day', { today: d === today }]}>
              <small>{dayShort(d)}</small>
              <b>{fmtNum(d)}</b>
            </div>
          ))
        }
      </div>
      <div class="w-body">
        <div class="w-axis" aria-hidden="true">{hourMarks.map((m) => <span>{hourLabel(m)}</span>)}</div>
        {
          weekDays.map((d) => {
            const h = hourOf(d);
            const off = offOf(d);
            const list = (byDay.get(d) ?? []).filter((a) => a.status !== 'cancelada');
            return (
              <div class:list={['w-col', { today: d === today, closed: off, past: d < today }]} data-col={d}>
                {h?.enabled && !off && (
                  <div class="open-band" data-s={minutesOf(h.open_time) - dayStart} data-d={minutesOf(h.close_time) - minutesOf(h.open_time)} />
                )}
                {off && <span class="closed-label">{off}</span>}
                {list.map((a) => (
                  <button
                    type="button"
                    class:list={['ev', a.status]}
                    data-open={`ap-${a.id}`}
                    data-s={offsetOf(a.starts_at)}
                    data-d={durOf(a)}
                    title={`${a.customer_name} · ${prettyTime(a.starts_at)} · ${a.service_name}`}
                  >
                    <b>{a.customer_name}</b>
                    <span>
                      {prettyTime(a.starts_at)} · {a.service_name}
                    </span>
                    <span class="sr-only">
                      , {prettyDate(a.starts_at)}, {statusLabel[a.status]}
                    </span>
                  </button>
                ))}
                {d === today && <div class="now" data-now hidden />}
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Vista lista (móvil) -->
    <div class="days">
      {
        weekDays.map((d) => {
          const list = byDay.get(d) ?? [];
          const off = offOf(d);
          return (
            <section class="day" data-daylist={d} hidden={d !== selectedDay}>
              <h3>
                {prettyDate(fromLocal(d, '12:00'))} {d === today && <span class="tag plain">Hoy</span>}
                {blockedMap.has(d) && list.length > 0 && <span class="tag cancelada">Bloqueado</span>}
              </h3>
              {list.length === 0 ? (
                <div class="empty">
                  <p>{off ? `${off} · sin citas` : 'Aún no tienes citas este día.'}</p>
                  {!off && d >= today && (
                    <button type="button" class="btn btn-soft btn-sm" data-open-new data-date={d}>
                      <Icon name="plus" /> Agendar una cita
                    </button>
                  )}
                  {d === today && next && (
                    <button type="button" class="t-nextline" data-open={`ap-${next.id}`}>
                      Próxima: <b>{firstName(next.customer_name)} · {next.service_name}</b> — {shortWhen(next.starts_at)}
                    </button>
                  )}
                </div>
              ) : (
                <ul class="cards">
                  {list.map((a) => (
                    <li class:list={['card', a.status]}>
                      <button type="button" class="card-main" data-open={`ap-${a.id}`}>
                        <span class="c-time">
                          <b>{prettyTime(a.starts_at)}</b>
                          <small>{prettyTime(a.ends_at)}</small>
                        </span>
                        <span class="c-info">
                          <b>{a.customer_name}</b>
                          <small>
                            {a.service_name}
                            {a.status !== 'pendiente' && ` · ${statusLabel[a.status]}`}
                          </small>
                          {a.status === 'pendiente' && <span class="tag pendiente">Pendiente</span>}
                        </span>
                      </button>
                      {a.status !== 'cancelada' && (
                        <a class="btn btn-wa btn-icon" href={waLink(a)} target="_blank" rel="noopener" aria-label={`${waLabel(a)} a ${a.customer_name}`}>
                          <Icon name="whatsapp" />
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        })
      }
      <p class="week-sum">
        Semana: {weekActive.length} {weekActive.length === 1 ? 'cita activa' : 'citas activas'} · {formatCOP(income)} mínimo estimado
      </p>
    </div>
  </section>

  <!-- Detalle de cada cita -->
  {
    dialogAppts.map((a) => {
      const canComplete = isActive(a) && started(a);
      const laterToday = isActive(a) && !started(a) && localDate(new Date(a.starts_at)) === today;
      const who = firstName(a.customer_name);
      return (
        <dialog class:list={['ap', a.status]} id={`ap-${a.id}`} aria-labelledby={`apt-${a.id}`}>
          <header class="ap-top">
            <form method="dialog" class="ap-x">
              <button class="ap-close" aria-label="Cerrar">
                <Icon name="close" size={18} />
              </button>
            </form>
            <div class="ap-who">
              <span class="ap-av" aria-hidden="true">
                {initials(a.customer_name)}
              </span>
              <div>
                <h2 id={`apt-${a.id}`} tabindex="-1" autofocus>
                  {a.customer_name}
                </h2>
                <p class="ap-svc">
                  <Icon name="scissors" size={15} /> {a.service_name}
                </p>
              </div>
            </div>
            <div class="ap-tags">
              <span class={`tag ${a.status}`}>{statusLabel[a.status]}</span>
              {a.google_event_id && (
                <span class="tag plain g">
                  <Icon name="google" size={13} /> En tu Google Calendar
                </span>
              )}
              <span class="tag plain">{a.source === 'web' ? 'Reservó en la web' : 'La agendaste tú'}</span>
            </div>
          </header>
          <div class="ap-in">
            <div class="ap-when">
              <div class="ap-day">
                <span>{relDay(a.starts_at) === prettyDate(a.starts_at) ? 'Fecha' : relDay(a.starts_at)}</span>
                <strong>{prettyDate(a.starts_at)}</strong>
              </div>
              <div class="ap-hour">
                <span>Hora</span>
                <strong>
                  {prettyTime(a.starts_at)} – {prettyTime(a.ends_at)}
                </strong>
                <small>{durLabel(a)}</small>
              </div>
            </div>
            <dl class="ap-info">
              <div>
                <dt>
                  <Icon name="phone" size={16} /> Teléfono
                </dt>
                <dd>
                  <a href={`tel:+${a.customer_phone}`} aria-label={`Llamar al ${prettyPhone(a.customer_phone)}`}>
                    {prettyPhone(a.customer_phone)}
                  </a>
                </dd>
              </div>
              {a.customer_email && (
                <div>
                  <dt>
                    <Icon name="mail" size={16} /> Correo
                  </dt>
                  <dd>
                    <a href={`mailto:${a.customer_email}`}>{a.customer_email}</a>
                  </dd>
                </div>
              )}
              {a.service_id && (priceOf.get(a.service_id) ?? 0) > 0 && (
                <div>
                  <dt>
                    <Icon name="money" size={16} /> Valor desde
                  </dt>
                  <dd>{formatCOP(priceOf.get(a.service_id) ?? 0)}</dd>
                </div>
              )}
            </dl>
            {a.notes && (
              <blockquote class="ap-notes">
                <span>Nota de la clienta</span>
                {a.notes}
              </blockquote>
            )}
            <div class="ap-acts">
              {canComplete && (
                <form method="post" data-confirm={`¿Marcar la cita de ${who} como realizada?`} data-confirm-yes="Sí, marcar">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <input type="hidden" name="status" value="completada" />
                  <button class="btn btn-clay">
                    <Icon name="check" /> Marcar como realizada
                  </button>
                </form>
              )}
              <a class:list={['btn', 'btn-wa', { 'btn-wa-main': !canComplete }]} href={waLink(a)} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> {waLabel(a)}
              </a>
              {a.status === 'completada' && (
                <form method="post">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <input type="hidden" name="status" value="confirmada" />
                  <button class="btn btn-soft">Desmarcar realizada</button>
                </form>
              )}
            </div>
            {(laterToday || isActive(a)) && (
              <div class="ap-minor">
                {laterToday && (
                  <form
                    method="post"
                    data-confirm={`La cita de ${who} es hoy a las ${prettyTime(a.starts_at)} ¿Marcarla como realizada de una vez?`}
                    data-confirm-yes="Sí, ya terminé"
                  >
                    <input type="hidden" name="action" value="status" />
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="desde" value={start} />
                    <input type="hidden" name="status" value="completada" />
                    <button class="ap-minor-btn">
                      <Icon name="check" size={16} /> Ya terminé
                    </button>
                  </form>
                )}
                {isActive(a) && (
                  <form method="post" data-confirm={cancelMsg(a)} data-confirm-yes="Sí, cancelar cita">
                    <input type="hidden" name="action" value="status" />
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="desde" value={start} />
                    <input type="hidden" name="status" value="cancelada" />
                    <button class="ap-minor-btn danger">
                      <Icon name="ban" size={16} /> Cancelar esta cita
                    </button>
                  </form>
                )}
              </div>
            )}
          </div>
        </dialog>
      );
    })
  }

  <!-- Nueva cita -->
  <dialog class="new" id="new-appt" aria-labelledby="new-t">
    <form method="post" class="new-in" data-draft="new">
      <span class="sheet-grip" aria-hidden="true"></span>
      <div class="ap-head">
        <h2 id="new-t">Nueva cita</h2>
        <button type="button" class="btn btn-soft btn-sm btn-icon ap-x" aria-label="Cerrar" data-close><Icon name="close" /></button>
      </div>
      <p class="muted new-intro">
        {
          google
            ? 'Para citas que te llegan por WhatsApp, llamada o en persona. El horario queda ocupado en la web y la cita se anota en tu Google Calendar.'
            : 'Para citas que te llegan por WhatsApp, llamada o en persona. El horario queda ocupado en la web.'
        }
      </p>
      <p class="new-err" role="alert" hidden data-new-err></p>
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="desde" value={start} />
      <div class="grid-2">
        <div class="field full">
          <label for="m-service">Servicio</label>
          <select id="m-service" name="service_id" required>
            {
              services.map((s) => (
                <option value={s.id} data-dur={s.duration_min}>
                  {s.name}
                  {!s.active && ' (oculto en la web)'}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="m-date">Fecha</label>
          <input id="m-date" name="date" type="date" min={today} value={today} required />
        </div>
        <div class="field">
          <label for="m-time">Hora</label>
          <input id="m-time" name="time" type="time" step="300" required aria-describedby="m-end" />
          <small class="hint" id="m-end" data-end></small>
        </div>
        <div class="field">
          <label for="m-name">Nombre de la clienta</label>
          <input id="m-name" name="name" maxlength="80" minlength="2" autocomplete="off" required />
        </div>
        <div class="field">
          <label for="m-phone">WhatsApp de la clienta</label>
          <input id="m-phone" name="phone" type="tel" inputmode="tel" maxlength="20" placeholder="300 123 4567" autocomplete="off" required />
        </div>
        <details class="more full" data-more>
          <summary>Más datos (opcional)</summary>
          <div class="grid-2">
            <div class="field full">
              <label for="m-email">Correo</label>
              <input id="m-email" name="email" type="email" maxlength="120" />
            </div>
            <div class="field full">
              <label for="m-notes">Notas</label>
              <textarea id="m-notes" name="notes" maxlength="500" placeholder="Ocasión, largo del cabello, si es a domicilio…"></textarea>
            </div>
          </div>
        </details>
      </div>
      <div class="new-acts">
        <button type="button" class="btn btn-ghost" data-close>Cerrar sin guardar</button>
        <button class="btn btn-clay"><Icon name="check" /> Guardar cita</button>
      </div>
    </form>
  </dialog>
</Admin>

<style>
  /* Estados (color de la barra/fondo de cada cita) */
  .confirmada {
    --ev: var(--sage);
    --ev-bg: #e6eadb;
  }
  .pendiente {
    --ev: #a87a14;
    --ev-bg: #f7ecd0;
  }
  .completada {
    --ev: #8a7b70;
    --ev-bg: #efe9e2;
  }
  .cancelada {
    --ev: #c4533c;
    --ev-bg: #f8e1dc;
  }

  /* Botón de nueva cita: en escritorio arriba; en móvil flotante */
  .fab {
    display: none !important;
  }

  /* ───────── Hoy ───────── */
  .hoy {
    display: grid;
    grid-template-columns: 200px 1fr 200px;
    gap: var(--s-5);
    padding: var(--s-5);
    align-items: start;
  }
  .t-eyebrow {
    margin: 0;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .t-day {
    margin: var(--s-1) 0 var(--s-1);
    font: italic 450 var(--t-xl) / 1.1 var(--font-display);
  }
  .t-date .muted {
    margin: 0;
  }
  .t-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .t-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0 var(--s-2) var(--s-3);
    border-top: 1px dashed var(--line);
    border-left: 3px solid var(--ev);
  }
  .t-row:first-child {
    border-top: 0;
  }
  .t-open {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: baseline;
    gap: var(--s-3);
    min-height: 44px;
    padding: var(--s-1) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .t-open:hover b {
    color: var(--accent-text);
  }
  .t-time {
    font: 600 var(--t-md) var(--font-body);
    font-variant-numeric: tabular-nums;
  }
  .t-who .tag {
    margin-left: var(--s-2);
    vertical-align: 1px;
  }
  .t-more {
    padding: var(--s-2) 0 0 var(--s-3);
  }
  .t-empty {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
  }
  .t-empty-h {
    margin: 0;
    font: italic 450 var(--t-lg) / 1.2 var(--font-display);
    color: var(--muted);
  }
  .t-nextline {
    padding: var(--s-2) 0;
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--cocoa-2);
    font: 500 var(--t-sm) var(--font-body);
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--clay) 45%, transparent);
    text-underline-offset: 3px;
  }
  .t-week {
    display: grid;
    gap: var(--s-4);
    padding-left: var(--s-5);
    border-left: 1px solid var(--line);
  }
  .t-week p {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .t-week strong {
    font: 450 var(--t-xl) / 1 var(--font-display);
  }
  .t-week span {
    font-size: var(--t-xs);
    color: var(--muted);
    font-weight: 600;
  }
  .t-back {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--accent-text);
  }

  /* ───────── Calendario ───────── */
  .cal {
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }
  .cal-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }
  .cal-nav {
    display: flex;
    gap: 0.35rem;
  }
  .cal-nav [aria-current] {
    --b-bg: var(--cocoa);
    --b-fg: var(--white);
  }
  .flip {
    display: inline-flex;
    transform: rotate(180deg);
  }
  .cal-title {
    margin: 0 !important;
    font-size: var(--t-lg) !important;
  }
  .legend {
    display: flex;
    gap: 1rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lg {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: var(--ev);
  }
  .lg.pendiente {
    background: none;
    border: 2px dashed var(--ev);
  }

  /* Semana: rango completo, sin scroll interno (nada queda cortado) */
  .week {
    --ppm: 0.9px;
    --axis: 58px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--white);
  }
  .w-head,
  .w-body {
    display: grid;
    grid-template-columns: var(--axis) repeat(7, 1fr);
  }
  .w-head {
    border-bottom: 1px solid var(--line);
    background: var(--cream);
  }
  .w-day {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.5rem 0 0.6rem;
    border-left: 1px solid var(--line);
  }
  .w-day small {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .w-day b {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 450;
  }
  .w-day.today small {
    color: var(--accent-text);
  }
  .w-day.today b {
    background: var(--clay-deep);
    color: var(--white);
  }
  .w-body {
    position: relative;
  }
  .w-axis {
    display: grid;
    grid-auto-rows: calc(60 * var(--ppm));
  }
  .w-axis span {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--muted);
    text-align: right;
    padding-right: 0.5rem;
    transform: translateY(-0.45em);
  }
  .w-axis span:first-child {
    transform: none;
  }
  .w-col {
    position: relative;
    border-left: 1px solid var(--line);
    min-height: calc(var(--hours, 11) * 60 * var(--ppm));
    background-color: #f6f0e8;
    background-image: linear-gradient(var(--line) 1px, transparent 1px);
    background-size: 100% calc(60 * var(--ppm));
    cursor: pointer;
  }
  .w-col.closed,
  .w-col.past {
    cursor: default;
  }
  .w-col.closed {
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      repeating-linear-gradient(-45deg, transparent 0 8px, rgb(42 28 22 / 0.035) 8px 16px);
    background-size: 100% calc(60 * var(--ppm)), auto;
  }
  .open-band {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--s, 0) * var(--ppm));
    height: calc(var(--d, 0) * var(--ppm));
    background: var(--white);
    background-image: linear-gradient(var(--line) 1px, transparent 1px);
    background-size: 100% calc(60 * var(--ppm));
    background-position: 0 calc(var(--s, 0) * var(--ppm) * -1);
  }
  .w-col.past .open-band {
    background-color: #fbf6ef;
  }
  .w-col.today .open-band {
    background-color: #fffdf9;
  }
  .closed-label {
    position: sticky;
    top: 0.75rem;
    display: block;
    margin: 0.75rem auto 0;
    width: max-content;
    max-width: 90%;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--cream-2);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--muted);
    text-align: center;
  }
  .ev {
    position: absolute;
    left: 4px;
    right: 4px;
    top: calc(var(--s, 0) * var(--ppm) + 1px);
    height: calc(var(--d, 60) * var(--ppm) - 2px);
    display: grid;
    align-content: start;
    gap: 0;
    padding: 4px 6px;
    overflow: hidden;
    border: 0;
    border-left: 3px solid var(--ev);
    border-radius: var(--r-xs);
    background: var(--ev-bg);
    color: var(--cocoa);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
    animation: ev-in 0.5s var(--ease) backwards;
  }
  .ev.pendiente {
    border-left-style: dashed;
  }
  .ev:hover,
  .ev:focus-visible {
    z-index: 2;
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 12px 24px -12px rgb(42 28 22 / 0.45);
  }
  .ev b {
    font-size: var(--t-sm);
    font-weight: 700;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ev span {
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--cocoa-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ev.short span:not(.sr-only) {
    display: none;
  }
  .ev.completada b {
    text-decoration: line-through;
    text-decoration-color: rgb(42 28 22 / 0.35);
  }
  @keyframes ev-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  .now {
    position: absolute;
    z-index: 3;
    left: -1px;
    right: 0;
    top: calc(var(--s, 0) * var(--ppm));
    height: 2px;
    background: var(--clay);
    pointer-events: none;
  }
  .now::before {
    content: '';
    position: absolute;
    left: -5px;
    top: -4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--clay);
    box-shadow: 0 0 0 4px rgb(184 96 63 / 0.2);
  }

  /* ───────── Tira de días + lista (móvil) ───────── */
  .strip,
  .days {
    display: none;
  }
  .chip {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    min-height: 64px;
    padding: 0.45rem 0;
    border: 1.5px solid transparent;
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--cocoa);
    font: inherit;
    cursor: pointer;
    transition: background 0.25s, transform 0.3s var(--ease), border-color 0.25s;
  }
  .chip small {
    font-size: var(--t-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .chip b {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 450;
    line-height: 1.1;
  }
  .chip.today {
    border-color: var(--clay);
  }
  .chip.today small {
    color: var(--accent-text);
  }
  .chip.off {
    background: transparent;
    border: 1.5px dashed var(--field-line);
  }
  .chip.off.today {
    border-color: var(--clay);
  }
  .chip.off b {
    color: var(--muted);
  }
  .chip[aria-pressed='true'] {
    background: var(--cocoa);
    border-style: solid;
    border-color: var(--cocoa);
    color: var(--white);
  }
  .chip[aria-pressed='true'] b {
    color: var(--white);
  }
  .chip[aria-pressed='true'] small {
    color: var(--blush);
  }
  .dots {
    display: flex;
    gap: 3px;
    height: 5px;
  }
  .dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--clay);
  }
  .chip[aria-pressed='true'] .dots span {
    background: var(--blush);
  }
  .day h3 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--s-4) 0 var(--s-3);
    font-size: var(--t-lg);
  }
  .day:not([hidden]) {
    animation: a-rise 0.4s var(--ease) backwards;
  }
  .empty {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-4);
    border: 1.5px dashed var(--field-line);
    border-radius: var(--r-md);
    color: var(--muted);
    text-align: center;
  }
  .empty p {
    margin: 0;
    font: italic 450 var(--t-lg) / 1.25 var(--font-display);
  }
  .empty .t-nextline {
    text-align: center;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .card {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1);
    border-radius: var(--r-md);
    background: var(--ev-bg);
    border-left: 4px solid var(--ev);
  }
  .card.pendiente {
    border-left-style: dashed;
  }
  .card.cancelada .c-info b,
  .card.cancelada .c-time b {
    text-decoration: line-through;
    text-decoration-color: rgb(42 28 22 / 0.45);
  }
  .card-main {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .c-time,
  .c-info {
    display: grid;
    min-width: 0;
  }
  .c-time {
    flex: none;
    white-space: nowrap;
    padding-right: var(--s-3);
    border-right: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .c-info .tag {
    justify-self: start;
    margin-top: var(--s-1);
  }
  .c-time small,
  .c-info small {
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .c-info {
    flex: 1;
  }
  .c-info b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card .btn-icon {
    flex: none;
  }
  .week-sum {
    margin: var(--s-4) 0 0;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .hoy {
      grid-template-columns: 180px 1fr;
    }
    .t-week {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: var(--s-6);
      padding: var(--s-4) 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 860px) {
    .head-new {
      display: none !important;
    }
    .fab {
      display: inline-flex !important;
      position: fixed !important;
      right: var(--s-4);
      bottom: calc(var(--tab-h) + var(--s-3) + env(safe-area-inset-bottom));
      z-index: 41;
      min-height: 52px !important;
      padding: 0 20px !important;
      border-radius: 999px;
      box-shadow: 0 14px 28px -12px rgb(143 68 41 / 0.7);
      animation: none !important;
    }
  }
  @media (max-width: 760px) {
    .hoy,
    .week,
    .legend {
      display: none;
    }
    .cal.panel {
      background: none;
      border: 0;
      box-shadow: none;
      padding: 0;
      margin-bottom: 0;
    }
    .cal-top {
      flex-wrap: nowrap;
      justify-content: space-between;
      margin-bottom: var(--s-2);
    }
    .cal-title {
      order: -1;
      font: 600 var(--t-sm) var(--font-body) !important;
      color: var(--muted);
    }
    .strip {
      position: sticky;
      top: 0;
      z-index: 5;
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: var(--s-1);
      margin-inline: calc(var(--s-4) * -1);
      padding: var(--s-2) var(--s-4);
      background: var(--a-bg);
    }
    .days {
      display: block;
    }
  }

  /* ───────── Diálogos ───────── */
  dialog.ap {
    width: min(540px, calc(100% - 1.5rem));
  }
  .ap-top {
    position: relative;
    padding: 1.5rem 1.6rem 1.2rem;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--ev) 26%, transparent), transparent 60%),
      var(--ev-bg);
    border-bottom: 1px solid color-mix(in oklab, var(--ev) 25%, transparent);
  }
  .ap-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ap-head h2 {
    margin: 0 !important;
  }
  .new .ap-x {
    margin-left: auto;
  }
  .ap-top .ap-x {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
  .ap-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.65);
    color: var(--cocoa);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease);
  }
  .ap-close:hover {
    background: var(--white);
    transform: rotate(90deg);
  }
  .ap-close:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }
  .ap-who {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-right: 2.75rem;
  }
  .ap-av {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ev);
    color: #fff;
    font: 600 1.25rem/1 var(--font-display);
    letter-spacing: 0.02em;
    box-shadow: 0 6px 18px -6px color-mix(in oklab, var(--ev) 70%, transparent);
  }
  .ap h2 {
    margin: 0;
    font-size: clamp(1.4rem, 4.6vw, 1.75rem);
    line-height: 1.1;
    outline: none;
  }
  .ap-svc {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.3rem 0 0;
    color: var(--accent-text);
    font-weight: 700;
    font-size: var(--t-md);
  }
  .ap-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .ap-tags .tag.plain {
    background: rgb(255 255 255 / 0.7);
  }
  .ap-tags .tag.g {
    background: #e8eef9;
    color: #2a4d8f;
  }
  .ap-in,
  .new-in {
    padding: 1.3rem 1.6rem 1.5rem;
  }
  .ap-when {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .ap-when > div {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border-radius: var(--r-md);
    background: var(--cream);
  }
  .ap-when span,
  .ap-info dt,
  .ap-notes span {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ap-when strong {
    font-size: var(--t-md);
    line-height: 1.25;
  }
  .ap-when small {
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .ap-info {
    margin: 1rem 0 0;
    display: grid;
    gap: 0;
  }
  .ap-info > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    min-height: 48px;
    border-bottom: 1px dashed var(--line);
  }
  .ap-info dt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
  }
  .ap-info dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .ap-info a {
    display: inline-block;
    padding-block: 0.6rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--clay) 45%, transparent);
    text-underline-offset: 3px;
  }
  .ap-info a:hover {
    color: var(--accent-text);
  }
  .ap-notes {
    display: grid;
    gap: 0.3rem;
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: var(--r-md);
    background: var(--cream);
    border-left: 3px solid var(--ev);
    color: var(--cocoa-2);
  }
  .ap-acts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.55rem;
    margin-top: 1.3rem;
  }
  .ap-acts form,
  .ap-acts .btn,
  .ap-acts button {
    width: 100%;
    justify-content: center;
    white-space: nowrap;
  }
  .ap-acts .btn-wa-main {
    grid-column: 1 / -1;
    min-height: 52px;
    font-size: var(--t-md);
  }
  .ap-minor {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .ap-minor-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--cocoa-2);
    font: 600 var(--t-sm) var(--font-body);
    cursor: pointer;
    transition: background 0.2s;
  }
  .ap-minor-btn:hover {
    background: var(--cream-2);
  }
  .ap-minor-btn.danger {
    color: #9c2a1a;
  }
  .ap-minor-btn.danger:hover {
    background: #f8e1dc;
  }
  @media (max-width: 480px) {
    .ap-top,
    .ap-in {
      padding-left: 1.2rem;
      padding-right: 1.2rem;
    }
    .ap-av {
      width: 48px;
      height: 48px;
      font-size: 1.05rem;
    }
    .ap-acts {
      grid-template-columns: 1fr;
    }
  }

  dialog.new {
    width: min(620px, calc(100% - 1.5rem));
  }
  .new-intro {
    margin: 0.4rem 0 1.2rem;
  }
  .new-err {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--r-sm);
    background: #f6d9d3;
    color: #7d1f12;
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .more {
    border-top: 1px dashed var(--line);
    padding-top: var(--s-2);
  }
  .more summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--cocoa-2);
    cursor: pointer;
  }
  .more[open] summary {
    margin-bottom: var(--s-2);
  }
  .new-acts {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin: 1.4rem -1.6rem -1.5rem;
    padding: var(--s-3) 1.6rem calc(var(--s-3) + env(safe-area-inset-bottom));
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .sheet-grip {
    display: none;
  }

  /* En el celular, los diálogos salen como hoja desde abajo (acciones cerca del pulgar) */
  @media (max-width: 560px) {
    dialog.ap,
    dialog.new {
      margin: auto 0 0;
      width: 100%;
      max-width: none;
      max-height: 92dvh;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
    }
    dialog.ap[open],
    dialog.new[open] {
      animation: sheet-in 0.35s var(--ease) both;
    }
    .ap-in {
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));
    }
    .new-in {
      padding: 0.6rem 1.2rem 1.5rem;
    }
    .sheet-grip {
      display: block;
      width: 36px;
      height: 4px;
      margin: 0 auto 0.6rem;
      border-radius: 4px;
      background: var(--line);
    }
    .new-acts {
      margin-inline: -1.2rem;
      padding-inline: 1.2rem;
    }
    .new-acts .btn-clay {
      flex: 1;
    }
    .new-acts .btn-ghost {
      border-color: transparent;
      padding-inline: 0.6rem;
    }
  }
  @keyframes sheet-in {
    from {
      transform: translateY(24px);
      opacity: 0.4;
    }
  }
</style>

<script>
  // Coloca citas, franjas de horario y la línea de "ahora" según sus minutos.
  const week = document.querySelector<HTMLElement>('[data-week]');
  if (week) {
    const startMin = Number(week.dataset.start);
    // La escala sale del CSS (--ppm): una sola fuente para dibujar y para el clic.
    const ppm = () => parseFloat(getComputedStyle(week).getPropertyValue('--ppm')) || 0.9;
    week.querySelectorAll<HTMLElement>('[data-s]').forEach((el) => {
      el.style.setProperty('--s', el.dataset.s!);
      el.style.setProperty('--d', el.dataset.d!);
    });
    week.querySelectorAll<HTMLElement>('.ev').forEach((ev) => ev.classList.toggle('short', Number(ev.dataset.d) * ppm() < 40));
    const axis = week.querySelectorAll('.w-axis span').length;
    week.style.setProperty('--hours', String(axis));

    const nowEl = week.querySelector<HTMLElement>('[data-now]');
    const body = week.querySelector<HTMLElement>('.w-body');
    const placeNow = () => {
      const parts = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Bogota' }).format(new Date());
      const [h, m] = parts.split(':').map(Number);
      const off = h * 60 + m - startMin;
      if (!nowEl) return off;
      nowEl.hidden = off < 0 || off > axis * 60;
      nowEl.style.setProperty('--s', String(off));
      return off;
    };
    const off = placeNow();
    setInterval(placeNow, 60_000);
    // Solo si el calendario tuviera scroll propio: nunca esconder la primera cita.
    if (body && body.scrollHeight > body.clientHeight + 4) {
      const firsts = [...week.querySelectorAll<HTMLElement>('.ev')].map((e) => Number(e.dataset.s));
      const candidates = [...firsts, nowEl && !nowEl.hidden ? off - 60 : Infinity];
      const target = Math.min(...candidates) - 30;
      if (Number.isFinite(target) && target > 0) body.scrollTop = target * ppm();
    }

    // Clic en un espacio vacío de hoy o un día futuro: nueva cita en ese día y hora.
    week.querySelectorAll<HTMLElement>('.w-col:not(.closed):not(.past)').forEach((col) =>
      col.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.ev')) return;
        const y = e.clientY - col.getBoundingClientRect().top;
        const mins = Math.max(0, Math.round((y / ppm() + startMin) / 30) * 30);
        const t = `${String(Math.floor(mins / 60) % 24).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
        openNew(col.dataset.col!, t);
      }),
    );
  }

  // Diálogos de detalle.
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement | null)?.showModal()),
  );
  // Cerrar diálogos al tocar fuera (el de nueva cita, solo si no hay nada escrito).
  let dirty = false;
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((d) =>
    d.addEventListener('click', (e) => {
      if (e.target !== d) return;
      if (d.id === 'new-appt' && dirty) return;
      d.close();
    }),
  );

  // Nueva cita.
  const dlgNew = document.getElementById('new-appt') as HTMLDialogElement | null;
  const formNew = dlgNew?.querySelector<HTMLFormElement>('form');
  const $ = <T extends HTMLElement>(sel: string) => dlgNew?.querySelector<T>(sel) ?? null;
  const svcEl = $<HTMLSelectElement>('#m-service');
  const dateEl = $<HTMLInputElement>('#m-date');
  const timeEl = $<HTMLInputElement>('#m-time');
  const phoneEl = $<HTMLInputElement>('#m-phone');
  const endEl = $<HTMLElement>('[data-end]');
  const errEl = $<HTMLElement>('[data-new-err]');
  const touch = matchMedia('(pointer: coarse)').matches;

  // "Termina a las …" según la duración del servicio.
  const fmt12 = (m: number) => {
    const h = Math.floor(m / 60) % 24;
    return `${h % 12 || 12}:${String(m % 60).padStart(2, '0')} ${h < 12 ? 'a. m.' : 'p. m.'}`;
  };
  const showEnd = () => {
    if (!endEl || !timeEl || !svcEl) return;
    const dur = Number(svcEl.selectedOptions[0]?.dataset.dur ?? 0);
    const [h, m] = timeEl.value.split(':').map(Number);
    endEl.textContent = timeEl.value && dur ? `Termina a las ${fmt12(h * 60 + m + dur)}` : '';
  };
  svcEl?.addEventListener('change', showEnd);
  timeEl?.addEventListener('input', showEnd);

  // Misma regla que el servidor para el WhatsApp, para avisar antes de enviar.
  const phoneOk = (v: string) => {
    let d = v.replace(/[^\d+]/g, '');
    if (d.startsWith('+')) d = d.slice(1);
    else if (d.length === 10 && d.startsWith('3')) d = `57${d}`;
    return /^[0-9]{7,15}$/.test(d);
  };
  const checkPhone = () => {
    if (!phoneEl) return;
    phoneEl.setCustomValidity(phoneEl.value && !phoneOk(phoneEl.value) ? 'Escribe el número con 10 dígitos, ej.: 300 123 4567' : '');
  };
  phoneEl?.addEventListener('input', () => {
    checkPhone();
    phoneEl.removeAttribute('aria-invalid');
  });
  formNew?.addEventListener('input', () => (dirty = true));
  formNew?.addEventListener('submit', () => {
    if (dateEl?.value) formNew.dataset.posDay = dateEl.value;
  });

  function openNew(date?: string, time?: string) {
    if (!dlgNew) return;
    if (date && dateEl && date >= dateEl.min) dateEl.value = date;
    if (time && timeEl) timeEl.value = time;
    showEnd();
    dlgNew.showModal();
    // En el celular no se abre el teclado de entrada (taparía fecha y hora).
    if (!touch) $<HTMLInputElement>('#m-name')?.focus();
  }
  document.querySelectorAll<HTMLElement>('[data-open-new]').forEach((b) => b.addEventListener('click', () => openNew(b.dataset.date)));
  dlgNew?.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlgNew.close()));

  // Si el guardado falló: se reabre con lo escrito y se enfoca el campo a revisar.
  formNew?.addEventListener('bp:restored', (e) => {
    const message = (e as CustomEvent<{ message: string }>).detail.message;
    const pick = /whatsapp/i.test(message)
      ? '#m-phone'
      : /nombre/i.test(message)
        ? '#m-name'
        : /correo/i.test(message)
          ? '#m-email'
          : /esa hora/i.test(message)
            ? '#m-time'
            : /fecha/i.test(message)
              ? '#m-date'
              : /servicio/i.test(message)
                ? '#m-service'
                : null;
    if (errEl) {
      errEl.textContent = message;
      errEl.hidden = false;
    }
    const more = $<HTMLDetailsElement>('[data-more]');
    if (more && ($<HTMLInputElement>('#m-email')?.value || $<HTMLTextAreaElement>('#m-notes')?.value)) more.open = true;
    dirty = true;
    showEnd();
    dlgNew?.showModal();
    const field = pick ? $<HTMLInputElement>(pick) : null;
    if (field) {
      field.setAttribute('aria-invalid', 'true');
      field.addEventListener('input', () => field.removeAttribute('aria-invalid'), { once: true });
      field.focus();
    }
  });

  // Tira de días (móvil).
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      let shown: HTMLElement | null = null;
      document.querySelectorAll<HTMLElement>('[data-daylist]').forEach((s) => {
        s.hidden = s.dataset.daylist !== c.dataset.day;
        if (!s.hidden) shown = s;
      });
      (shown as HTMLElement | null)?.scrollIntoView({ block: 'nearest' });
    }),
  );
</script>
