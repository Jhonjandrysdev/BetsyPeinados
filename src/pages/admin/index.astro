---
import { waUrl } from '../../lib/walink';
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { SlotTakenError, citaStore, getAppointment, getAppointments, getBlockedDates, getGoogleConnection, getHours, getServices, getSettings, getTemplates, updateAppointment } from '../../lib/db';
import { DEFAULT_TEMPLATES, NOTICE_EVENTS, fillTemplate, type NoticeEvent } from '../../lib/messages';
import { TEXTO_TOPE_AGOTADO } from '../../lib/tope-whatsapp';
import { estadoTopeActual, sendFree, sendNotice, sendNoticeSafe, waConfigured, waErrorText, waNumber, type SendResult } from '../../lib/whatsapp';
import { book, BookingError, bookingSchema } from '../../lib/booking';
import { cancelCalendarEvent, confirmCalendarEvent, createCalendarEvent, moveCalendarEvent } from '../../lib/google';
import { DEPOSIT_PCT, HAIR_LENGTHS, hairLabel } from '../../lib/defaults';
import { aceptaAvisos, CitaError, createCitas, cupoLiberado, debeAvisarRechazo, resumenDeCita, valorDeCita } from '../../lib/cita';
import { accionCalendario, fueraDeHorario } from '../../lib/agenda';
import { addDays, formatCOP, fromLocal, isDate, localDate, localTime, minutesOf, prettyDate, prettyTime as prettyTimeRaw, weekdayOf } from '../../lib/time';
import { isUuid, str } from '../../lib/admin';
import type { Appointment, AppointmentStatus } from '../../lib/types';

/** Lunes de la semana que contiene la fecha. */
const mondayOf = (d: string) => addDays(d, -((weekdayOf(d) + 6) % 7));
const firstName = (n: string) => n.split(' ')[0];
/** Hora con espacios duros: «3:00 p. m.» nunca se parte a mitad. */
const prettyTime = (d: Date | string) => prettyTimeRaw(d).replace(/ /g, '\u00a0');

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  const desde = str(fd, 'desde', 10);
  /** Redirige a la agenda con el aviso; `extra` son parámetros ya codificados que terminan en "&". */
  const goUrl = (kind: 'ok' | 'error' | 'warn', msg: string, week = desde, open = '', extra = '') =>
    `/admin?${isDate(week) ? `desde=${week}&` : ''}${open ? `abrir=${open}&` : ''}${extra}${kind}=${encodeURIComponent(msg)}`;
  const goRedirect = (kind: 'ok' | 'error' | 'warn', msg: string, week = desde, open = '', extra = '') =>
    new Response(null, { status: 303, headers: { Location: goUrl(kind, msg, week, open, extra) } });
  // Formularios que el panel envía por fetch (Accept: JSON): responden JSON y la página no se recarga.
  const wantsJson = (Astro.request.headers.get('accept') ?? '').includes('application/json');
  const go = (kind: 'ok' | 'error' | 'warn', msg: string, week = desde, open = '', extra = '') =>
    wantsJson
      ? new Response(JSON.stringify({ ok: kind !== 'error', kind, msg, next: goUrl(kind, msg, week, open) }), {
          headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
        })
      : goRedirect(kind, msg, week, open, extra);
  const OOPS = 'Algo salió mal. Recarga la página e intenta de nuevo.';
  const citas = createCitas(citaStore);
  const waOn = waConfigured();
  /** Frase para el aviso flotante según cómo salió el WhatsApp. */
  const waSay = (r: SendResult | null, who: string) =>
    !r || (!r.ok && r.reason === 'not_configured')
      ? ''
      : r.ok
        ? ` Le llegó el aviso por WhatsApp${r.kind === 'plantilla' ? ' (plantilla de Meta)' : ''}.`
        : ` Pero el WhatsApp a ${who} no salió: ${waErrorText(r)}. Usa «Abrir en mi WhatsApp».`;

  if (action === 'status') {
    const id = str(fd, 'id', 40);
    const status = str(fd, 'status', 20) as AppointmentStatus;
    if (!isUuid(id) || !['confirmada', 'cancelada', 'completada'].includes(status)) return go('error', OOPS);
    const appt = await getAppointment(id);
    if (!appt) return go('error', 'No encontramos esa cita. Recarga la página.');
    const prev = appt.status;
    const depositOk = status === 'confirmada' && prev === 'pendiente';
    // Si se reactiva una cita cancelada, ya no aplica el motivo de cancelación.
    const reopen = prev === 'cancelada' ? { cancel_reason: null } : {};
    try {
      await updateAppointment(id, depositOk ? { status, deposit_confirmed_at: new Date().toISOString(), ...reopen } : { status, ...reopen });
    } catch (e) {
      // Al reactivar, el horario pudo haberlo tomado otra clienta mientras estaba cancelada.
      if (e instanceof SlotTakenError) return go('error', 'Ese horario ya lo tiene otra cita. Mueve primero esta cita a otra hora.', desde, id);
      throw e;
    }
    // Google Calendar: la cita en firme (abono confirmado o reactivada) debe estar allá; la cancelada, no.
    const cal = accionCalendario({ antes: prev, despues: status, tieneEvento: Boolean(appt.google_event_id) });
    let gcalWarn = '';
    if (cal === 'confirmar' || cal === 'crear') {
      try {
        if (cal === 'confirmar' && appt.google_event_id) await confirmCalendarEvent(appt.google_event_id, appt);
        else {
          const eventId = await createCalendarEvent({ ...appt, status: 'confirmada' }, await getSettings());
          if (eventId) await updateAppointment(id, { google_event_id: eventId });
        }
      } catch (e) {
        console.error(e);
        if (prev === 'cancelada') gcalWarn = ' No se pudo anotar de nuevo en tu Google Calendar: agrégala a mano allá.';
      }
    }
    if (cal === 'cancelar' && appt.google_event_id) {
      try {
        await cancelCalendarEvent(appt.google_event_id, Boolean(appt.customer_email));
        await updateAppointment(id, { google_event_id: null });
      } catch (e) {
        console.error(e);
        return go('error', 'Cita cancelada, pero no se pudo borrar de tu Google Calendar. Bórrala a mano allá.');
      }
    }
    const who = firstName(appt.customer_name);
    // Aviso automático por WhatsApp (si está conectado) para los momentos que la clienta debe saber.
    const notice: NoticeEvent | null = depositOk ? 'abono' : status === 'cancelada' && prev !== 'cancelada' ? 'cancelada' : status === 'completada' && prev !== 'completada' ? 'gracias' : null;
    let wa: SendResult | null = null;
    if (notice && waOn) {
      try {
        wa = await sendNotice({ ...appt, status }, notice);
      } catch (e) {
        console.error(e);
        wa = { ok: false, reason: 'error', error: 'No se pudo conectar con WhatsApp' };
      }
    }
    if (wa && !wa.ok) return go('warn', `${status === 'cancelada' ? `Cita de ${who} cancelada.` : status === 'completada' ? `Cita de ${who} marcada como realizada.` : `Abono de ${who} recibido.`}${waSay(wa, who)}`, desde, id);
    if (wa?.ok) {
      const done = status === 'cancelada' ? `Cita de ${who} cancelada. El horario quedó libre.` : status === 'completada' ? `¡Listo! Cita de ${who} marcada como realizada.` : `Abono de ${who} recibido. La cita quedó confirmada ✨`;
      return go('ok', `${done}${waSay(wa, who)}`, desde);
    }
    return go(
      gcalWarn ? 'warn' : 'ok',
      (status === 'cancelada'
        ? `Cita de ${who} cancelada. El horario quedó libre.`
        : status === 'completada'
          ? `¡Listo! Cita de ${who} marcada como realizada.`
          : prev === 'completada'
            ? `La cita de ${who} ya no está marcada como realizada.`
            : depositOk
              ? `Abono de ${who} recibido. La cita quedó confirmada ✨ Avísale por WhatsApp.`
              : prev === 'cancelada'
                ? `Cita de ${who} reactivada y confirmada`
                : `Cita de ${who} confirmada`) + gcalWarn,
      desde,
      depositOk || gcalWarn ? id : '',
    );
  }

  if (action === 'valor') {
    const id = str(fd, 'id', 40);
    if (!isUuid(id)) return go('error', OOPS);
    // Pesos sin puntos: "95.000" o "95000" valen lo mismo.
    const pesos = (k: string) => {
      const raw = str(fd, k, 20).replace(/[\s.$]/g, '');
      return raw === '' ? null : /^\d+$/.test(raw) ? Number(raw) : Number.NaN;
    };
    const price = pesos('price');
    if (price === null) return go('error', 'Escribe el valor de la cita.', desde, id);
    try {
      await citas.ajustarValor(id, { price, travelFee: pesos('travel_fee') });
    } catch (e) {
      if (e instanceof CitaError) return go('error', e.message, desde, id);
      console.error('Ajustar valor (¿faltan las migraciones precio_en_cita / valor_final?)', e);
      return go('error', 'No se pudo guardar el valor. Intenta de nuevo.', desde, id);
    }
    return go('ok', 'Valor actualizado. La clienta ya lo ve en su página.', desde, id);
  }

  if (action === 'rechazar') {
    const id = str(fd, 'id', 40);
    if (!isUuid(id)) return go('error', OOPS);
    try {
      await citas.rechazarComprobante(id, str(fd, 'motivo', 300), str(fd, 'receipt', 200) || undefined);
    } catch (e) {
      if (e instanceof CitaError) return go('error', e.message, desde, id);
      console.error('Rechazar comprobante (¿falta la migración rechazo_comprobante?)', e);
      return go('error', 'No se pudo rechazar el comprobante. Intenta de nuevo.', desde, id);
    }
    // Con el WhatsApp automático conectado, el aviso con el motivo le llega solo.
    const rejected = waOn ? await getAppointment(id) : null;
    if (!rejected) return go('ok', 'Comprobante rechazado. Avísale a la clienta por WhatsApp: el mensaje ya está escrito.', desde, id);
    const wa = await sendNoticeSafe(rejected, 'comprobante_rechazado');
    return go(wa.ok ? 'ok' : 'warn', `Comprobante rechazado.${waSay(wa, firstName(rejected.customer_name))}`, desde, id);
  }

  // Enviar por WhatsApp (API) el aviso que toca, o pedirle a la clienta que confirme.
  if (action === 'notice') {
    const id = str(fd, 'id', 40);
    const ev = str(fd, 'ev', 20) as NoticeEvent;
    if (!isUuid(id) || !NOTICE_EVENTS.some((e) => e.id === ev)) return go('error', OOPS);
    const appt = await getAppointment(id);
    if (!appt) return go('error', 'No encontramos esa cita. Recarga la página.');
    const who = firstName(appt.customer_name);
    if (!waOn) return go('error', 'El WhatsApp automático aún no está conectado. Usa «Abrir en mi WhatsApp».', desde, id);
    const r = await sendNoticeSafe(appt, ev);
    if (!r.ok) return go('error', `No se pudo enviar a ${who}: ${waErrorText(r)}.`, desde, id);
    return go('ok', ev === 'recordatorio' ? `Listo: le preguntamos a ${who} si confirma. Verás su respuesta aquí.` : `Mensaje enviado a ${who}${r.kind === 'plantilla' ? ' (plantilla de Meta)' : ''}.`, desde, id);
  }

  // Respuesta libre a la clienta desde la conversación.
  if (action === 'reply') {
    const id = str(fd, 'id', 40);
    const text = String(fd.get('text') ?? '').replace(/[\u0000-\u0008\u000b-\u001f\u007f]/g, '').trim().slice(0, 2000);
    if (!isUuid(id)) return go('error', OOPS);
    const appt = await getAppointment(id);
    if (!appt) return go('error', 'No encontramos esa cita. Recarga la página.');
    if (!text) return go('error', 'Escribe el mensaje.', desde, id);
    const r = await sendFree(appt, text).catch((e) => ({ ok: false, reason: 'error', error: String(e?.message ?? e) }) as SendResult);
    if (!r.ok && r.reason === 'window_closed')
      return go('warn', `${firstName(appt.customer_name)} no te ha escrito en las últimas 24 horas: WhatsApp solo deja mandar plantillas. Usa «Pedir confirmación» o «Abrir en mi WhatsApp».`, desde, id);
    if (!r.ok) return go('error', `No se pudo enviar: ${waErrorText(r)}.`, desde, id);
    return go('ok', 'Mensaje enviado', desde, id);
  }

  // Cambiar la hora o reagendar a otro día.
  if (action === 'move') {
    // Desde el panel llega por fetch (Accept: JSON): los errores se muestran en el formulario sin recargar.
    const json = (Astro.request.headers.get('accept') ?? '').includes('application/json');
    const go = (kind: 'ok' | 'error' | 'warn', msg: string, week = desde, open = '', extra = '', more: Record<string, unknown> = {}) =>
      json
        ? new Response(JSON.stringify({ ok: kind !== 'error', kind, msg, next: goUrl(kind, msg, week, open), ...more }), {
            headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
          })
        : goRedirect(kind, msg, week, open, extra);
    const id = str(fd, 'id', 40);
    const date = str(fd, 'date', 10);
    const time = str(fd, 'time', 5);
    const notify = fd.get('notify') === 'on';
    if (!isUuid(id)) return go('error', OOPS);
    const appt = await getAppointment(id);
    if (!appt) return go('error', 'No encontramos esa cita. Recarga la página.');
    const who = firstName(appt.customer_name);
    if (appt.status !== 'pendiente' && appt.status !== 'confirmada') return go('error', 'Solo se pueden mover citas activas.', desde, id);
    if (!isDate(date) || !/^([01]\d|2[0-3]):[0-5]\d$/.test(time)) return go('error', 'Elige la nueva fecha y hora.', desde, id);
    const startsAt = fromLocal(date, time);
    if (startsAt.getTime() < Date.now() - 5 * 60_000) return go('error', 'Esa hora ya pasó. Elige una fecha y hora futuras.', desde, id);
    const dur = new Date(appt.ends_at).getTime() - new Date(appt.starts_at).getTime();
    const moved = { ...appt, starts_at: startsAt.toISOString(), ends_at: new Date(startsAt.getTime() + dur).toISOString() };
    if (moved.starts_at === appt.starts_at) return go('warn', 'La cita ya estaba a esa hora.', desde, id);
    // Horario de atención y días bloqueados: Betsy puede saltárselos a sabiendas marcando la casilla.
    if (fd.get('fuera') !== 'on') {
      const [horarios, bloqueos] = await Promise.all([getHours(), getBlockedDates(date)]);
      const problema = fueraDeHorario({ fecha: date, hora: time, duracionMin: Math.round(dur / 60_000), horarios, bloqueos });
      // El formulario vuelve abierto con la fecha y la hora que escribió: solo tiene que marcar la casilla.
      if (problema) return go('error', `${problema}. Si de verdad quieres moverla ahí, marca «Moverla aunque esté fuera de mi horario» y guarda de nuevo.`, desde, id, `mvd=${date}&mvt=${time}&`);
    }
    const { recordatorio: _r, reagendada: _g, ...notified } = appt.notified ?? {};
    try {
      await updateAppointment(id, {
        starts_at: moved.starts_at,
        ends_at: moved.ends_at,
        rescheduled_at: new Date().toISOString(),
        client_confirmed_at: null,
        change_requested_at: null,
        notified,
      });
    } catch (e) {
      if (e instanceof SlotTakenError) return go('error', 'Ya tienes otra cita a esa hora. Elige otra.', desde, id);
      console.error(e);
      return go('error', 'No se pudo cambiar la hora. Intenta de nuevo.', desde, id);
    }
    // Google Calendar: se mueve el mismo evento (el horario anterior queda libre). Si la cita está en
    // firme pero no quedó anotada (Google falló antes), se anota ahora en la hora nueva.
    let gcalFail = false;
    try {
      if (appt.google_event_id) await moveCalendarEvent(appt.google_event_id, moved);
      else if (appt.status === 'confirmada') {
        const eventId = await createCalendarEvent(moved, await getSettings());
        if (eventId) await updateAppointment(id, { google_event_id: eventId });
      }
    } catch (e) {
      console.error(e);
      gcalFail = true;
    }
    let wa: SendResult | null = null;
    if (notify && waOn) wa = await sendNoticeSafe({ ...moved, notified }, 'reagendada');
    // Mensaje listo para que Betsy le avise a la clienta desde su WhatsApp con un toque.
    const [ajustes, plantillas, servicios] = await Promise.all([getSettings(), getTemplates(), getServices()]);
    const { price, deposit } = valorDeCita(moved, servicios.find((x) => x.id === moved.service_id));
    const aviso = waUrl(moved.customer_phone, fillTemplate(plantillas.reagendada ?? DEFAULT_TEMPLATES.reagendada, { a: moved, s: ajustes, price, deposit }));
    const msg = `Cita de ${who} movida al ${prettyDate(moved.starts_at).toLowerCase()} a las ${prettyTimeRaw(moved.starts_at).replace(/\.$/, '')}.${gcalFail ? ' No se pudo mover en tu Google Calendar: cámbiala a mano allá.' : ''}${waSay(wa, who)}${!json && notify && !waOn ? ' Avísale con el botón de WhatsApp.' : ''}`;
    return go(gcalFail || (wa && !wa.ok) ? 'warn' : 'ok', msg, mondayOf(date), id, '', { wa: aviso, who, notice: `${id}:reagendada` });
  }

  if (action === 'create') {
    const parsed = bookingSchema.safeParse({
      service_id: str(fd, 'service_id', 40),
      date: str(fd, 'date', 10),
      time: str(fd, 'time', 5),
      name: str(fd, 'name', 80),
      phone: str(fd, 'phone', 20),
      email: str(fd, 'email', 120),
      notes: str(fd, 'notes', 500),
      hair_length: str(fd, 'hair_length', 10),
      home_service: fd.get('home_service') === 'on',
      home_address: str(fd, 'home_address', 200),
      wa_opt_in: fd.get('wa_opt_in') === 'on',
    });
    if (!parsed.success) {
      // Los mensajes del esquema le hablan a la clienta de la web; aquí se le habla a Betsy.
      const field = String(parsed.error.issues[0]?.path[0] ?? '');
      const msgs: Record<string, string> = {
        name: 'Escribe el nombre de la clienta',
        phone: 'El WhatsApp de la clienta debe ser un celular de 10 dígitos que empiece por 3 (los fijos no reciben WhatsApp). Si es de otro país, escríbelo con + y el indicativo.',
        email: 'Ese correo no parece válido. Si no lo tienes, déjalo vacío.',
        date: 'Elige la fecha y la hora de la cita',
        time: 'Elige la fecha y la hora de la cita',
        service_id: 'Elige un servicio',
        home_address: 'Escribe la dirección del domicilio',
      };
      return go('error', msgs[field] ?? 'Revisa los datos de la cita.');
    }
    try {
      const appt = await book(parsed.data, 'admin');
      const who = firstName(parsed.data.name);
      const week = mondayOf(parsed.data.date);
      // El aviso solo menciona Google si de verdad quedó anotada allá.
      if (appt.google_event_id) return go('ok', `Cita de ${who} guardada y anotada en tu Google Calendar`, week);
      if (await getGoogleConnection()) return go('warn', `Cita de ${who} guardada, pero no se pudo anotar en tu Google Calendar. Agrégala a mano allá.`, week);
      return go('ok', `Cita de ${who} guardada`, week);
    } catch (e) {
      if (e instanceof BookingError) return go('error', e.status === 409 ? 'Ya tienes una cita a esa hora. Elige otra hora.' : e.message);
      return go('error', 'No se pudo guardar la cita. Intenta de nuevo.');
    }
  }
  return go('error', OOPS);
}

// ───────── Datos de la semana ─────────
const now = new Date();
const today = localDate(now);
const tomorrow = addDays(today, 1);
const qDesde = Astro.url.searchParams.get('desde');
const start = mondayOf(isDate(qDesde) ? qDesde : today);
const end = addDays(start, 7);
const weekDays = Array.from({ length: 7 }, (_, i) => addDays(start, i));
const thisWeek = weekDays.includes(today);

const [appts, services, hours, blocked, upcoming, todayAll, google, settings, templates, upcomingAll] = await Promise.all([
  getAppointments({ from: fromLocal(start, '00:00'), to: fromLocal(end, '00:00') }),
  getServices(false),
  getHours(),
  getBlockedDates(start < today ? start : today),
  getAppointments({ from: now, to: new Date(now.getTime() + 90 * 864e5), activeOnly: true }),
  getAppointments({ from: fromLocal(today, '00:00'), to: fromLocal(tomorrow, '00:00') }),
  getGoogleConnection(),
  getSettings(),
  getTemplates(),
  // Incluye canceladas: para avisar de los cupos que el sistema liberó por falta de abono.
  getAppointments({ from: now, to: new Date(now.getTime() + 90 * 864e5) }),
]);

const isActive = (a: Appointment) => a.status === 'confirmada' || a.status === 'pendiente';
const started = (a: Appointment) => new Date(a.starts_at) <= now;
const byDay = new Map<string, Appointment[]>(weekDays.map((d) => [d, []]));
for (const a of appts) byDay.get(localDate(new Date(a.starts_at)))?.push(a);
const todayList = todayAll.filter((a) => a.status !== 'cancelada' && localDate(new Date(a.starts_at)) === today);

const blockedMap = new Map(blocked.map((b) => [b.day, b.reason || 'Día bloqueado']));
const hourOf = (d: string) => hours.find((h) => h.weekday === weekdayOf(d));
const offOf = (d: string) => blockedMap.get(d) ?? (!hourOf(d)?.enabled ? 'Cerrado' : null);

// Rango visible del calendario: horario de atención + citas fuera de él.
const enabled = hours.filter((h) => h.enabled);
let minM = enabled.length ? Math.min(...enabled.map((h) => minutesOf(h.open_time))) : 8 * 60;
let maxM = enabled.length ? Math.max(...enabled.map((h) => minutesOf(h.close_time))) : 18 * 60;
for (const a of appts.filter((x) => x.status !== 'cancelada')) {
  minM = Math.min(minM, minutesOf(localTime(new Date(a.starts_at))));
  const e = localTime(new Date(a.ends_at));
  maxM = Math.max(maxM, e === '00:00' ? 24 * 60 : minutesOf(e));
}
const dayStart = Math.floor(minM / 60) * 60;
const dayEnd = Math.min(24 * 60, Math.ceil(maxM / 60) * 60);
const hourMarks = Array.from({ length: (dayEnd - dayStart) / 60 }, (_, i) => dayStart + i * 60);
const offsetOf = (iso: string) => minutesOf(localTime(new Date(iso))) - dayStart;
const durOf = (a: Appointment) => Math.max(20, (new Date(a.ends_at).getTime() - new Date(a.starts_at).getTime()) / 60000);

// Indicadores (cifras reales de la semana mostrada)
const svcOf = new Map(services.map((x) => [x.id, x]));
const valorOf = (a: Appointment) => valorDeCita(a, svcOf.get(a.service_id ?? ''));
const weekActive = appts.filter(isActive);
const income = appts.filter((a) => a.status !== 'cancelada').reduce((t, a) => t + (valorOf(a).price ?? 0), 0);
const next = upcoming.find((a) => new Date(a.starts_at) > now);
const emptyWeek = weekActive.length === 0 && income === 0;
const present = new Set(appts.filter((a) => a.status !== 'cancelada').map((a) => a.status));

// Formatos
const statusLabel: Record<AppointmentStatus, string> = { confirmada: 'Confirmada', pendiente: 'Esperando abono', completada: 'Realizada', cancelada: 'Cancelada' };
const fmtDayShort = new Intl.DateTimeFormat('es-CO', { weekday: 'short', timeZone: 'UTC' });
const fmtDayLong = new Intl.DateTimeFormat('es-CO', { weekday: 'long', timeZone: 'UTC' });
const fmtMonth = new Intl.DateTimeFormat('es-CO', { month: 'long', timeZone: 'UTC' });
const fmtNum = (d: string) => Number(d.slice(8, 10));
const atNoon = (d: string) => new Date(`${d}T12:00:00Z`);
const dayShort = (d: string) => fmtDayShort.format(atNoon(d)).replace('.', '');
const monthOf = (d: string) => fmtMonth.format(atNoon(d));
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const last = weekDays[6];
const sameMonth = monthOf(start) === monthOf(last);
const weekTitle = sameMonth ? `${fmtNum(start)} – ${fmtNum(last)} de ${monthOf(start)}` : `${fmtNum(start)} de ${monthOf(start)} – ${fmtNum(last)} de ${monthOf(last)}`;
const weekSpoken = sameMonth ? `${fmtNum(start)} al ${fmtNum(last)} de ${monthOf(start)}` : `${fmtNum(start)} de ${monthOf(start)} al ${fmtNum(last)} de ${monthOf(last)}`;
const todayLabel = `${cap(fmtDayLong.format(atNoon(today)))} ${fmtNum(today)}`;
const hourLabel = (m: number) => {
  const h = Math.floor(m / 60);
  return `${h % 12 || 12} ${h < 12 ? 'a. m.' : 'p. m.'}`;
};
const relDay = (iso: string) => {
  const d = localDate(new Date(iso));
  if (d === today) return 'Hoy';
  if (d === tomorrow) return 'Mañana';
  return prettyDate(iso);
};
const shortWhen = (iso: string) => {
  const d = localDate(new Date(iso));
  const day = d === today ? 'hoy' : d === tomorrow ? 'mañana' : `${dayShort(d)} ${fmtNum(d)}`;
  return `${day}, ${prettyTime(iso)}`;
};

// WhatsApp: el mensaje depende del estado (plantillas editables en Mensajes).
type WaKind = NoticeEvent | 'hello';
/** Abono confirmado y la clienta aún no sabe: se le ofrece el aviso. */
const owesNotice = (a: Appointment) => a.status === 'confirmada' && Boolean(a.deposit_confirmed_at) && !a.notified?.abono && !started(a);
const owesRejectNotice = (a: Appointment) => debeAvisarRechazo(a, now);
/** El sistema liberó el cupo por falta de abono y la clienta aún no lo sabe. */
const owesReleaseNotice = (a: Appointment) => cupoLiberado(a) && !a.notified?.cupo_liberado && !started(a);
/** Comprobantes por revisar entre las citas próximas: el plazo no corre mientras esperan a Betsy. */
const toReview = upcoming.filter((a) => a.status === 'pendiente' && a.receipt_path);
/** Cupos liberados por falta de abono a los que aún no se les avisó (las canceladas no salen en la agenda). */
const toNotifyReleased = upcomingAll.filter(owesReleaseNotice);
const waKind = (a: Appointment): WaKind =>
  a.status === 'completada'
    ? 'gracias'
    : a.status === 'cancelada'
      ? cupoLiberado(a)
        ? 'cupo_liberado'
        : 'cancelada'
      : started(a)
        ? 'hello'
        : owesRejectNotice(a)
          ? 'comprobante_rechazado'
          : a.status === 'pendiente'
            ? a.rescheduled_at && !a.notified?.reagendada
              ? 'reagendada'
              : 'apartada'
            : owesNotice(a)
              ? 'abono'
              : a.rescheduled_at && !a.notified?.reagendada
                ? 'reagendada'
                : 'recordatorio';
const waText = (a: Appointment, kind: WaKind = waKind(a)) => {
  if (kind === 'hello') return `Hola ${firstName(a.customer_name)} 👋 Te escribe ${settings.business_name}.`;
  const { price, deposit } = valorOf(a);
  return fillTemplate(templates[kind] ?? DEFAULT_TEMPLATES[kind], { a, s: settings, price, deposit });
};
const waLink = (a: Appointment, kind: WaKind = waKind(a)) => waUrl(a.customer_phone, waText(a, kind));
const waLabel = (a: Appointment) =>
  ({
    recordatorio: 'Pedir confirmación',
    reagendada: 'Avisar nueva hora',
    apartada: 'Pedir abono',
    comprobante_rechazado: 'Avisar: comprobante rechazado',
    abono: 'Avisar: cita confirmada',
    gracias: 'Agradecer por WhatsApp',
    cancelada: 'Avisar cancelación',
    cupo_liberado: 'Avisar: cupo liberado',
    hello: 'Escribir por WhatsApp',
  })[
    waKind(a)
  ];

const initials = (n: string) =>
  n
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]!.toUpperCase())
    .join('');
const prettyPhone = (p: string) => {
  const m = p.match(/^57(3\d{2})(\d{3})(\d{4})$/);
  return m ? `+57 ${m[1]} ${m[2]} ${m[3]}` : `+${p}`;
};
const durLabel = (a: Appointment) => {
  const m = Math.round(durOf(a));
  const h = Math.floor(m / 60);
  const r = m % 60;
  return h ? `${h} h${r ? ` ${r} min` : ''}` : `${r} min`;
};
const cancelMsg = (a: Appointment) => {
  const who = firstName(a.customer_name);
  if (a.google_event_id && a.customer_email) return `¿Cancelar la cita de ${who}? El horario queda libre, se borra de tu Google Calendar y Google le avisa por correo.`;
  if (a.google_event_id) return `¿Cancelar la cita de ${who}? El horario queda libre y se borra de tu Google Calendar. Recuerda avisarle por WhatsApp.`;
  return `¿Cancelar la cita de ${who}? El horario queda libre. Recuerda avisarle por WhatsApp.`;
};
const selectedDay = thisWeek ? today : start;

// Un diálogo de detalle por cita (semana + hoy + próxima), sin duplicados.
const dialogAppts = [...new Map([...appts, ...todayAll, ...(next ? [next] : [])].map((a) => [a.id, a])).values()];
const isPdf = (p: string | null | undefined) => Boolean(p && /\.pdf$/i.test(p));

// WhatsApp automático (desactivado desde 2026-11-25: sin las variables de Meta queda apagado).
const waOn = waConfigured();
// Aviso del tope mensual de WhatsApp (solo con el WhatsApp conectado y un tope puesto en Mensajes).
const tope = waOn ? await estadoTopeActual(settings).catch(() => null) : null;
// Nueva fecha y hora que Betsy había escrito al mover una cita que quedó fuera de su horario.
const qMv = { id: Astro.url.searchParams.get('abrir') ?? '', d: Astro.url.searchParams.get('mvd') ?? '', t: Astro.url.searchParams.get('mvt') ?? '' };
const mvPendiente = (a: Appointment) => (qMv.id === a.id && isDate(qMv.d) && /^([01]\d|2[0-3]):[0-5]\d$/.test(qMv.t) ? { d: qMv.d, t: qMv.t } : null);
const todayOff = offOf(today);
---

<Admin title="Agenda" greet mobileSub={thisWeek ? undefined : `Semana del ${weekSpoken}`}>
  <button slot="actions" type="button" class="btn btn-clay head-new" data-open-new>
    <Icon name="plus" /> Nueva cita
  </button>

  <!-- Acción rápida en móvil: al alcance del pulgar, encima de la barra inferior -->
  <button type="button" class="btn btn-clay fab" data-open-new data-fab>
    <Icon name="plus" /> Nueva cita
  </button>

  {
    toReview.length > 0 && (
      <section class="review panel" aria-labelledby="review-t">
        <p class="review-t" id="review-t">
          <Icon name="upload" size={16} /> {toReview.length === 1 ? '1 comprobante por revisar' : `${toReview.length} comprobantes por revisar`}
        </p>
        <ul>
          {toReview.map((a) => (
            <li>
              <a href={`/admin?desde=${mondayOf(localDate(new Date(a.starts_at)))}&abrir=${a.id}`}>
                {a.customer_name} · {shortWhen(a.starts_at)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    tope && (tope.nivel === 'aviso' || tope.nivel === 'agotado') && (
      <section class="review panel" aria-labelledby="tope-t">
        <p class="review-t" id="tope-t">
          <Icon name="money" size={16} />{' '}
          {tope.nivel === 'agotado'
            ? `Se alcanzó el tope de WhatsApp del mes (${formatCOP(tope.gastado)} de ${formatCOP(tope.tope)}): ${TEXTO_TOPE_AGOTADO}. Usa «Abrir en mi WhatsApp».`
            : `WhatsApp: ya vas en el ${tope.porcentaje} % del tope del mes (${formatCOP(tope.gastado)} de ${formatCOP(tope.tope)}).`}
        </p>
      </section>
    )
  }

  {
    toNotifyReleased.length > 0 && (
      <section class="review panel" aria-labelledby="released-t">
        <p class="review-t" id="released-t">
          <Icon name="clock" size={16} /> {toNotifyReleased.length === 1 ? '1 cupo liberado por falta de abono' : `${toNotifyReleased.length} cupos liberados por falta de abono`}
        </p>
        <ul>
          {toNotifyReleased.map((a) => (
            <li>
              <a class="btn btn-wa" data-notice={`${a.id}:cupo_liberado`} href={waLink(a)} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Avisar a {a.customer_name} · {shortWhen(a.starts_at)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Hoy (escritorio y tableta) -->
  <section class="hoy panel" aria-labelledby="today-t">
    <div class="t-date">
      <p class="t-eyebrow" id="today-t">Hoy</p>
      <p class="t-day">{todayLabel}</p>
      <p class="muted">{todayList.length === 0 ? 'Sin citas' : todayList.length === 1 ? '1 cita' : `${todayList.length} citas`}</p>
    </div>
    <div class="t-list">
      {
        todayList.length ? (
          <ul>
            {todayList.slice(0, 4).map((a) => (
              <li class:list={['t-row', a.status]}>
                <button type="button" class="t-open" data-open={`ap-${a.id}`}>
                  <span class="t-time">{prettyTime(a.starts_at)}</span>
                  <span class="t-who">
                    <b>{a.customer_name}</b>
                    <span class="muted"> · {a.service_name}</span>
                    {next?.id === a.id && <span class="tag plain t-next">Sigue</span>}
                    {a.status === 'completada' && <span class="tag completada">Realizada</span>}
                  </span>
                </button>
                <a class="btn btn-wa btn-icon" href={waLink(a)} target="_blank" rel="noopener" aria-label={`${waLabel(a)} a ${a.customer_name}`}>
                  <Icon name="whatsapp" />
                </a>
              </li>
            ))}
            {todayList.length > 4 && <li class="t-more muted">+{todayList.length - 4} más en el calendario de abajo</li>}
          </ul>
        ) : (
          <div class="t-empty">
            <p class="t-empty-h">{todayOff ? `Hoy no atiendes · ${todayOff}` : 'Hoy no tienes citas.'}</p>
            {!todayOff && (
              <button type="button" class="btn btn-soft btn-sm" data-open-new data-date={today}>
                <Icon name="plus" /> Agendar para hoy
              </button>
            )}
            {next && (
              <button type="button" class="t-nextline" data-open={`ap-${next.id}`}>
                Próxima: <b>{firstName(next.customer_name)} · {next.service_name}</b> — {shortWhen(next.starts_at)}
              </button>
            )}
          </div>
        )
      }
    </div>
    <div class="t-week">
      {emptyWeek ? (
        <p class="t-none">{thisWeek ? 'Esta semana aún no tiene citas.' : 'Semana sin citas.'}</p>
      ) : (
      <>
      <p>
        <strong>{weekActive.length}</strong>
        <span>{weekActive.length === 1 ? 'cita activa' : 'citas activas'} {thisWeek ? 'esta semana' : 'en la semana mostrada'}</span>
      </p>
      <p>
        <strong>{formatCOP(income)}</strong>
        <span>mínimo estimado de la semana</span>
      </p>
      </>
      )}
      {!thisWeek && <a class="t-back" href="/admin">Volver a esta semana</a>}
    </div>
  </section>

  <!-- Calendario -->
  <section class="cal panel" aria-label="Calendario semanal">
    <div class="cal-top">
      <div class="cal-nav">
        <a class="btn btn-soft btn-sm btn-icon" href={`/admin?desde=${addDays(start, -7)}`} aria-label="Semana anterior"><span class="flip"><Icon name="chevron" /></span></a>
        <a class="btn btn-soft btn-sm" href="/admin" aria-current={thisWeek ? 'true' : undefined}>Hoy</a>
        <a class="btn btn-soft btn-sm btn-icon" href={`/admin?desde=${addDays(start, 7)}`} aria-label="Semana siguiente"><Icon name="chevron" /></a>
      </div>
      <h2 class="cal-title">{cap(weekTitle)}</h2>
      {
        present.size > 0 && (
          <ul class="legend" aria-label="Leyenda">
            {(['confirmada', 'pendiente', 'completada'] as const).filter((s) => present.has(s)).map((s) => (
              <li>
                <i class:list={['lg', s]} /> {statusLabel[s]}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <!-- Tira de días (móvil) -->
    <div class="strip" role="group" aria-label="Elegir día">
      {
        weekDays.map((d) => {
          const n = (byDay.get(d) ?? []).filter((a) => a.status !== 'cancelada').length;
          const off = Boolean(offOf(d));
          return (
            <button type="button" class:list={['chip', { today: d === today, off }]} aria-pressed={d === selectedDay ? 'true' : 'false'} data-day={d}>
              <small>{dayShort(d)}</small>
              <b>{fmtNum(d)}</b>
              <i class="dots" aria-hidden="true">
                {Array.from({ length: Math.min(n, 3) }, () => (
                  <span />
                ))}
              </i>
              <span class="sr-only">
                {d === today ? ', hoy' : ''}, {n ? `${n} ${n === 1 ? 'cita' : 'citas'}` : 'sin citas'}
                {off ? ', no atiendes' : ''}
              </span>
            </button>
          );
        })
      }
    </div>

    <!-- Vista semanal (escritorio) -->
    <div class="week" data-week data-start={dayStart} data-today={today}>
      <div class="w-head">
        <span></span>
        {
          weekDays.map((d) => (
            <div class:list={['w-day', { today: d === today, past: d < today }]}>
              <small>{dayShort(d)}</small>
              <b>{fmtNum(d)}</b>
            </div>
          ))
        }
      </div>
      <div class="w-body">
        <div class="w-axis" aria-hidden="true">{hourMarks.map((m) => <span>{hourLabel(m)}</span>)}</div>
        {
          weekDays.map((d) => {
            const h = hourOf(d);
            const off = offOf(d);
            const list = (byDay.get(d) ?? []).filter((a) => a.status !== 'cancelada');
            return (
              <div class:list={['w-col', { today: d === today, closed: off, past: d < today }]} data-col={d}>
                {h?.enabled && !off && (
                  <div class="open-band" data-s={minutesOf(h.open_time) - dayStart} data-d={minutesOf(h.close_time) - minutesOf(h.open_time)} />
                )}
                {off && <span class="closed-label">{off}</span>}
                {list.map((a) => (
                  <button
                    type="button"
                    class:list={['ev', a.status]}
                    data-open={`ap-${a.id}`}
                    data-s={offsetOf(a.starts_at)}
                    data-d={durOf(a)}
                    title={`${a.customer_name} · ${prettyTime(a.starts_at)} · ${a.service_name}`}
                  >
                    <b>
                      {a.home_service && <Icon name="home" size={12} />}
                      {a.customer_name}
                    </b>
                    <span>
                      {prettyTime(a.starts_at)} · {a.service_name}
                      {a.status === 'pendiente' && (a.receipt_path ? ' · Revisar comprobante' : ' · Espera abono')}
                      {isActive(a) && a.change_requested_at && ' · Pide otra hora'}
                      {isActive(a) && !a.change_requested_at && a.client_confirmed_at && ' · Confirmó ✓'}
                    </span>
                    <span class="sr-only">
                      , {prettyDate(a.starts_at)}, {statusLabel[a.status]}
                    </span>
                  </button>
                ))}
                {d === today && <div class="now" data-now hidden />}
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Vista lista (móvil) -->
    <div class="days">
      {
        weekDays.map((d) => {
          const list = byDay.get(d) ?? [];
          const off = offOf(d);
          return (
            <section class="day" data-daylist={d} hidden={d !== selectedDay}>
              <h3>
                {prettyDate(fromLocal(d, '12:00'))} {d === today && <span class="tag plain">Hoy</span>}
                {blockedMap.has(d) && list.length > 0 && <span class="tag cancelada">Bloqueado</span>}
              </h3>
              {list.length === 0 ? (
                <div class="empty">
                  <p>{off ? `${off} · sin citas` : d < today ? 'Ese día no tuviste citas.' : 'Aún no tienes citas este día.'}</p>
                  {!off && d >= today && (
                    <button type="button" class="btn btn-soft btn-sm" data-open-new data-date={d}>
                      <Icon name="plus" /> Agendar una cita
                    </button>
                  )}
                  {d === today && next && (
                    <button type="button" class="t-nextline" data-open={`ap-${next.id}`}>
                      Próxima: <b>{firstName(next.customer_name)} · {next.service_name}</b> — {shortWhen(next.starts_at)}
                    </button>
                  )}
                </div>
              ) : (
                <ul class="cards">
                  {list.map((a) => (
                    <li class:list={['card', a.status]}>
                      <button type="button" class="card-main" data-open={`ap-${a.id}`}>
                        <span class="c-time">
                          <b>{prettyTime(a.starts_at)}</b>
                          <small>{prettyTime(a.ends_at)}</small>
                        </span>
                        <span class="c-info">
                          <b>{a.customer_name}</b>
                          <small>
                            {a.service_name}
                            {a.home_service && ' · A domicilio'}
                            {a.status !== 'pendiente' && a.status !== 'confirmada' && ` · ${statusLabel[a.status]}`}
                            {a.status === 'confirmada' && <span class="sr-only">, Confirmada</span>}
                          </small>
                          {a.status === 'pendiente' && <span class="tag pendiente">{a.receipt_path ? 'Revisar comprobante' : 'Espera abono'}</span>}
                          {(owesNotice(a) || owesRejectNotice(a) || owesReleaseNotice(a)) && <span class="tag plain">Falta avisarle</span>}
                          {isActive(a) && a.change_requested_at && <span class="tag ask-wa">Pide otra hora</span>}
                          {isActive(a) && !a.change_requested_at && a.client_confirmed_at && <span class="tag ok-wa">Confirmó</span>}
                        </span>
                      </button>
                      {a.status !== 'cancelada' && (
                        <a class="btn btn-wa btn-icon" href={waLink(a)} target="_blank" rel="noopener" aria-label={`${waLabel(a)} a ${a.customer_name}`}>
                          <Icon name="whatsapp" />
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          );
        })
      }
      <p class="week-sum">
        {emptyWeek ? 'Semana sin citas' : `Semana: ${weekActive.length} ${weekActive.length === 1 ? 'cita activa' : 'citas activas'} · ${formatCOP(income)} mínimo estimado`}
      </p>
    </div>
  </section>

  <!-- Detalle de cada cita -->
  {
    dialogAppts.map((a) => {
      const canComplete = isActive(a) && started(a);
      const laterToday = isActive(a) && !started(a) && localDate(new Date(a.starts_at)) === today;
      const who = firstName(a.customer_name);
      return (
        <dialog class:list={['ap', a.status]} id={`ap-${a.id}`} aria-labelledby={`apt-${a.id}`}>
          <header class="ap-top">
            <form method="dialog" class="ap-x">
              <button class="ap-close" aria-label="Cerrar">
                <Icon name="close" size={18} />
              </button>
            </form>
            <div class="ap-who">
              <span class="ap-av" aria-hidden="true">
                {initials(a.customer_name)}
              </span>
              <div>
                <h2 id={`apt-${a.id}`} tabindex="-1" autofocus>
                  {a.customer_name}
                </h2>
                <p class="ap-svc">
                  <Icon name="scissors" size={15} /> {a.service_name}
                </p>
              </div>
            </div>
            <div class="ap-tags">
              <span class={`tag ${a.status}`}>{statusLabel[a.status]}</span>
              {a.google_event_id && (
                <span class="tag plain g">
                  <Icon name="google" size={13} /> En tu Google Calendar
                </span>
              )}
              {a.client_confirmed_at && isActive(a) && (
                <span class="tag ok-wa">
                  <Icon name="check" size={13} /> Confirmó por WhatsApp
                </span>
              )}
              {a.change_requested_at && isActive(a) && (
                <span class="tag ask-wa">
                  <Icon name="clock" size={13} /> Pide cambiar la hora
                </span>
              )}
              <span class="tag plain">{a.source === 'web' ? 'Reservó en la web' : 'La agendaste tú'}</span>
              {a.home_service && (
                <span class="tag plain">
                  <Icon name="home" size={13} /> A domicilio
                </span>
              )}
            </div>
          </header>
          <div class="ap-in">
            <div class="ap-when">
              <div class="ap-day">
                <span>{relDay(a.starts_at) === prettyDate(a.starts_at) ? 'Fecha' : relDay(a.starts_at)}</span>
                <strong>{prettyDate(a.starts_at)}</strong>
              </div>
              <div class="ap-hour">
                <span>Hora</span>
                <strong>
                  {prettyTime(a.starts_at)} – {prettyTime(a.ends_at)}
                </strong>
                <small>{durLabel(a)}</small>
              </div>
            </div>
            <dl class="ap-info">
              <div>
                <dt>
                  <Icon name="phone" size={16} /> Teléfono
                </dt>
                <dd>
                  <a href={`tel:+${a.customer_phone}`} aria-label={`Llamar al ${prettyPhone(a.customer_phone)}`}>
                    {prettyPhone(a.customer_phone)}
                  </a>
                  {!aceptaAvisos(a) && <small class="hint"> · No acepta avisos automáticos por WhatsApp</small>}
                </dd>
              </div>
              {a.customer_email && (
                <div>
                  <dt>
                    <Icon name="mail" size={16} /> Correo
                  </dt>
                  <dd>
                    <a href={`mailto:${a.customer_email}`}>{a.customer_email}</a>
                  </dd>
                </div>
              )}
              {a.hair_length && (
                <div>
                  <dt>
                    <Icon name="scissors" size={16} /> Largo del cabello
                  </dt>
                  <dd>{hairLabel(a.hair_length)}</dd>
                </div>
              )}
              {(() => {
                const r = resumenDeCita(a, svcOf.get(a.service_id ?? ''));
                return (
                  <>
                    <div>
                      <dt>
                        <Icon name="money" size={16} /> {r.price == null || r.exacto ? 'Valor' : 'Valor desde'}
                      </dt>
                      <dd>
                        {r.price == null ? 'Por definir' : formatCOP(r.price)}
                        {r.travel > 0 && <small class="muted"> · incluye desplazamiento {formatCOP(r.travel)}</small>}
                      </dd>
                    </div>
                    {r.abono && (
                      <div>
                        <dt>
                          <Icon name="check" size={16} /> {r.abono === 'pagado' ? 'Abono pagado' : `Abono (${DEPOSIT_PCT}%)`}
                        </dt>
                        <dd>{formatCOP(r.deposit)}</dd>
                      </div>
                    )}
                    {r.saldo != null && (
                      <div>
                        <dt>
                          <Icon name="money" size={16} /> Saldo el día de la cita
                        </dt>
                        <dd>{formatCOP(r.saldo)}</dd>
                      </div>
                    )}
                  </>
                );
              })()}
              {a.home_service && (
                <div>
                  <dt>
                    <Icon name="home" size={16} /> Domicilio
                  </dt>
                  <dd>
                    <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(a.home_address ?? '')}`} target="_blank" rel="noopener">
                      {a.home_address}
                    </a>
                  </dd>
                </div>
              )}
              {a.receipt_path && (
                <div>
                  <dt>
                    <Icon name="upload" size={16} /> Comprobante
                  </dt>
                  <dd>
                    <button
                      type="button"
                      class="link-btn"
                      data-rcpt={`/admin/comprobante?id=${a.id}`}
                      data-pdf={isPdf(a.receipt_path) ? '1' : undefined}
                      data-who={a.customer_name}
                    >
                      Ver comprobante
                    </button>
                  </dd>
                </div>
              )}
              {a.deposit_confirmed_at && (
                <div>
                  <dt>
                    <Icon name="check" size={16} /> Abono
                  </dt>
                  <dd>Recibido el {prettyDate(a.deposit_confirmed_at).toLowerCase()}</dd>
                </div>
              )}
            </dl>
            {a.notes && (
              <blockquote class="ap-notes">
                <span>Nota de la clienta</span>
                {a.notes}
              </blockquote>
            )}
            {a.status === 'pendiente' && (
              <p class="ap-dep">
                <Icon name="clock" size={16} />
                {a.receipt_path
                  ? 'La clienta subió el comprobante. Revísalo y, si el abono llegó, confirma la cita.'
                  : a.receipt_rejected_reason
                    ? `Rechazaste el comprobante («${a.receipt_rejected_reason}»). Esperando uno nuevo.`
                    : `Reserva por confirmar con la clienta por WhatsApp. Cuando recibas el abono del ${DEPOSIT_PCT}%, confírmala aquí.`}
              </p>
            )}
            {a.status === 'pendiente' && a.receipt_path && (
              <details class="ap-valor">
                <summary>Rechazar comprobante</summary>
                <form method="post" class="ap-valor-f" data-confirm={`¿Rechazar el comprobante de ${who}? Se borra y ella tendrá que enviar uno nuevo.`} data-confirm-yes="Sí, rechazar">
                  <input type="hidden" name="action" value="rechazar" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="receipt" value={a.receipt_path} />
                  <input type="hidden" name="desde" value={start} />
                  <div class="field">
                    <label for={`r-${a.id}`}>Motivo (lo verá la clienta)</label>
                    <input id={`r-${a.id}`} name="motivo" maxlength="200" required placeholder="La foto está borrosa · Llegó por menos dinero" />
                  </div>
                  <button class="btn btn-ghost">Rechazar comprobante</button>
                </form>
              </details>
            )}
            {a.change_requested_at && isActive(a) && !started(a) && (
              <p class="ap-dep">
                <Icon name="clock" size={16} /> {who} tocó «Cambiar hora» en WhatsApp. Pregúntale qué hora le sirve y usa «Cambiar hora o reagendar» aquí abajo.
              </p>
            )}
            {owesNotice(a) && (
              <p class="ap-dep ok">
                <Icon name="check" size={16} /> Abono confirmado. Avísale a {who} que su cita quedó en firme: el mensaje ya está escrito.
              </p>
            )}
            {a.status !== 'cancelada' && (
              <details class="ap-valor">
                <summary>{valorOf(a).price == null ? 'Fijar el valor' : 'Ajustar el valor final'}</summary>
                <form method="post" class="ap-valor-f">
                  <input type="hidden" name="action" value="valor" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <div class="field">
                    <label for={`v-${a.id}`}>Valor total (COP)</label>
                    <input id={`v-${a.id}`} name="price" inputmode="numeric" maxlength="12" required value={valorOf(a).price ?? ''} placeholder="95000" />
                  </div>
                  {a.home_service && (
                    <div class="field">
                      <label for={`t-${a.id}`}>Incluye desplazamiento</label>
                      <input id={`t-${a.id}`} name="travel_fee" inputmode="numeric" maxlength="12" value={a.travel_fee ?? ''} placeholder="0" />
                    </div>
                  )}
                  <small class="hint">
                    {a.deposit_confirmed_at
                      ? 'El abono ya está pagado: solo cambia el saldo.'
                      : `El abono se recalcula al ${DEPOSIT_PCT}% del nuevo valor.`}
                  </small>
                  <button class="btn btn-ghost">Guardar valor</button>
                </form>
              </details>
            )}
            <div class="ap-acts">
              {a.status === 'pendiente' && (
                <form method="post" data-confirm={`¿Ya recibiste el comprobante del abono de ${who}? La cita quedará confirmada.`} data-confirm-yes="Sí, confirmar">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <input type="hidden" name="status" value="confirmada" />
                  <button class="btn btn-clay">
                    <Icon name="money" /> Confirmar abono
                  </button>
                </form>
              )}
              {canComplete && a.status !== 'pendiente' && (
                <form method="post" data-confirm={`¿Marcar la cita de ${who} como realizada?`} data-confirm-yes="Sí, marcar">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <input type="hidden" name="status" value="completada" />
                  <button class="btn btn-clay">
                    <Icon name="check" /> Marcar como realizada
                  </button>
                </form>
              )}
              {waOn && waKind(a) !== 'hello' ? (
                <form method="post" class:list={[{ 'btn-wa-main': (!canComplete && a.status !== 'pendiente') || owesNotice(a) }]}>
                  <input type="hidden" name="action" value="notice" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <input type="hidden" name="ev" value={waKind(a)} />
                  <button class="btn btn-wa">
                    <Icon name="whatsapp" /> {waLabel(a)}
                  </button>
                </form>
              ) : (
                <a class:list={['btn', 'btn-wa', { 'btn-wa-main': (!canComplete && a.status !== 'pendiente') || owesNotice(a) }]} data-notice={`${a.id}:${waKind(a)}`} href={waLink(a)} target="_blank" rel="noopener">
                  <Icon name="whatsapp" /> {waLabel(a)}
                </a>
              )}
              {a.status === 'completada' && (
                <form method="post">
                  <input type="hidden" name="action" value="status" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <input type="hidden" name="status" value="confirmada" />
                  <button class="btn btn-soft">Desmarcar realizada</button>
                </form>
              )}
            </div>
            {isActive(a) && (
              <details class="move" open={Boolean(a.change_requested_at) || Boolean(mvPendiente(a))}>
                <summary>
                  <Icon name="calendar" size={16} /> Cambiar hora o reagendar
                  <span class="move-chev" aria-hidden="true"><Icon name="chevron" size={18} /></span>
                </summary>
                <form method="post" class="move-in" data-move-form>
                  <input type="hidden" name="action" value="move" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="desde" value={start} />
                  <div class="field">
                    <label for={`mv-d-${a.id}`}>Nueva fecha</label>
                    <input id={`mv-d-${a.id}`} name="date" type="date" min={today} value={mvPendiente(a)?.d ?? (localDate(new Date(a.starts_at)) < today ? today : localDate(new Date(a.starts_at)))} required />
                  </div>
                  <div class="field">
                    <label for={`mv-t-${a.id}`}>Nueva hora</label>
                    <input id={`mv-t-${a.id}`} name="time" type="time" step="300" value={mvPendiente(a)?.t ?? localTime(new Date(a.starts_at))} required />
                  </div>
                  {waOn && (
                    <label class="field chk move-chk">
                      <input type="checkbox" name="notify" checked /> <span>Avisarle por WhatsApp</span>
                    </label>
                  )}
                  <label class="field chk move-chk">
                    <input type="checkbox" name="fuera" /> <span>Moverla aunque esté fuera de mi horario</span>
                  </label>
                  <button class="btn btn-clay move-go">
                    <Icon name="check" /> Guardar nueva hora
                  </button>
                  <p class="move-err" role="alert" data-move-err hidden></p>
                  <small class="hint move-hint">Dura lo mismo ({durLabel(a)}). Si choca con otra cita o queda fuera de tu horario, te avisamos aquí mismo.</small>
                </form>
                <div class="move-done" data-move-done hidden>
                  <p class="move-done-msg" role="status" data-move-msg></p>
                  <a class="btn btn-wa move-wa" href="#" target="_blank" rel="noopener" data-move-wa>
                    <Icon name="whatsapp" /> Avisarle a {who} por WhatsApp
                  </a>
                  <a class="btn btn-ghost move-next" href="/admin" data-move-next>Listo, ver la agenda</a>
                </div>
              </details>
            )}
            {(laterToday || isActive(a) || (waOn && a.status !== 'cancelada')) && (
              <div class="ap-minor">
                {laterToday && (
                  <form
                    method="post"
                    data-confirm={`La cita de ${who} es hoy a las ${prettyTime(a.starts_at)} ¿Marcarla como realizada de una vez?`}
                    data-confirm-yes="Sí, ya terminé"
                  >
                    <input type="hidden" name="action" value="status" />
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="desde" value={start} />
                    <input type="hidden" name="status" value="completada" />
                    <button class="ap-minor-btn">
                      <Icon name="check" size={16} /> Ya terminé
                    </button>
                  </form>
                )}
                {waOn && a.status !== 'cancelada' && (
                  <a class="ap-minor-btn" href={waLink(a)} target="_blank" rel="noopener" data-notice={`${a.id}:${waKind(a)}`}>
                    <Icon name="external" size={16} /> Abrir en mi WhatsApp
                  </a>
                )}
                {isActive(a) && (
                  <form method="post" data-confirm={cancelMsg(a)} data-confirm-yes="Sí, cancelar cita">
                    <input type="hidden" name="action" value="status" />
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="desde" value={start} />
                    <input type="hidden" name="status" value="cancelada" />
                    <button class="ap-minor-btn danger">
                      <Icon name="ban" size={16} /> Cancelar esta cita
                    </button>
                  </form>
                )}
              </div>
            )}
          </div>
        </dialog>
      );
    })
  }

  {Astro.url.searchParams.get('abrir') && <span hidden data-abrir={Astro.url.searchParams.get('abrir')} />}

  <!-- Comprobante del abono -->
  <dialog class="rcpt" id="rcpt" aria-labelledby="rcpt-t">
    <header class="rcpt-h">
      <h2 id="rcpt-t">Comprobante</h2>
      <form method="dialog">
        <button class="ap-close" aria-label="Cerrar"><Icon name="close" size={18} /></button>
      </form>
    </header>
    <div class="rcpt-body">
      <img data-rcpt-img alt="Comprobante de transferencia" hidden />
      <iframe data-rcpt-pdf title="Comprobante en PDF" hidden></iframe>
      <p class="muted rcpt-msg" data-rcpt-loading role="status">Cargando…</p>
      <p class="rcpt-actions">
        <button type="button" class="btn btn-soft btn-sm" data-rcpt-retry hidden>Intentar de nuevo</button>
        <a class="btn btn-soft btn-sm" data-rcpt-link target="_blank" rel="noopener"><Icon name="external" size={16} /> Abrir en otra pestaña</a>
      </p>
    </div>
  </dialog>

  <!-- Nueva cita -->
  <dialog class="new" id="new-appt" aria-labelledby="new-t">
    <form method="post" class="new-in" data-draft="new">
      <span class="sheet-grip" aria-hidden="true"></span>
      <div class="ap-head">
        <h2 id="new-t">Nueva cita</h2>
        <button type="button" class="btn btn-soft btn-sm btn-icon ap-x" aria-label="Cerrar" data-close><Icon name="close" /></button>
      </div>
      <p class="muted new-intro">
        {
          google
            ? 'Para citas que te llegan por WhatsApp, llamada o en persona. El horario queda ocupado en la web y la cita se anota en tu Google Calendar.'
            : 'Para citas que te llegan por WhatsApp, llamada o en persona. El horario queda ocupado en la web.'
        }
      </p>
      <p class="new-err" role="alert" hidden data-new-err></p>
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="desde" value={start} />
      <div class="grid-2">
        <div class="field full">
          <label for="m-service">Servicio</label>
          <select id="m-service" name="service_id" required>
            {
              services.map((s) => (
                <option value={s.id} data-dur={s.duration_min}>
                  {s.name}
                  {!s.active && ' (oculto en la web)'}
                </option>
              ))
            }
          </select>
        </div>
        <div class="field">
          <label for="m-date">Fecha</label>
          <input id="m-date" name="date" type="date" min={today} value={today} required />
        </div>
        <div class="field">
          <label for="m-time">Hora</label>
          <input id="m-time" name="time" type="time" step="300" required aria-describedby="m-end" />
          <small class="hint" id="m-end" data-end></small>
        </div>
        <div class="field">
          <label for="m-name">Nombre de la clienta</label>
          <input id="m-name" name="name" maxlength="80" minlength="2" autocomplete="off" required />
        </div>
        <div class="field">
          <label for="m-phone">WhatsApp de la clienta</label>
          <input id="m-phone" name="phone" type="tel" inputmode="tel" maxlength="20" placeholder="300 123 4567" autocomplete="off" required />
        </div>
        <label class="field chk full">
          <input type="checkbox" name="wa_opt_in" checked /> <span>La clienta acepta avisos por WhatsApp</span>
        </label>
        <details class="more full" data-more>
          <summary>Más datos (opcional)</summary>
          <div class="grid-2">
            <div class="field full">
              <label for="m-email">Correo</label>
              <input id="m-email" name="email" type="email" maxlength="120" />
            </div>
            <div class="field">
              <label for="m-hair">Largo del cabello</label>
              <select id="m-hair" name="hair_length">
                <option value="">Sin especificar</option>
                {HAIR_LENGTHS.map((h) => <option value={h.id}>{h.label}</option>)}
              </select>
            </div>
            <label class="field chk">
              <input type="checkbox" name="home_service" data-home-toggle /> <span>Servicio a domicilio</span>
            </label>
            <div class="field full" data-home-field hidden>
              <label for="m-address">Dirección del domicilio</label>
              <input id="m-address" name="home_address" maxlength="200" placeholder="Barrio, calle y número" autocomplete="off" />
            </div>
            <div class="field full">
              <label for="m-notes">Notas</label>
              <textarea id="m-notes" name="notes" maxlength="500" placeholder="Ocasión, largo del cabello, si es a domicilio…"></textarea>
            </div>
          </div>
        </details>
      </div>
      <div class="new-acts">
        <button type="button" class="btn btn-ghost" data-close data-discard>Cerrar<span class="x-long"> sin guardar</span></button>
        <button class="btn btn-clay"><Icon name="check" /> Guardar cita</button>
      </div>
    </form>
  </dialog>
</Admin>

<style>
  .chk {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    align-self: end;
    padding-bottom: 0.6rem;
    font-weight: 600;
  }
  .chk input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--clay);
  }
  .ap-dep {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 1.25rem 0 1.5rem;
    padding: 0.9rem 1.05rem;
    border-radius: 14px;
    border: 1px solid #ecd9a8;
    background: #f7ecd0;
    color: #6b4d0c;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .link-btn {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .rcpt {
    width: min(92vw, 520px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: var(--cream, #fbf6ef);
    box-shadow: 0 30px 80px -20px rgb(42 28 22 / 0.5);
  }
  .rcpt::backdrop {
    background: rgb(42 28 22 / 0.55);
    backdrop-filter: blur(3px);
  }
  .rcpt-h {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.6rem 1.3rem;
  }
  .rcpt-h h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .rcpt-h form {
    margin: 0;
  }
  .rcpt-body {
    display: grid;
    place-items: center;
    min-height: 200px;
    padding: 0 1rem 1rem;
  }
  .rcpt-body img {
    display: block;
    max-width: 100%;
    max-height: calc(92vh - 90px);
    object-fit: contain;
    border-radius: 14px;
    background: #fff;
  }
  .rcpt-body [hidden] {
    display: none;
  }
  .rcpt.is-pdf {
    width: min(94vw, 760px);
  }
  .rcpt-body iframe {
    display: block;
    width: 100%;
    height: calc(92vh - 150px);
    min-height: 320px;
    border: 0;
    border-radius: 14px;
    background: #fff;
  }
  .rcpt-msg {
    margin: 0;
  }
  .rcpt-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.8rem 0 0;
  }
  .review {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    border-left: 4px solid var(--clay);
  }
  .review-t {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-weight: 700;
  }
  .review ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .review a:not(.btn) {
    display: inline-block;
    padding-block: 0.6rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ap-valor {
    margin-top: 0.75rem;
  }
  .ap-valor summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 600;
    color: var(--accent-text);
  }
  .ap-valor-f {
    display: grid;
    gap: 0.6rem;
    padding-top: 0.25rem;
  }
  .ap-valor-f .btn {
    justify-self: start;
  }
  .ap-dep.ok {
    background: #e6eadb;
    color: #3f5a2a;
  }
  .ap-dep :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }
  /* Estados (color de la barra/fondo de cada cita) */
  .confirmada {
    --ev: var(--sage);
    --ev-bg: #e6eadb;
  }
  .pendiente {
    --ev: #a87a14;
    --ev-bg: #f7ecd0;
  }
  .completada {
    --ev: #8a7b70;
    --ev-bg: #efe9e2;
  }
  .cancelada {
    --ev: #c4533c;
    --ev-bg: #f8e1dc;
  }

  /* Botón de nueva cita: en escritorio arriba; en móvil flotante */
  .fab {
    display: none !important;
  }

  /* ───────── Hoy ───────── */
  .hoy {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--s-5);
    padding: var(--s-5);
    align-items: start;
  }
  .t-eyebrow {
    margin: 0;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .t-day {
    margin: var(--s-1) 0 var(--s-1);
    font: italic 450 var(--t-xl) / 1.1 var(--font-display);
  }
  .t-date .muted {
    margin: 0;
  }
  .t-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .t-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0 var(--s-2) var(--s-3);
    border-top: 1px dashed var(--line);
    border-left: 3px solid var(--ev);
  }
  .t-row:first-child {
    border-top: 0;
  }
  .t-open {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: baseline;
    gap: var(--s-3);
    min-height: 44px;
    padding: var(--s-1) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .t-open:hover b {
    color: var(--accent-text);
  }
  .t-time {
    font: 600 var(--t-md) var(--font-body);
    font-variant-numeric: tabular-nums;
  }
  .t-who .tag {
    margin-left: var(--s-2);
    vertical-align: 1px;
  }
  .t-more {
    padding: var(--s-2) 0 0 var(--s-3);
  }
  .t-empty {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
  }
  .t-empty-h {
    margin: 0;
    font: italic 450 var(--t-lg) / 1.2 var(--font-display);
    color: var(--muted);
  }
  .t-nextline {
    padding: var(--s-2) 0;
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--cocoa-2);
    font: 500 var(--t-sm) var(--font-body);
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--clay) 45%, transparent);
    text-underline-offset: 3px;
  }
  .t-week {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .t-week p {
    display: grid;
    gap: 2px;
    margin: 0;
  }
  .t-week strong {
    font: 450 var(--t-xl) / 1 var(--font-display);
  }
  .t-week span {
    font-size: var(--t-xs);
    color: var(--muted);
    font-weight: 600;
  }
  .t-none {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--muted);
    font-weight: 600;
  }
  .t-back {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--accent-text);
  }

  /* ───────── Calendario ───────── */
  .cal {
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }
  .cal-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }
  .cal-nav {
    display: flex;
    gap: 0.35rem;
  }
  .cal-nav [aria-current] {
    --b-bg: var(--cocoa);
    --b-fg: var(--white);
  }
  .flip {
    display: inline-flex;
    transform: rotate(180deg);
  }
  .cal-title {
    margin: 0 !important;
    font-size: var(--t-lg) !important;
  }
  .legend {
    display: flex;
    gap: 1rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lg {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: var(--ev);
  }
  .lg.pendiente {
    background: none;
    border: 2px dashed var(--ev);
  }

  /* Semana: rango completo, sin scroll interno (nada queda cortado) */
  .week {
    --ppm: 0.9px;
    --axis: 58px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: clip;
    background: var(--white);
  }
  .w-head,
  .w-body {
    display: grid;
    grid-template-columns: var(--axis) repeat(7, 1fr);
  }
  .w-head {
    position: sticky;
    top: 0;
    z-index: 4;
    border-bottom: 1px solid var(--line);
    background: var(--cream);
  }
  .w-day {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.5rem 0 0.6rem;
    border-left: 1px solid var(--line);
  }
  .w-day small {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .w-day b {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .w-day.today small {
    color: var(--accent-text);
  }
  .w-day.today b {
    background: var(--clay-deep);
    color: var(--white);
  }
  .w-body {
    position: relative;
  }
  .w-axis {
    display: grid;
    grid-auto-rows: calc(60 * var(--ppm));
  }
  .w-axis span {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--muted);
    text-align: right;
    padding-right: 0.5rem;
    transform: translateY(-0.45em);
  }
  .w-axis span:first-child {
    transform: none;
  }
  .w-col {
    position: relative;
    border-left: 1px solid var(--line);
    min-height: calc(var(--hours, 11) * 60 * var(--ppm));
    background-color: #f6f0e8;
    background-image: linear-gradient(var(--line) 1px, transparent 1px);
    background-size: 100% calc(60 * var(--ppm));
    cursor: pointer;
  }
  .w-col.closed,
  .w-col.past {
    cursor: default;
  }
  .w-col.closed {
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      repeating-linear-gradient(-45deg, transparent 0 8px, rgb(42 28 22 / 0.035) 8px 16px);
    background-size: 100% calc(60 * var(--ppm)), auto;
  }
  .open-band {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--s, 0) * var(--ppm));
    height: calc(var(--d, 0) * var(--ppm));
    background: var(--white);
    background-image: linear-gradient(var(--line) 1px, transparent 1px);
    background-size: 100% calc(60 * var(--ppm));
    background-position: 0 calc(var(--s, 0) * var(--ppm) * -1);
  }
  /* Días que ya pasaron: rayado suave, se distinguen de los que vienen */
  .w-col.past {
    background-color: #efe7dc;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      repeating-linear-gradient(-45deg, transparent 0 7px, rgb(42 28 22 / 0.05) 7px 14px);
    background-size: 100% calc(60 * var(--ppm)), auto;
  }
  .w-col.past .open-band {
    background-color: #f6efe6;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      repeating-linear-gradient(-45deg, transparent 0 7px, rgb(42 28 22 / 0.04) 7px 14px);
    background-size: 100% calc(60 * var(--ppm)), auto;
  }
  .w-day.past b,
  .w-day.past small {
    color: var(--muted);
  }
  .w-col.today .open-band {
    background-color: #fffdf9;
  }
  .closed-label {
    position: sticky;
    top: 0.75rem;
    display: block;
    margin: 0.75rem auto 0;
    width: max-content;
    max-width: 90%;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--cream-2);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--muted);
    text-align: center;
  }
  .ev {
    position: absolute;
    left: 4px;
    right: 4px;
    top: calc(var(--s, 0) * var(--ppm) + 1px);
    height: calc(var(--d, 60) * var(--ppm) - 2px);
    display: grid;
    align-content: start;
    gap: 0;
    padding: 4px 6px;
    overflow: hidden;
    border: 0;
    border-left: 3px solid var(--ev);
    border-radius: var(--r-xs);
    background: var(--ev-bg);
    color: var(--cocoa);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
    animation: ev-in 0.5s var(--ease) backwards;
  }
  .ev.pendiente {
    border-left-style: dashed;
  }
  .ev:hover,
  .ev:focus-visible {
    z-index: 2;
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 12px 24px -12px rgb(42 28 22 / 0.45);
  }
  .ev b {
    font-size: var(--t-sm);
    font-weight: 700;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ev span {
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--cocoa-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ev.short span:not(.sr-only) {
    display: none;
  }
  /* En citas altas el nombre puede ocupar dos líneas (columnas angostas a 1024 px) */
  .ev.tall b {
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow-wrap: anywhere;
  }
  .ev.completada b {
    text-decoration: line-through;
    text-decoration-color: rgb(42 28 22 / 0.35);
  }
  @keyframes ev-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  .now {
    position: absolute;
    z-index: 3;
    left: -1px;
    right: 0;
    top: calc(var(--s, 0) * var(--ppm));
    height: 2px;
    background: var(--clay);
    pointer-events: none;
  }
  .now::before {
    content: '';
    position: absolute;
    left: -5px;
    top: -4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--clay);
    box-shadow: 0 0 0 4px rgb(184 96 63 / 0.2);
  }

  /* ───────── Tira de días + lista (móvil) ───────── */
  .strip,
  .days {
    display: none;
  }
  .chip {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    min-height: 64px;
    padding: 0.45rem 0;
    border: 1.5px solid transparent;
    border-radius: var(--r-md);
    background: var(--white);
    color: var(--cocoa);
    font: inherit;
    cursor: pointer;
    transition: background 0.25s, transform 0.3s var(--ease), border-color 0.25s;
  }
  .chip small {
    font-size: var(--t-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .chip b {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .chip.today {
    border-color: var(--clay);
  }
  .chip.today small {
    color: var(--accent-text);
  }
  .chip.off {
    background: transparent;
    border: 1.5px dashed var(--field-line);
  }
  .chip.off.today {
    border-color: var(--clay);
  }
  .chip.off b {
    color: var(--muted);
  }
  .chip[aria-pressed='true'] {
    background: var(--cocoa);
    border-style: solid;
    border-color: var(--cocoa);
    color: var(--white);
  }
  .chip[aria-pressed='true'] b {
    color: var(--white);
  }
  .chip[aria-pressed='true'] small {
    color: var(--blush);
  }
  .dots {
    display: flex;
    gap: 3px;
    height: 5px;
  }
  .dots span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--clay);
  }
  .chip[aria-pressed='true'] .dots span {
    background: var(--blush);
  }
  .day h3 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--s-4) 0 var(--s-3);
    font-size: var(--t-lg);
  }
  .day:not([hidden]) {
    animation: a-rise 0.4s var(--ease) backwards;
  }
  .empty {
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-4);
    border: 1.5px dashed var(--field-line);
    border-radius: var(--r-md);
    color: var(--muted);
    text-align: center;
  }
  .empty p {
    margin: 0;
    font: italic 450 var(--t-lg) / 1.25 var(--font-display);
  }
  .empty .t-nextline {
    text-align: center;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .card {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1);
    border-radius: var(--r-md);
    background: var(--ev-bg);
    border-left: 4px solid var(--ev);
  }
  .card.pendiente {
    border-left-style: dashed;
  }
  .card.cancelada .c-info b,
  .card.cancelada .c-time b {
    text-decoration: line-through;
    text-decoration-color: rgb(42 28 22 / 0.45);
  }
  .card-main {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .c-time,
  .c-info {
    display: grid;
    min-width: 0;
  }
  .c-time {
    flex: none;
    width: 6.6rem;
    white-space: nowrap;
    padding-right: var(--s-3);
    border-right: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .c-info .tag {
    justify-self: start;
    margin-top: var(--s-1);
  }
  .c-time small,
  .c-info small {
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .c-info {
    flex: 1;
  }
  .c-info b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card .btn-icon {
    flex: none;
  }
  .week-sum {
    margin: var(--s-4) 0 0;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .hoy {
      grid-template-columns: 180px 1fr;
    }
  }
  @media (max-width: 860px) {
    .head-new {
      display: none !important;
    }
    .fab {
      display: inline-flex !important;
      position: fixed !important;
      right: var(--s-4);
      bottom: calc(var(--tab-h) + var(--s-3) + env(safe-area-inset-bottom));
      z-index: 41;
      min-height: 52px !important;
      padding: 0 20px !important;
      border-radius: 999px;
      box-shadow: 0 14px 28px -12px rgb(143 68 41 / 0.7);
      animation: none !important;
    }
  }
  @media (max-width: 760px) {
    .hoy,
    .week,
    .legend {
      display: none;
    }
    .cal.panel {
      background: none;
      border: 0;
      box-shadow: none;
      padding: 0;
      margin-bottom: 0;
    }
    .cal-top {
      flex-wrap: nowrap;
      justify-content: space-between;
      margin-bottom: var(--s-2);
    }
    .cal-title {
      order: -1;
      font: 600 var(--t-sm) var(--font-body) !important;
      color: var(--muted);
    }
    .strip {
      position: sticky;
      top: 0;
      z-index: 5;
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: var(--s-1);
      margin-inline: calc(var(--s-4) * -1);
      padding: var(--s-2) var(--s-4);
      background: var(--a-bg);
    }
    .days {
      display: block;
    }
  }

  /* ───────── Diálogos ───────── */
  dialog.ap {
    width: min(540px, calc(100% - 1.5rem));
  }
  .ap-top {
    position: relative;
    padding: 1.5rem 1.6rem 1.2rem;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--ev) 26%, transparent), transparent 60%),
      var(--ev-bg);
    border-bottom: 1px solid color-mix(in oklab, var(--ev) 25%, transparent);
  }
  .ap-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ap-head h2 {
    margin: 0 !important;
  }
  .new .ap-x {
    margin-left: auto;
  }
  .ap-top .ap-x {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }
  .ap-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.65);
    color: var(--cocoa);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s var(--ease);
  }
  .ap-close:hover {
    background: var(--white);
    transform: rotate(90deg);
  }
  .ap-close:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }
  .ap-who {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-right: 2.75rem;
  }
  .ap-av {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ev) 58%, var(--cocoa));
    color: #fff;
    font: 600 1.25rem/1 var(--font-display);
    letter-spacing: 0.02em;
    box-shadow: 0 6px 18px -6px color-mix(in oklab, var(--ev) 70%, transparent);
  }
  .ap h2 {
    margin: 0;
    font-size: clamp(1.4rem, 4.6vw, 1.75rem);
    line-height: 1.1;
    outline: none;
  }
  .ap-svc {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.3rem 0 0;
    color: var(--accent-text);
    font-weight: 700;
    font-size: var(--t-md);
  }
  .ap-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .ap-tags .tag.plain {
    background: rgb(255 255 255 / 0.7);
  }
  .ap-tags .tag.g {
    background: #e8eef9;
    color: #2a4d8f;
  }
  .ap-in,
  .new-in {
    padding: 1.3rem 1.6rem 1.5rem;
  }
  .ap-when {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .ap-when > div {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border-radius: var(--r-md);
    background: var(--cream);
  }
  .ap-when span,
  .ap-info dt,
  .ap-notes span {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ap-when strong {
    font-size: var(--t-md);
    line-height: 1.25;
  }
  .ap-when small {
    color: var(--muted);
    font-size: var(--t-sm);
  }
  .ap-info {
    margin: 1rem 0 0;
    display: grid;
    gap: 0;
  }
  .ap-info > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.35rem 0;
    min-height: 48px;
    border-bottom: 1px dashed var(--line);
  }
  .ap-info dt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
  }
  .ap-info dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .ap-info a {
    display: inline-block;
    padding-block: 0.6rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--clay) 45%, transparent);
    text-underline-offset: 3px;
  }
  .ap-info a:hover {
    color: var(--accent-text);
  }
  .ap-notes {
    display: grid;
    gap: 0.3rem;
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: var(--r-md);
    background: var(--cream);
    border-left: 3px solid var(--ev);
    color: var(--cocoa-2);
  }
  .ap-acts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.55rem;
    margin-top: 1.3rem;
  }
  .ap-acts form,
  .ap-acts .btn,
  .ap-acts button {
    width: 100%;
    justify-content: center;
    white-space: nowrap;
  }
  .ap-acts .btn-wa-main {
    grid-column: 1 / -1;
    min-height: 52px;
    font-size: var(--t-md);
  }
  .ap-acts form.btn-wa-main .btn {
    min-height: 52px;
    font-size: var(--t-md);
  }
  .ap-minor {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
  }
  .ap-minor-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--cocoa-2);
    font: 600 var(--t-sm) var(--font-body);
    cursor: pointer;
    transition: background 0.2s;
  }
  .ap-minor-btn:hover {
    background: var(--cream-2);
  }
  .ap-minor-btn.danger {
    color: #9c2a1a;
  }
  .ap-minor-btn.danger:hover {
    background: #f8e1dc;
  }
  @media (max-width: 480px) {
    .ap-top,
    .ap-in {
      padding-left: 1.2rem;
      padding-right: 1.2rem;
    }
    .ap-av {
      width: 48px;
      height: 48px;
      font-size: 1.05rem;
    }
    .ap-acts {
      grid-template-columns: 1fr;
    }
  }

  /* ───────── WhatsApp: confirmación, reagendar y conversación ───────── */
  .tag.ok-wa {
    background: #dcefdc;
    color: #24572b;
  }
  .tag.ask-wa {
    background: #f7ecd0;
    color: #6b4d0c;
  }
  .ap-tags .tag.ok-wa,
  .ap-tags .tag.ask-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .move {
    margin-top: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--white);
  }
  .move summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0.4rem 1rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  .move summary::-webkit-details-marker {
    display: none;
  }
  .move-chev {
    display: grid;
    margin-left: auto;
    transform: rotate(90deg);
    transition: transform 0.2s var(--ease);
  }
  .move[open] .move-chev {
    transform: rotate(-90deg);
  }
  .move summary:focus-visible {
    outline: 2.5px solid var(--clay);
    outline-offset: 2px;
  }
  .move-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 0.75rem;
    padding: 0 1rem 1rem;
  }
  .move-in .field {
    min-width: 0;
  }
  .move-in input[type='date'],
  .move-in input[type='time'] {
    width: 100%;
    min-width: 0;
  }
  .move-chk,
  .move-go,
  .move-hint {
    grid-column: 1 / -1;
  }
  .move-chk {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding-bottom: 0;
    align-self: auto;
    font-weight: 600;
    cursor: pointer;
  }
  .move-chk input {
    flex: none;
  }
  .move-go {
    justify-content: center;
    width: 100%;
  }
  .move-hint {
    color: var(--muted);
  }
  :global(.ajax-msg) {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border-radius: 10px;
    font-size: var(--t-sm);
    font-weight: 600;
    background: #e6eadb;
    color: #3f5a2a;
  }
  :global(.ajax-top) {
    margin: 1rem 0 1.25rem;
    padding: 0.75rem 0.95rem;
    line-height: 1.45;
  }
  :global(.ajax-msg.err) {
    background: #fdecea;
    color: #8a1c12;
  }
  .move-in[hidden] {
    display: none;
  }
  .move-err {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    background: #fdecea;
    color: #8a1c12;
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .move-done {
    display: grid;
    gap: 0.6rem;
    padding: 0.4rem 1rem 1rem;
  }
  .move-done[hidden] {
    display: none;
  }
  .move-done-msg {
    margin: 0;
    font-weight: 600;
  }
  .move-done .btn {
    justify-content: center;
    width: 100%;
  }
  @media (max-width: 400px) {
    .move-in {
      grid-template-columns: 1fr;
    }
  }

  dialog.new {
    width: min(620px, calc(100% - 1.5rem));
  }
  .new-intro {
    margin: 0.4rem 0 1.2rem;
  }
  .new-err {
    margin: 0 0 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--r-sm);
    background: #f6d9d3;
    color: #7d1f12;
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .more {
    border-top: 1px dashed var(--line);
    padding-top: var(--s-2);
  }
  .more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    min-height: 44px;
    font-weight: 700;
    font-size: var(--t-sm);
    color: var(--cocoa-2);
    cursor: pointer;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary::after {
    content: '';
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg) translateY(-3px);
    transition: transform 0.35s var(--ease);
  }
  .more[open] summary::after {
    transform: rotate(-135deg) translateY(-3px);
  }
  .more[open] summary {
    margin-bottom: var(--s-2);
  }
  .new-acts {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin: 1.4rem -1.6rem -1.5rem;
    padding: var(--s-3) 1.6rem calc(var(--s-3) + env(safe-area-inset-bottom));
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .sheet-grip {
    display: none;
  }

  /* En el celular, los diálogos salen como hoja desde abajo (acciones cerca del pulgar) */
  @media (max-width: 560px) {
    dialog.ap,
    dialog.new {
      margin: auto 0 0;
      width: 100%;
      max-width: none;
      max-height: 92dvh;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
    }
    dialog.ap[open],
    dialog.new[open] {
      animation: sheet-in 0.35s var(--ease) both;
    }
    .ap-in {
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));
    }
    .new-in {
      padding: 0.6rem 1.2rem 1.5rem;
    }
    .sheet-grip {
      display: block;
      width: 36px;
      height: 4px;
      margin: 0 auto 0.6rem;
      border-radius: 4px;
      background: var(--line);
    }
    .new-acts {
      margin-inline: -1.2rem;
      padding-inline: 1.2rem;
    }
    .new-acts .btn-clay {
      flex: 1;
    }
    .new-acts .btn-ghost {
      border-color: transparent;
      padding-inline: 0.6rem;
    }
    /* La cabecera con la X no se va con el scroll de la hoja */
    .new .ap-head {
      position: sticky;
      top: -0.6rem;
      z-index: 3;
      margin: -0.6rem -1.2rem 0;
      padding: 0.6rem 1.2rem 0.4rem;
      background: var(--white);
    }
  }
  @media (max-width: 400px) {
    .x-long {
      display: none;
    }
  }
  @keyframes sheet-in {
    from {
      transform: translateY(24px);
      opacity: 0.4;
    }
  }
</style>

<script>
  // Coloca citas, franjas de horario y la línea de "ahora" según sus minutos.
  const week = document.querySelector<HTMLElement>('[data-week]');
  if (week) {
    const startMin = Number(week.dataset.start);
    // La escala sale del CSS (--ppm): una sola fuente para dibujar y para el clic.
    const ppm = () => parseFloat(getComputedStyle(week).getPropertyValue('--ppm')) || 0.9;
    week.querySelectorAll<HTMLElement>('[data-s]').forEach((el) => {
      el.style.setProperty('--s', el.dataset.s!);
      el.style.setProperty('--d', el.dataset.d!);
    });
    week.querySelectorAll<HTMLElement>('.ev').forEach((ev) => {
      const h = Number(ev.dataset.d) * ppm();
      ev.classList.toggle('short', h < 40);
      ev.classList.toggle('tall', h >= 76);
    });
    const axis = week.querySelectorAll('.w-axis span').length;
    week.style.setProperty('--hours', String(axis));

    const nowEl = week.querySelector<HTMLElement>('[data-now]');
    const body = week.querySelector<HTMLElement>('.w-body');
    const placeNow = () => {
      const parts = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Bogota' }).format(new Date());
      const [h, m] = parts.split(':').map(Number);
      const off = h * 60 + m - startMin;
      if (!nowEl) return off;
      nowEl.hidden = off < 0 || off > axis * 60;
      nowEl.style.setProperty('--s', String(off));
      return off;
    };
    const off = placeNow();
    setInterval(placeNow, 60_000);
    // Solo si el calendario tuviera scroll propio: nunca esconder la primera cita.
    if (body && body.scrollHeight > body.clientHeight + 4) {
      const firsts = [...week.querySelectorAll<HTMLElement>('.ev')].map((e) => Number(e.dataset.s));
      const candidates = [...firsts, nowEl && !nowEl.hidden ? off - 60 : Infinity];
      const target = Math.min(...candidates) - 30;
      if (Number.isFinite(target) && target > 0) body.scrollTop = target * ppm();
    }

    // Clic en un espacio vacío de hoy o un día futuro: nueva cita en ese día y hora.
    week.querySelectorAll<HTMLElement>('.w-col:not(.closed):not(.past)').forEach((col) =>
      col.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.ev')) return;
        const y = e.clientY - col.getBoundingClientRect().top;
        const mins = Math.max(0, Math.round((y / ppm() + startMin) / 30) * 30);
        const t = `${String(Math.floor(mins / 60) % 24).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
        openNew(col.dataset.col!, t);
      }),
    );
  }

  // Diálogos de detalle.
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement | null)?.showModal()),
  );
  // Cerrar diálogos al tocar fuera (el de nueva cita, solo si no hay nada escrito).
  let dirty = false;
  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((d) =>
    d.addEventListener('click', (e) => {
      if (e.target !== d) return;
      if (d.id === 'new-appt' && dirty) return;
      d.close();
    }),
  );

  // Nueva cita.
  const dlgNew = document.getElementById('new-appt') as HTMLDialogElement | null;
  const formNew = dlgNew?.querySelector<HTMLFormElement>('form');
  const $ = <T extends HTMLElement>(sel: string) => dlgNew?.querySelector<T>(sel) ?? null;
  const svcEl = $<HTMLSelectElement>('#m-service');
  const dateEl = $<HTMLInputElement>('#m-date');
  const timeEl = $<HTMLInputElement>('#m-time');
  const phoneEl = $<HTMLInputElement>('#m-phone');
  const endEl = $<HTMLElement>('[data-end]');
  const errEl = $<HTMLElement>('[data-new-err]');
  const touch = matchMedia('(pointer: coarse)').matches;

  // "Termina a las …" según la duración del servicio.
  const fmt12 = (m: number) => {
    const h = Math.floor(m / 60) % 24;
    return `${h % 12 || 12}:${String(m % 60).padStart(2, '0')}\u00a0${h < 12 ? 'a.\u00a0m.' : 'p.\u00a0m.'}`;
  };
  const showEnd = () => {
    if (!endEl || !timeEl || !svcEl) return;
    const dur = Number(svcEl.selectedOptions[0]?.dataset.dur ?? 0);
    const [h, m] = timeEl.value.split(':').map(Number);
    endEl.textContent = timeEl.value && dur ? `Termina a las ${fmt12(h * 60 + m + dur)}` : '';
  };
  svcEl?.addEventListener('change', showEnd);
  timeEl?.addEventListener('input', showEnd);

  // Misma regla que el servidor para el WhatsApp, para avisar antes de enviar.
  const phoneOk = (v: string) => {
    let d = v.replace(/[^\d+]/g, '');
    if (d.startsWith('+')) d = d.slice(1);
    else if (d.length === 10 && d.startsWith('3')) d = `57${d}`;
    return /^[0-9]{7,15}$/.test(d);
  };
  const checkPhone = () => {
    if (!phoneEl) return;
    phoneEl.setCustomValidity(phoneEl.value && !phoneOk(phoneEl.value) ? 'Escribe el número con 10 dígitos, ej.: 300 123 4567' : '');
  };
  phoneEl?.addEventListener('input', () => {
    checkPhone();
    phoneEl.removeAttribute('aria-invalid');
  });
  formNew?.addEventListener('input', () => (dirty = true));
  formNew?.addEventListener('submit', () => {
    if (dateEl?.value) formNew.dataset.posDay = dateEl.value;
  });

  function openNew(date?: string, time?: string) {
    if (!dlgNew) return;
    if (date && dateEl && date >= dateEl.min) dateEl.value = date;
    if (time && timeEl) timeEl.value = time;
    showEnd();
    dlgNew.showModal();
    // En el celular no se abre el teclado de entrada (taparía fecha y hora).
    if (!touch) $<HTMLInputElement>('#m-name')?.focus();
  }
  document.querySelectorAll<HTMLElement>('[data-open-new]').forEach((b) => b.addEventListener('click', () => openNew(b.dataset.date)));
  dlgNew?.querySelectorAll('[data-close]').forEach((b) =>
    b.addEventListener('click', () => {
      dlgNew.close();
      // «Cerrar sin guardar» descarta lo escrito; la X solo cierra (se conserva para seguir luego).
      if ((b as HTMLElement).dataset.discard !== undefined && formNew) {
        formNew.reset();
        homeToggle?.dispatchEvent(new Event("change"));
        dirty = false;
        if (errEl) errEl.hidden = true;
        showEnd();
      }
    }),
  );

  // Si el guardado falló: se reabre con lo escrito y se enfoca el campo a revisar.
  formNew?.addEventListener('bp:restored', (e) => {
    // El error se muestra dentro del diálogo: no se repite en el aviso flotante.
    e.preventDefault();
    const message = (e as CustomEvent<{ message: string }>).detail.message;
    const pick = /whatsapp/i.test(message)
      ? '#m-phone'
      : /nombre/i.test(message)
        ? '#m-name'
        : /correo/i.test(message)
          ? '#m-email'
          : /esa hora/i.test(message)
            ? '#m-time'
            : /domicilio/i.test(message)
              ? '#m-address'
              : /fecha/i.test(message)
              ? '#m-date'
              : /servicio/i.test(message)
                ? '#m-service'
                : null;
    if (errEl) {
      errEl.textContent = message;
      errEl.hidden = false;
    }
    const more = $<HTMLDetailsElement>('[data-more]');
    if (more && ($<HTMLInputElement>('#m-email')?.value || $<HTMLTextAreaElement>('#m-notes')?.value || /domicilio/i.test(message))) more.open = true;
    dirty = true;
    showEnd();
    dlgNew?.showModal();
    const field = pick ? $<HTMLInputElement>(pick) : null;
    if (field) {
      field.setAttribute('aria-invalid', 'true');
      field.addEventListener('input', () => field.removeAttribute('aria-invalid'), { once: true });
      field.focus();
    }
  });

  // Comprobante en una ventana dentro del panel (imagen o PDF), servido por el propio panel.
  const rcpt = document.querySelector<HTMLDialogElement>('#rcpt');
  const rImg = rcpt?.querySelector<HTMLImageElement>('[data-rcpt-img]');
  const rPdf = rcpt?.querySelector<HTMLIFrameElement>('[data-rcpt-pdf]');
  const rLoad = rcpt?.querySelector<HTMLElement>('[data-rcpt-loading]');
  const rRetry = rcpt?.querySelector<HTMLButtonElement>('[data-rcpt-retry]');
  const rLink = rcpt?.querySelector<HTMLAnchorElement>('[data-rcpt-link]');
  let rUrl = '';
  let rTries = 0;
  const loadImg = () => {
    if (!rImg || !rLoad || !rRetry) return;
    rImg.hidden = true;
    rRetry.hidden = true;
    rLoad.hidden = false;
    rLoad.textContent = 'Cargando…';
    rImg.src = `${rUrl}&t=${Date.now()}`;
  };
  rImg?.addEventListener('load', () => {
    rLoad!.hidden = true;
    rImg.hidden = false;
  });
  rImg?.addEventListener('error', () => {
    if (!rImg.getAttribute('src')) return;
    // Un reintento automático (red lenta del celular); si vuelve a fallar, botón para reintentar.
    if (rTries++ < 1) return void setTimeout(loadImg, 800);
    rLoad!.textContent = 'No se pudo cargar el comprobante.';
    rRetry!.hidden = false;
  });
  rRetry?.addEventListener('click', () => {
    rTries = 0;
    loadImg();
  });
  rcpt?.addEventListener('close', () => {
    rImg?.removeAttribute('src');
    rPdf?.removeAttribute('src');
  });
  // Botones y formularios de las citas por delegación: siguen funcionando después de que el
  // diálogo de una cita se refresca sin recargar la página.
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rcpt]');
    if (!b || !rcpt || !rImg || !rPdf || !rLoad || !rLink) return;
    rUrl = b.dataset.rcpt!;
    rTries = 0;
    const pdf = b.dataset.pdf === '1';
    rcpt.querySelector('#rcpt-t')!.textContent = `Comprobante de ${b.dataset.who ?? ''}`.trim();
    rLink.href = rUrl;
    rcpt.classList.toggle('is-pdf', pdf);
    rPdf.hidden = !pdf;
    if (pdf) {
      rImg.hidden = true;
      rLoad.hidden = true;
      rRetry!.hidden = true;
      rPdf.src = rUrl;
    } else loadImg();
    rcpt.showModal();
  });

  // Tras confirmar un abono, se abre la cita para avisarle a la clienta.
  const abrir = document.querySelector<HTMLElement>('[data-abrir]')?.dataset.abrir;
  if (abrir && /^[0-9a-f-]{36}$/i.test(abrir)) document.querySelector<HTMLDialogElement>(`#ap-${abrir}`)?.showModal();
  // Registra qué avisos de WhatsApp ya se enviaron (para no repetirlos).
  document.addEventListener('click', (e) => {
    const l = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-notice]');
    if (!l) return;
    const [id, ev] = (l.dataset.notice ?? '').split(':');
    if (id && ev && ev !== 'hello') navigator.sendBeacon('/api/admin/avisado', new URLSearchParams({ id, ev }));
  });

  type Res = { ok: boolean; kind?: string; msg: string; next: string; wa?: string; notice?: string };
  const post = async (form: HTMLFormElement): Promise<Res> => {
    const r = await fetch(location.pathname, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
    return (await r.json()) as Res;
  };
  const note = (el: HTMLElement, text: string, err: boolean) => {
    el.textContent = text;
    el.classList.toggle('err', err);
    el.hidden = false;
  };
  /** La agenda de atrás quedó vieja: al cerrar la cita se recarga en la semana que toca. */
  const staleOnClose = (dlg: HTMLDialogElement, next: string) => {
    dlg.dataset.next = next;
    if (dlg.dataset.stale) return;
    dlg.dataset.stale = '1';
    dlg.addEventListener('close', () => location.assign(dlg.dataset.next!), { once: true });
  };
  /** Trae la página de nuevo y cambia solo el contenido de esta cita, con el aviso arriba de los datos. */
  const refreshDialog = async (dlg: HTMLDialogElement, res: Res) => {
    const url = new URL(res.next, location.origin);
    for (const k of ['ok', 'warn', 'error', 'abrir', 'mvd', 'mvt']) url.searchParams.delete(k);
    const html = await (await fetch(url.pathname + url.search, { headers: { Accept: 'text/html' }, cache: 'no-store' })).text();
    const fresh = new DOMParser().parseFromString(html, 'text/html').getElementById(dlg.id);
    staleOnClose(dlg, res.next);
    if (!fresh) return location.assign(res.next);
    const top = dlg.scrollTop;
    dlg.className = fresh.className;
    dlg.replaceChildren(...[...fresh.childNodes].map((n) => document.importNode(n, true)));
    const msg = Object.assign(document.createElement('p'), { className: 'ajax-msg ajax-top', role: 'status' });
    note(msg, `${res.kind === 'warn' ? '⚠️' : '✅'} ${res.msg}`, false);
    (dlg.querySelector('.ap-info') ?? dlg.firstElementChild)?.before(msg);
    dlg.scrollTop = top;
  };

  document.addEventListener('submit', async (e) => {
    const form = e.target as HTMLFormElement;
    const dlg = form.closest<HTMLDialogElement>('dialog.ap');
    // Solo formularios de una cita; los que piden confirmación llegan aquí ya confirmados.
    if (!dlg || form.method !== 'post' || e.defaultPrevented) return;
    e.preventDefault();
    const btn = ((e as SubmitEvent).submitter ?? form.querySelector('button:not([type=button])')) as HTMLButtonElement | null;
    if (btn?.disabled) return;
    btn?.classList.add('loading');
    if (btn) btn.disabled = true;
    const done = () => {
      delete form.dataset.confirmed;
      if (btn) btn.disabled = false;
      btn?.classList.remove('loading');
    };
    // Dónde mostrar un error: el aviso propio del formulario, o uno que se crea al final de él.
    const errBox = () => {
      const own = form.querySelector<HTMLElement>('[data-move-err], [data-ajax-msg]');
      if (own) return own;
      const p = Object.assign(document.createElement('p'), { className: 'ajax-msg', role: 'alert' });
      p.dataset.ajaxMsg = '';
      return form.appendChild(p);
    };
    try {
      const res = await post(form);
      if (!res.ok) {
        const err = errBox();
        note(err, res.msg, true);
        err.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return;
      }
      // Cambiar hora: el formulario muestra el resultado y el botón para avisarle a la clienta.
      if (form.matches('[data-move-form]')) {
        const box = form.closest('details')!;
        const ok = box.querySelector<HTMLElement>('[data-move-done]')!;
        ok.querySelector<HTMLElement>('[data-move-msg]')!.textContent = `✅ ${res.msg}`;
        const wa = ok.querySelector<HTMLAnchorElement>('[data-move-wa]')!;
        if (res.wa) {
          wa.href = res.wa;
          if (res.notice) wa.dataset.notice = res.notice;
        } else wa.hidden = true;
        ok.querySelector<HTMLAnchorElement>('[data-move-next]')!.href = res.next;
        form.hidden = true;
        ok.hidden = false;
        staleOnClose(dlg, res.next);
        return;
      }
      await refreshDialog(dlg, res);
    } catch {
      note(errBox(), 'Sin conexión. Revisa el internet e intenta de nuevo.', true);
    } finally {
      done();
    }
  });
  document.addEventListener('input', (e) => {
    const f = (e.target as HTMLElement).closest('dialog.ap form');
    f?.querySelectorAll<HTMLElement>('[data-move-err], [data-ajax-msg]').forEach((x) => (x.hidden = true));
  });

  // Servicio a domicilio: muestra y exige la dirección.
  const homeToggle = document.querySelector<HTMLInputElement>('[data-home-toggle]');
  const homeField = document.querySelector<HTMLElement>('[data-home-field]');
  const syncHome = () => {
    if (!homeToggle || !homeField) return;
    homeField.hidden = !homeToggle.checked;
    homeField.querySelector('input')!.required = homeToggle.checked;
  };
  homeToggle?.addEventListener('change', syncHome);
  syncHome();

  // Tira de días (móvil).
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      let shown: HTMLElement | null = null;
      document.querySelectorAll<HTMLElement>('[data-daylist]').forEach((s) => {
        s.hidden = s.dataset.daylist !== c.dataset.day;
        if (!s.hidden) shown = s;
      });
      (shown as HTMLElement | null)?.scrollIntoView({ block: 'nearest' });
    }),
  );
</script>
