---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { addBlockedDate, getAppointments, getBlockedDates, getHours, getSettings, removeBlockedDate, saveHours, updateSettings } from '../../lib/db';
import { WEEKDAYS } from '../../lib/defaults';
import { back, bool, int, isUuid, str } from '../../lib/admin';
import { isDate, isTime, localDate, minutesOf, prettyDate, fromLocal } from '../../lib/time';

const HERE = '/admin/horario';
const OOPS = 'Algo salió mal. Recarga la página e intenta de nuevo.';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);

  if (action === 'hours') {
    const rows = [];
    for (let d = 0; d < 7; d++) {
      const open = str(fd, `open_${d}`, 5);
      const close = str(fd, `close_${d}`, 5);
      if (!isTime(open) || !isTime(close) || minutesOf(close) <= minutesOf(open))
        return back(HERE, 'error', `Revisa el ${WEEKDAYS[d].toLowerCase()}: la hora de cierre debe ser después de la de apertura.`);
      rows.push({ weekday: d, enabled: bool(fd, `enabled_${d}`), open_time: open, close_time: close });
    }
    await saveHours(rows);
    await updateSettings({
      slot_step_min: int(fd, 'slot_step_min', 10, 120, 30),
      min_notice_hours: int(fd, 'min_notice_hours', 0, 168, 12),
      max_days_ahead: int(fd, 'max_days_ahead', 1, 365, 60),
    });
    return back(HERE, 'ok', 'Horario guardado. Ya se aplica en las reservas.');
  }
  if (action === 'block') {
    const day = str(fd, 'day', 10);
    if (!isDate(day)) return back(HERE, 'error', 'Elige la fecha que quieres bloquear.');
    await addBlockedDate(day, str(fd, 'reason', 120));
    return back(HERE, 'ok', 'Listo, nadie podrá reservar ese día.');
  }
  if (action === 'unblock') {
    const id = str(fd, 'id', 40);
    if (!isUuid(id)) return back(HERE, 'error', OOPS);
    await removeBlockedDate(id);
    return back(HERE, 'ok', 'Ese día vuelve a estar disponible para reservas.');
  }
  return back(HERE, 'error', OOPS);
}

const now = new Date();
const [hours, blocked, s, upcoming] = await Promise.all([
  getHours(),
  getBlockedDates(localDate()),
  getSettings(),
  getAppointments({ from: now, to: new Date(now.getTime() + 366 * 864e5), activeOnly: true }),
]);
const order = [1, 2, 3, 4, 5, 6, 0];
// Citas activas por día, para avisar al bloquear un día que ya tiene citas.
const busy: Record<string, number> = {};
for (const a of upcoming) {
  const d = localDate(new Date(a.starts_at));
  busy[d] = (busy[d] ?? 0) + 1;
}
---

<Admin title="Horario" subtitle="Elige qué días y a qué horas te pueden reservar. Los cambios se aplican de una.">
  <a slot="actions" href="#bloqueados" class="btn btn-soft" data-goto-block><Icon name="ban" /> Bloquear un día</a>

  <form method="post" class="panel hours-form" id="horario" data-keep data-draft="hours" data-hours data-sticky-save>
    <input type="hidden" name="action" value="hours" />
    <div class="h-week">
      <div class="panel-head">
        <h2>Horario semanal</h2>
        <span class="muted">Activa los días que atiendes</span>
      </div>
      <div class="hours">
        {
          order.map((d) => {
            const h = hours.find((x) => x.weekday === d)!;
            return (
              <div class="hrow" data-day-row={WEEKDAYS[d].toLowerCase()}>
                <label class="check day-t">
                  <input type="checkbox" name={`enabled_${d}`} checked={h.enabled} />{' '}
                  <span>
                    <span class="sr-only">Atiendo el </span>
                    {WEEKDAYS[d]}
                  </span>
                </label>
                <div class="times">
                  <input class="input" type="time" name={`open_${d}`} value={h.open_time.slice(0, 5)} aria-label={`Apertura del ${WEEKDAYS[d].toLowerCase()}`} data-open />
                  <span class="sep" aria-hidden="true">
                    a
                  </span>
                  <input class="input" type="time" name={`close_${d}`} value={h.close_time.slice(0, 5)} aria-label={`Cierre del ${WEEKDAYS[d].toLowerCase()}`} data-close />
                </div>
                <span class="closed-t">Cerrado</span>
              </div>
            );
          })
        }
      </div>
    </div>
    <div class="h-rules">
      <h2>Cómo te reservan</h2>
      <div class="rules">
        <div class="field">
          <label for="step"><Icon name="clock" size={16} /> Cada cuánto ofreces horas</label>
          <div class="unit">
            <input id="step" name="slot_step_min" type="number" min="10" max="120" step="5" value={s.slot_step_min} aria-describedby="u-step h-step" /><span id="u-step">min</span>
          </div>
          <small class="hint" id="h-step">30 = 8:00, 8:30, 9:00…</small>
        </div>
        <div class="field">
          <label for="notice"><Icon name="sparkle" size={16} /> Aviso mínimo</label>
          <div class="unit">
            <input id="notice" name="min_notice_hours" type="number" min="0" max="168" value={s.min_notice_hours} aria-describedby="u-notice h-notice" /><span id="u-notice">horas</span>
          </div>
          <small class="hint" id="h-notice">Horas antes de la cita</small>
        </div>
        <div class="field">
          <label for="ahead"><Icon name="calendar" size={16} /> Reservas con hasta</label>
          <div class="unit">
            <input id="ahead" name="max_days_ahead" type="number" min="1" max="365" value={s.max_days_ahead} aria-describedby="u-ahead h-ahead" /><span id="u-ahead">días</span>
          </div>
          <small class="hint" id="h-ahead">Días de anticipación</small>
        </div>
      </div>
      <div class="save-row">
        <p class="unsaved" data-unsaved hidden>Tienes cambios sin guardar</p>
        <button class="btn btn-clay"><Icon name="check" /> Guardar horario</button>
      </div>
    </div>
  </form>

  <section class="panel" id="bloqueados" data-keep>
    <div class="panel-head">
      <h2>Días bloqueados</h2>
    </div>
    <p class="muted">
      Vacaciones, festivos o días con eventos grandes. Nadie podrá reservar esas fechas. Con Google Calendar conectado, tus eventos personales también bloquean horarios
      automáticamente. Las citas que ya tengas ese día no se cancelan solas.
    </p>
    <form method="post" class="block-form" data-busy={JSON.stringify(busy)}>
      <input type="hidden" name="action" value="block" />
      <div class="field">
        <label for="b-day">Fecha a bloquear</label>
        <input class="input" id="b-day" type="date" name="day" min={localDate()} required aria-describedby="b-warn" data-block-day />
      </div>
      <div class="field">
        <label for="b-reason">Motivo (opcional)</label>
        <input class="input" id="b-reason" name="reason" maxlength="120" placeholder="Ej.: Vacaciones" />
      </div>
      <button class="btn btn-cocoa"><Icon name="ban" /> Bloquear día</button>
      <p class="b-warn" id="b-warn" role="status" data-block-warn></p>
    </form>
    <ul class="blocked">
      {
        blocked.map((b) => (
          <li>
            <span class="b-ico">
              <Icon name="calendar" size={18} />
            </span>
            <span class="b-txt">
              <strong>{prettyDate(fromLocal(b.day, '12:00'))}</strong>
              {b.reason && <span class="muted">{b.reason}</span>}
              {busy[b.day] && (
                <span class="b-busy">
                  Tienes {busy[b.day]} {busy[b.day] === 1 ? 'cita' : 'citas'} ese día
                </span>
              )}
            </span>
            <form method="post" data-confirm="¿Desbloquear este día? Volverá a estar disponible para reservas." data-confirm-yes="Sí, desbloquear">
              <input type="hidden" name="action" value="unblock" />
              <input type="hidden" name="id" value={b.id} />
              <button class="btn btn-soft btn-sm">Desbloquear</button>
            </form>
          </li>
        ))
      }
      {blocked.length === 0 && <li class="none">No tienes días bloqueados.</li>}
    </ul>
  </section>
</Admin>

<style>
  .hours {
    display: grid;
    gap: var(--s-2);
  }
  .hrow {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: var(--s-3);
    align-items: center;
    min-width: 0;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    background: var(--cream);
    transition: background 0.3s, opacity 0.3s;
  }
  .day-t {
    font-size: var(--t-md);
  }
  .times {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    max-width: 380px;
  }
  .times .input {
    flex: 1 1 0;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0.5rem 0.7rem;
  }
  .sep {
    color: var(--muted);
    font-weight: 600;
  }
  .closed-t {
    display: none;
    color: var(--muted);
    font-weight: 600;
    font-size: var(--t-sm);
  }
  .hrow:has(input[type='checkbox']:not(:checked)) {
    background: transparent;
    outline: 1.5px dashed var(--field-line);
    outline-offset: -1.5px;
  }
  .hrow:has(input[type='checkbox']:not(:checked)) .times {
    display: none;
  }
  .hrow:has(input[type='checkbox']:not(:checked)) .closed-t {
    display: block;
  }
  .hrow:has(input[type='checkbox']:not(:checked)) .day-t > span {
    color: var(--muted);
  }
  @media (max-width: 1099px) {
    /* Así el botón fijo del pie se limita al formulario entero y no solo a este bloque. */
    .h-rules {
      display: contents;
    }
    .h-rules h2 {
      margin-top: var(--s-6) !important;
    }
  }
  .rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-4);
  }
  .rules label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .rules label svg {
    color: var(--accent-text);
  }
  .unit {
    position: relative;
  }
  .unit span {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: var(--t-sm);
    font-weight: 600;
    pointer-events: none;
  }
  .unit input {
    padding-right: 4rem !important;
  }
  .save-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  .unsaved {
    margin: 0 auto 0 0;
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--accent-text);
  }
  .block-form {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: end;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }
  .btn-cocoa {
    min-height: 50px !important;
  }
  .b-warn {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 600;
    color: #6b4f10;
  }
  .b-warn:empty {
    display: none;
  }
  .blocked {
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0 0;
    display: grid;
    gap: var(--s-2);
  }
  .blocked li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    background: var(--cream);
    animation: a-rise 0.4s var(--ease) backwards;
  }
  .b-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-sm);
    background: #f9e3de;
    color: #a83a26;
    flex: none;
  }
  .b-txt {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .b-busy {
    font-size: var(--t-xs);
    font-weight: 700;
    color: #6b4f10;
  }
  .blocked li.none {
    justify-content: center;
    padding: var(--s-5);
    background: transparent;
    border: 1.5px dashed var(--field-line);
    color: var(--muted);
    font: italic 450 var(--t-md) var(--font-display);
  }

  /* Escritorio ancho: horario a la izquierda, reglas y guardar a la derecha (siempre a la vista) */
  @media (min-width: 1100px) {
    .hours-form {
      display: grid;
      grid-template-columns: minmax(0, 620px) 1fr;
      gap: var(--s-6);
      align-items: start;
    }
    .h-rules {
      position: sticky;
      top: var(--s-5);
      margin-top: 0;
      padding: var(--s-5);
      border-radius: var(--r-md);
      background: var(--cream);
    }
    .rules {
      grid-template-columns: 1fr;
    }
    .save-row .btn {
      width: 100%;
    }
    .unsaved {
      margin: 0;
    }
  }
  @media (max-width: 860px) {
    /* Con cambios sin guardar, el botón queda pegado abajo, encima de la barra */
    .hours-form.dirty .save-row {
      position: sticky;
      bottom: calc(var(--tab-h) + env(safe-area-inset-bottom));
      z-index: 4;
      margin-inline: calc(var(--s-4) * -1);
      padding: var(--s-3) var(--s-4);
      background: var(--white);
    box-shadow: 0 -10px 24px -18px rgb(42 28 22 / 0.35);
      border-top: 1px solid var(--line);
    }
    .save-row .btn {
      width: 100%;
    }
  }
  @media (max-width: 640px) {
    .hrow {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
    .block-form {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Horario: la hora de cierre debe ser después de la de apertura (se avisa antes de enviar).
  const form = document.querySelector<HTMLFormElement>('[data-hours]');
  if (form) {
    const rows = [...form.querySelectorAll<HTMLElement>('.hrow')];
    const mins = (v: string) => {
      const [h, m] = v.split(':').map(Number);
      return h * 60 + m;
    };
    const validate = () => {
      for (const row of rows) {
        const on = row.querySelector<HTMLInputElement>('input[type=checkbox]')!.checked;
        const open = row.querySelector<HTMLInputElement>('[data-open]')!;
        const close = row.querySelector<HTMLInputElement>('[data-close]')!;
        const bad = on && open.value && close.value && mins(close.value) <= mins(open.value);
        close.setCustomValidity(bad ? 'Debe ser después de la hora de apertura' : '');
        close.toggleAttribute('aria-invalid', Boolean(bad));
      }
    };
    // Cambios sin guardar: botón visible y aviso al salir.
    const fields = [...form.querySelectorAll<HTMLInputElement>('input:not([type=hidden])')];
    const unsaved = form.querySelector<HTMLElement>('[data-unsaved]');
    let submitting = false;
    const isDirty = () => fields.some((f) => (f.type === 'checkbox' ? f.checked !== f.defaultChecked : f.value !== f.defaultValue));
    const sync = () => {
      validate();
      const d = isDirty();
      form.classList.toggle('dirty', d);
      if (unsaved) unsaved.hidden = !d;
    };
    form.addEventListener('input', sync);
    form.addEventListener('change', sync);
    form.addEventListener('bp:restored', sync);
    form.addEventListener('submit', () => {
      submitting = true;
      // Los días apagados no se ven: si sus horas quedaron incoherentes, se vuelven a las guardadas.
      for (const row of rows) {
        if (row.querySelector<HTMLInputElement>('input[type=checkbox]')!.checked) continue;
        const open = row.querySelector<HTMLInputElement>('[data-open]')!;
        const close = row.querySelector<HTMLInputElement>('[data-close]')!;
        if (!open.value || !close.value || mins(close.value) <= mins(open.value)) {
          open.value = open.defaultValue;
          close.value = close.defaultValue;
        }
      }
    });
    addEventListener('beforeunload', (e) => {
      if (!submitting && isDirty()) e.preventDefault();
    });
    // Si el servidor rechazó un día, se enfoca su hora de cierre.
    form.addEventListener('bp:restored', (e) => {
      const message = (e as CustomEvent<{ message: string }>).detail.message.toLowerCase();
      const row = rows.find((r) => message.includes(`el ${r.dataset.dayRow}`));
      row?.querySelector<HTMLInputElement>('[data-close]')?.focus();
    });
    sync();
  }

  // Bloquear un día: atajo desde la cabecera y aviso si ese día ya tiene citas.
  const blockDay = document.querySelector<HTMLInputElement>('[data-block-day]');
  document.querySelector('[data-goto-block]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.getElementById('bloqueados')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    setTimeout(() => blockDay?.focus({ preventScroll: true }), 350);
  });
  const warn = document.querySelector<HTMLElement>('[data-block-warn]');
  const busy: Record<string, number> = JSON.parse(document.querySelector<HTMLElement>('[data-busy]')?.dataset.busy ?? '{}');
  blockDay?.addEventListener('change', () => {
    if (!warn) return;
    const n = busy[blockDay.value] ?? 0;
    warn.textContent = n ? `Ese día tienes ${n} ${n === 1 ? 'cita' : 'citas'}. Bloquearlo no ${n === 1 ? 'la' : 'las'} cancela.` : '';
  });
</script>
