---
import Base from '../../layouts/Base.astro';
import { adminEmails, supabaseAuth, supabaseConfigured } from '../../lib/supabase';
import { checkFormToken, formToken, limited, limitedBy } from '../../lib/http';

if (Astro.locals.user) return Astro.redirect('/admin', 303);

let error = '';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const email = String(fd.get('email') ?? '').trim().toLowerCase().slice(0, 120);
  const password = String(fd.get('password') ?? '').slice(0, 200);
  if (
    (await limited(Astro.request, Astro.clientAddress, 'login', 8, 900)) ||
    // Límite por cuenta (aunque el atacante cambie de IP): 10 intentos/hora por correo.
    (await limitedBy(email, 'login-acct', 10, 3600))
  ) {
    error = 'Demasiados intentos. Espera unos minutos e intenta de nuevo.';
  } else if (String(fd.get('company') ?? '') !== '' || !(await checkFormToken(fd.get('ft'), 'login', 1200))) {
    // Honeypot o envío automático: respuesta genérica, sin dar pistas.
    error = 'No pudimos validar el formulario. Recarga la página e intenta de nuevo.';
  } else if (!supabaseConfigured) {
    error = 'El acceso aún no está configurado.';
  } else if (!adminEmails().includes(email)) {
    // Mismo mensaje que una contraseña incorrecta: no revelamos qué correos existen.
    error = 'Correo o contraseña incorrectos.';
  } else {
    const sb = supabaseAuth(Astro.request, Astro.cookies);
    const { error: e } = await sb.auth.signInWithPassword({ email, password });
    if (e) {
      error = 'Correo o contraseña incorrectos.';
      // Pequeña espera para frenar ataques de fuerza bruta.
      await new Promise((r) => setTimeout(r, 600));
    } else return Astro.redirect('/admin', 303);
  }
}
const ft = await formToken('login');
const reason = Astro.url.searchParams.get('motivo');
---

<Base title="Ingresar · Panel Betsy Peinados" description="Acceso al panel" noindex>
  <main id="contenido" class="login">
    <form method="post" class="box">
      <a href="/" class="logo">Betsy <span>panel</span></a>
      <h1>Bienvenida</h1>
      {error && <p class="notice error" role="alert">{error}</p>}
      {!error && reason === 'inactividad' && <p class="notice" role="status">Cerramos tu sesión por inactividad para proteger los datos de tus clientas.</p>}
      <input type="hidden" name="ft" value={ft} />
      <div class="hp" aria-hidden="true">
        <label for="company">No llenar</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="field">
        <label for="email">Correo</label>
        <input id="email" name="email" type="email" autocomplete="username" autocapitalize="off" spellcheck="false" maxlength="120" required />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required />
      </div>
      <button class="btn btn-clay" type="submit">Ingresar</button>
    </form>
  </main>
</Base>

<style>
  .login {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }
  .box {
    width: min(420px, 100%);
    display: grid;
    gap: 1.1rem;
    padding: 2.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.8rem;
    text-decoration: none;
  }
  .logo span {
    font: 700 0.65rem var(--font-body);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--clay);
  }
  h1 {
    font-size: 2.2rem;
    margin: 0;
  }
</style>
