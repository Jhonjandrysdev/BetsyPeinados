---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { getAppointmentsByIds, getSettings, getTemplates, saveTemplate, updateSettings } from '../../lib/db';
import { compararGasto, resumenDeUso } from '../../lib/uso-whatsapp';
import { TASA_USD_COP_DEFECTO, gastoEnPesos } from '../../lib/gasto-meta';
import { back, str } from '../../lib/admin';
import { metaCost, templatePrefix, waConfigured, waMessagesBetween } from '../../lib/whatsapp';
import { textoPlantilla } from '../../lib/aviso';
import { TZ, formatCOP, fromLocal, localDate } from '../../lib/time';
import { getSecret } from 'astro:env/server';
import { DEFAULT_TEMPLATES, META_TEMPLATES, NOTICE_EVENTS, PLACEHOLDERS, fillTemplate, valuesFor, type NoticeEvent } from '../../lib/messages';
import type { Appointment } from '../../lib/types';

const HERE = '/admin/mensajes';
if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('form') === 'wa') {
    const rate = Number(str(fd, 'rate', 12).replace(',', '.'));
    if (!Number.isFinite(rate) || rate < 0 || rate > 10000) return back(HERE, 'error', 'Escribe el precio por mensaje en pesos, por ejemplo 3,5.');
    // La tasa se escribe como en Colombia (4.000 o 4000): se quitan los separadores de miles.
    const usdCop = Number(str(fd, 'usd', 12).replace(/[.\s]/g, '').replace(',', '.'));
    if (!Number.isFinite(usdCop) || usdCop < 1000 || usdCop > 20000) return back(HERE, 'error', 'Escribe la tasa del dólar en pesos, por ejemplo 4.000.');
    try {
      await updateSettings({ wa_rate_cop: Math.round(rate * 100) / 100, wa_usd_cop: Math.round(usdCop), wa_auto_reminder: fd.get('auto') === 'on' });
    } catch (e) {
      console.error(e);
      return back(HERE, 'error', 'No se pudo guardar. Falta activar el WhatsApp automático en la base de datos.');
    }
    return back(HERE, 'ok', 'Ajustes de WhatsApp guardados');
  }
  const ev = str(fd, 'event', 20) as NoticeEvent;
  if (!NOTICE_EVENTS.some((e) => e.id === ev)) return back(HERE, 'error', 'Algo salió mal. Recarga la página.');
  const body = str(fd, 'body', 1500).trim() || DEFAULT_TEMPLATES[ev];
  try {
    await saveTemplate(ev, fd.get('reset') ? DEFAULT_TEMPLATES[ev] : body);
  } catch (e) {
    console.error(e);
    return back(HERE, 'error', 'No se pudo guardar. Falta activar los mensajes en la base de datos.');
  }
  return back(HERE, 'ok', 'Mensaje guardado');
}

// ───────── WhatsApp: conexión y costo del mes (solo lo de Betsy) ─────────
const today = localDate();
const qMes = Astro.url.searchParams.get('mes');
const month = qMes && /^\d{4}-(0[1-9]|1[0-2])$/.test(qMes) && qMes <= today.slice(0, 7) ? qMes : today.slice(0, 7);
const monthStart = fromLocal(`${month}-01`, '00:00');
const nextMonth = (() => {
  const [y, m] = month.split('-').map(Number);
  return m === 12 ? `${y + 1}-01` : `${y}-${String(m + 1).padStart(2, '0')}`;
})();
const prevMonth = (() => {
  const [y, m] = month.split('-').map(Number);
  return m === 1 ? `${y - 1}-12` : `${y}-${String(m - 1).padStart(2, '0')}`;
})();
const monthEnd = fromLocal(`${nextMonth}-01`, '00:00');
const monthLabel = new Intl.DateTimeFormat('es-CO', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${month}-15T12:00:00Z`));

const prevStart = fromLocal(`${prevMonth}-01`, '00:00');
const [s, saved, msgs, prevMsgs, meta] = await Promise.all([
  getSettings(),
  getTemplates(),
  waMessagesBetween(monthStart, monthEnd),
  waMessagesBetween(prevStart, monthStart),
  metaCost(monthStart, monthEnd),
]);
const waOn = waConfigured();
const tplPrefix = templatePrefix();
const has = (k: string) => Boolean((getSecret(k) ?? '').trim());
const steps = [
  { ok: waOn, label: 'Número y token de Meta', hint: 'WHATSAPP_TOKEN y WHATSAPP_PHONE_ID' },
  { ok: has('WHATSAPP_APP_SECRET') && has('WHATSAPP_VERIFY_TOKEN'), label: 'Respuestas de las clientas (webhook)', hint: 'WHATSAPP_APP_SECRET y WHATSAPP_VERIFY_TOKEN' },
  { ok: has('WHATSAPP_WABA_ID'), label: 'Costo real desde Meta', hint: 'WHATSAPP_WABA_ID (opcional)' },
  { ok: has('CRON_SECRET'), label: 'Recordatorio automático del día antes', hint: 'CRON_SECRET' },
];
const rate = Number(s.wa_rate_cop ?? 3.5);
const usdCop = Number(s.wa_usd_cop ?? TASA_USD_COP_DEFECTO);
const real = meta && 'amount' in meta ? gastoEnPesos({ monto: meta.amount, moneda: meta.currency }, usdCop) : null;
const fmtUsdCop = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 }).format(usdCop);
const uso = resumenDeUso(msgs ?? [], rate);
// Sin datos del mes anterior (falta la migración o falló la lectura) no hay comparación que mostrar.
const vsPrev = prevMsgs ? compararGasto(uso.estimado, resumenDeUso(prevMsgs, rate).estimado) : null;
// Avisos que no salieron, con enlace a su cita (abre la semana de la cita con el detalle).
const NO_SALIERON_MAX = 15;
const shown = uso.noSalieron.slice(0, NO_SALIERON_MAX);
const citas = await getAppointmentsByIds(shown.flatMap((m) => (m.appointment_id ? [m.appointment_id] : []))).catch((e) => {
  console.error('No se pudieron leer las citas de los avisos que no salieron', e);
  return new Map<string, Appointment>();
});
const noSalieron = shown.map((m) => ({ m, cita: m.appointment_id ? citas.get(m.appointment_id) : undefined }));
const citaLink = (a: Appointment) => `/admin?desde=${localDate(new Date(a.starts_at))}&abrir=${a.id}`;
const fmtWhen = new Intl.DateTimeFormat('es-CO', { timeZone: TZ, day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', hour12: true });
const EVENT_LABEL: Record<string, string> = { ...Object.fromEntries(NOTICE_EVENTS.map((e) => [e.id, e.label])), libre: 'Respuestas tuyas', auto: 'Respuestas automáticas' };
/** Monto en la moneda de Meta (US$0,0123; 1.520 COP…), con decimales suficientes para centavos de dólar. */
const money = (n: number, currency: string) => {
  try {
    return new Intl.NumberFormat('es-CO', { style: 'currency', currency, minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(n);
  } catch {
    return `${n} ${currency}`;
  }
};
const fmtRate = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 2 }).format(rate);
const isNow = month === today.slice(0, 7);
const sample: Appointment = {
  id: 'a1b2c3d4-0000-4000-8000-000000000000',
  service_id: null,
  service_name: 'Ondas',
  customer_name: 'Laura Gómez',
  customer_phone: '573001234567',
  customer_email: null,
  notes: '',
  starts_at: new Date(Date.now() + 3 * 864e5).toISOString().slice(0, 10) + 'T15:00:00.000Z',
  ends_at: new Date(Date.now() + 3 * 864e5).toISOString().slice(0, 10) + 'T16:00:00.000Z',
  status: 'pendiente',
  source: 'web',
  google_event_id: null,
  created_at: new Date().toISOString(),
  home_service: false,
  home_address: null,
  hair_length: 'medio',
  deposit_confirmed_at: null,
};
/** Datos de ejemplo para las vistas previas (texto de Mensajes y plantilla de Meta). */
const sampleData = { a: sample, s, price: 80000, deposit: 40000 };
---

<Admin title="Mensajes" subtitle="Lo que le escribes a tus clientas por WhatsApp en cada momento de la cita, si el envío automático está conectado y cuánto te cobra Meta.">
  <section class="panel wa" aria-labelledby="wa-t">
    <div class="wa-top">
      <div>
        <h2 id="wa-t">WhatsApp automático</h2>
        <p class="muted">
          {
            waOn
              ? 'Activo: los avisos salen solos desde la agenda y las respuestas de tus clientas aparecen en cada cita.'
              : 'Aún no está conectado. Mientras tanto, el botón de WhatsApp abre tu app con el mensaje listo, como siempre.'
          }
        </p>
      </div>
      <span class:list={['wa-pill', { on: waOn }]}>{waOn ? 'Activo' : 'Sin conectar'}</span>
    </div>
    <ul class="wa-steps">
      {
        steps.map((st) => (
          <li class:list={{ ok: st.ok }}>
            <span class="wa-dot" aria-hidden="true">{st.ok ? '✓' : ''}</span>
            <span>
              {st.label}
              <small class="muted">{st.ok ? 'Listo' : `Falta: ${st.hint}`}</small>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="wa-cost">
      <div class="wa-month">
        <a class="btn btn-soft btn-sm btn-icon" href={`?mes=${prevMonth}`} aria-label="Mes anterior"><span aria-hidden="true">‹</span></a>
        <h3>Costo de {monthLabel}</h3>
        {isNow ? <span class="btn-icon-gap" aria-hidden="true" /> : <a class="btn btn-soft btn-sm btn-icon" href={`?mes=${nextMonth}`} aria-label="Mes siguiente"><span aria-hidden="true">›</span></a>}
      </div>
      {msgs === null ? (
        <p class="muted">Para llevar la cuenta falta activar el WhatsApp automático en la base de datos (ver la guía).</p>
      ) : (
        <>
          <div class="wa-kpis">
            <p>
              <strong>{real ? (real.cop !== null ? `${real.aproximado ? '≈ ' : ''}${formatCOP(real.cop)}` : money(real.monto, real.moneda)) : formatCOP(uso.estimado)}</strong>
              <span>
                {real ? (real.aproximado ? `cobrado por Meta: ${money(real.monto, real.moneda)} (dólar a ${fmtUsdCop} pesos)` : 'cobrado por Meta (dato real)') : 'costo estimado'}
              </span>
            </p>
            <p>
              <strong>{uso.cobrados}</strong>
              <span>{uso.cobrados === 1 ? 'mensaje cobrado' : 'mensajes cobrados'}</span>
            </p>
            <p>
              <strong>{uso.gratis}</strong>
              <span>gratis (respuestas dentro de las 24 h)</span>
            </p>
            <p>
              <strong>{uso.recibidos}</strong>
              <span>{uso.recibidos === 1 ? 'mensaje recibido' : 'mensajes recibidos'}{uso.confirmo ? ` · ${uso.confirmo} «Confirmo»` : ''}</span>
            </p>
          </div>
          {vsPrev && (
            <p class="muted wa-note">
              {`Gasto estimado${isNow ? ' hasta hoy' : ''}: `}
              {vsPrev.diferencia === 0
                ? 'igual al del mes anterior.'
                : `${vsPrev.diferencia > 0 ? '+' : '−'}${formatCOP(Math.abs(vsPrev.diferencia))}${vsPrev.porcentaje !== null ? ` (${vsPrev.porcentaje > 0 ? '+' : ''}${vsPrev.porcentaje} %)` : ''} frente a todo el mes anterior.`}
            </p>
          )}
          <ul class="wa-states" aria-label="Estado de los mensajes enviados">
            <li><strong>{uso.porEstado.entregados}</strong> entregados ({uso.porEstado.leidos} ya leídos)</li>
            <li class:list={{ bad: uso.porEstado.fallidos > 0 }}><strong>{uso.porEstado.fallidos}</strong> no se entregaron</li>
            <li class:list={{ bad: uso.porEstado.bloqueados > 0 }}><strong>{uso.porEstado.bloqueados}</strong> sin permiso de la clienta</li>
          </ul>
          {real && <p class="muted wa-note">Estimado con tu tarifa: {formatCOP(uso.estimado)} ({uso.cobrados} × {fmtRate} pesos).</p>}
          {meta && 'error' in meta && <p class="muted wa-note">No se pudo leer el costo real en Meta ({meta.error}). Se muestra el estimado.</p>}
          {uso.porEvento.length > 0 && (
            <table class="wa-table">
              <caption class="sr-only">Mensajes enviados por tipo</caption>
              <thead>
                <tr>
                  <th scope="col">Mensaje</th>
                  <th scope="col">Enviados</th>
                  <th scope="col">Cobrados</th>
                </tr>
              </thead>
              <tbody>
                {uso.porEvento.map((v) => (
                  <tr>
                    <th scope="row">{EVENT_LABEL[v.event] ?? v.event}</th>
                    <td>{v.enviados}</td>
                    <td>{v.cobrados}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          {uso.enviados === 0 && <p class="muted wa-note">Este mes no salió ningún mensaje automático.</p>}
          {noSalieron.length > 0 && (
            <div class="wa-fail">
              <h4>Avisos que no le llegaron a la clienta</h4>
              <ul>
                {noSalieron.map(({ m, cita }) => (
                  <li>
                    <span>
                      <b>{EVENT_LABEL[m.event ?? 'libre'] ?? m.event}</b>
                      {cita ? ` · ${cita.customer_name}` : ''} · {fmtWhen.format(new Date(m.created_at))}
                      <small class="muted">{m.status === 'bloqueado' ? 'Sin permiso de la clienta' : (m.error ?? 'No se entregó')}</small>
                    </span>
                    {cita ? <a class="btn btn-soft btn-sm" href={citaLink(cita)}>Ver cita</a> : <span class="muted">Sin enlace a la cita</span>}
                  </li>
                ))}
              </ul>
              {uso.noSalieron.length > NO_SALIERON_MAX && <p class="muted wa-note">Y {uso.noSalieron.length - NO_SALIERON_MAX} más este mes.</p>}
            </div>
          )}
        </>
      )}
    </div>

    <form method="post" class="wa-set">
      <input type="hidden" name="form" value="wa" />
      <label class="field chk">
        <input type="checkbox" name="auto" checked={s.wa_auto_reminder !== false} />
        <span>Pedir confirmación sola el día antes (9:00 a. m.)</span>
      </label>
      <div class="field">
        <label for="wa-rate">Precio por mensaje cobrado (pesos)</label>
        <input id="wa-rate" name="rate" inputmode="decimal" value={fmtRate} maxlength="12" aria-describedby="wa-rate-h" />
        <small class="hint" id="wa-rate-h">Meta cobra cada plantilla de Utilidad en Colombia; mira tu tarifa en WhatsApp Manager → Facturación.</small>
      </div>
      <div class="field">
        <label for="wa-usd">Tasa del dólar (pesos)</label>
        <input id="wa-usd" name="usd" inputmode="numeric" value={fmtUsdCop} maxlength="12" aria-describedby="wa-usd-h" />
        <small class="hint" id="wa-usd-h">Para mostrar en pesos lo que cobra Meta si tu cuenta factura en dólares. Es un aproximado.</small>
      </div>
      <button class="btn btn-clay"><Icon name="check" /> Guardar</button>
    </form>
  </section>

  <div class="panel help">
    <p>
      Las palabras entre llaves se cambian solas por los datos de cada clienta:
      {PLACEHOLDERS.map((p) => <code>{`{${p}}`}</code>)}
    </p>
  </div>
  {
    NOTICE_EVENTS.map((e) => {
      const body = saved[e.id] ?? DEFAULT_TEMPLATES[e.id];
      const meta = META_TEMPLATES[e.id];
      const metaText = textoPlantilla(e.id, valuesFor(sampleData)).body;
      return (
        <form method="post" class="panel tpl" id={`m-${e.id}`}>
          <input type="hidden" name="event" value={e.id} />
          <div class="tpl-h">
            <h2>{e.label}</h2>
            <p class="muted">{e.when}</p>
          </div>
          <div class="tpl-in">
            <textarea name="body" rows="7" maxlength="1500" aria-label={`Mensaje: ${e.label}`}>{body}</textarea>
            <div class="bubble" aria-label="Así lo verá la clienta">
              <small>Vista previa</small>
              <p>{fillTemplate(body, sampleData)}</p>
            </div>
          </div>
          <div class="meta-tpl">
            <p class="meta-tag">
              <Icon name="check" size={14} /> Aprobada por WhatsApp · solo lectura
            </p>
            <p>{metaText}</p>
            {meta.buttons && <p class="muted">Botones: {meta.buttons.join(' · ')}</p>}
            <small class="muted">
              Plantilla <code>{tplPrefix}{e.id}</code>: es la que le llega a la clienta si no te ha escrito en las últimas 24 horas. El texto de arriba (editable y gratis) se usa cuando sí te escribió. Para cambiar la plantilla hay que aprobar una nueva en Meta.
            </small>
          </div>
          <div class="tpl-acts">
            {body !== DEFAULT_TEMPLATES[e.id] && (
              <button class="btn btn-soft btn-sm" name="reset" value="1">
                Volver al original
              </button>
            )}
            <button class="btn btn-clay">
              <Icon name="check" /> Guardar
            </button>
          </div>
        </form>
      );
    })
  }
</Admin>

<style>
  .wa {
    display: grid;
    gap: 1.2rem;
  }
  .wa h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .wa-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .wa-top p {
    margin: 0.25rem 0 0;
  }
  .wa-pill {
    flex: none;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--cream-2);
    color: var(--cocoa-2);
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .wa-pill.on {
    background: #dcefdc;
    color: #24572b;
  }
  .wa-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wa-steps li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.7rem 0.85rem;
    border-radius: 14px;
    background: var(--cream);
    font-weight: 600;
    min-width: 0;
  }
  .wa-steps small {
    display: block;
    font-weight: 400;
    overflow-wrap: anywhere;
  }
  .wa-dot {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    border: 2px solid var(--line);
    font-size: 0.8rem;
    color: #fff;
  }
  .wa-steps li.ok .wa-dot {
    border-color: #3f8a4a;
    background: #3f8a4a;
  }
  .wa-cost {
    display: grid;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--line);
  }
  .wa-month {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .wa-month h3 {
    flex: 1;
    margin: 0;
    text-align: center;
    font-size: 1.1rem;
  }
  .wa-month h3::first-letter {
    text-transform: uppercase;
  }
  .btn-icon-gap {
    width: 44px;
    flex: none;
  }
  .wa-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.6rem;
  }
  .wa-kpis p {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: var(--cream);
    min-width: 0;
  }
  .wa-kpis strong {
    font-size: 1.35rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .wa-kpis span {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .wa-note {
    margin: 0;
    font-size: 0.9rem;
  }
  .wa-states {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0.6rem 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
  }
  .wa-states .bad strong {
    color: #9c2a1a;
  }
  .wa-fail {
    margin-top: 1rem;
  }
  .wa-fail h4 {
    margin: 0 0 0.4rem;
    font-size: var(--t-sm);
  }
  .wa-fail ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wa-fail li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: var(--t-sm);
  }
  .wa-fail li small {
    display: block;
    overflow-wrap: anywhere;
  }
  .wa-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .wa-table th,
  .wa-table td {
    padding: 0.55rem 0.4rem;
    border-bottom: 1px dashed var(--line);
    text-align: right;
  }
  .wa-table th:first-child {
    text-align: left;
  }
  .wa-table thead th {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .wa-set {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: end;
    gap: 0.8rem 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--line);
  }
  .wa-set .chk {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    align-self: center;
  }
  .wa-set .chk input {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    accent-color: var(--clay);
  }
  .wa-set .field {
    min-width: 0;
  }
  @media (max-width: 760px) {
    .wa-set {
      grid-template-columns: 1fr;
    }
    .wa-set .btn {
      justify-content: center;
    }
  }
  .help p {
    margin: 0;
    line-height: 1.9;
  }
  .help code {
    margin: 0 0.15rem;
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--clay) 10%, transparent);
    font-size: 0.85em;
  }
  .tpl {
    display: grid;
    gap: 0.9rem;
  }
  .tpl-h h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .tpl-h p {
    margin: 0.2rem 0 0;
  }
  .tpl-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .tpl-in textarea {
    width: 100%;
    min-height: 11rem;
    resize: vertical;
    line-height: 1.5;
  }
  .meta-tpl {
    margin-top: 0.8rem;
    padding: 0.8rem 1rem;
    border: 1px dashed var(--line);
    border-radius: var(--r, 12px);
    background: var(--bg-soft, transparent);
  }
