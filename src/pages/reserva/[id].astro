---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { getAppointment, getSettings } from '../../lib/db';
import { prettyDate, prettyTime } from '../../lib/time';

const { id = '' } = Astro.params;
const appt = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id) ? await getAppointment(id) : null;
if (!appt) return Astro.redirect('/reservar', 303);
const s = await getSettings();

const stamp = (iso: string) => iso.replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const gcal = `https://calendar.google.com/calendar/render?${new URLSearchParams({
  action: 'TEMPLATE',
  text: `${appt.service_name} con ${s.business_name}`,
  dates: `${stamp(appt.starts_at)}/${stamp(appt.ends_at)}`,
  location: s.address,
  details: `Cita en ${s.business_name}. WhatsApp: +${s.whatsapp}`,
})}`;
const wa = `https://wa.me/${s.whatsapp}?text=${encodeURIComponent(
  `¡Hola Betsy! Soy ${appt.customer_name}. Acabo de agendar ${appt.service_name} para el ${prettyDate(appt.starts_at)} a las ${prettyTime(appt.starts_at)} ✨`,
)}`;
const cancelled = appt.status === 'cancelada';

// Talón del boleto: día y mes en hora de Colombia
const tz = 'America/Bogota';
const day = new Intl.DateTimeFormat('es-CO', { timeZone: tz, day: 'numeric' }).format(new Date(appt.starts_at));
const month = new Intl.DateTimeFormat('es-CO', { timeZone: tz, month: 'short' }).format(new Date(appt.starts_at)).replace('.', '');
const code = appt.id.slice(0, 8).toUpperCase();

// Archivo .ics para cualquier app de calendario (Apple, Outlook, Google)
const esc = (v: string) => v.replace(/\\/g, '\\\\').replace(/\r?\n/g, '\\n').replace(/([,;])/g, '\\$1');
const ics = [
  'BEGIN:VCALENDAR',
  'VERSION:2.0',
  'PRODID:-//Betsy Peinados//Reservas//ES',
  'CALSCALE:GREGORIAN',
  'METHOD:PUBLISH',
  'BEGIN:VEVENT',
  `UID:${appt.id}@betsypeinados`,
  `DTSTAMP:${stamp(new Date().toISOString())}`,
  `DTSTART:${stamp(new Date(appt.starts_at).toISOString())}`,
  `DTEND:${stamp(new Date(appt.ends_at).toISOString())}`,
  `SUMMARY:${esc(`${appt.service_name} con ${s.business_name}`)}`,
  `DESCRIPTION:${esc(`Cita en ${s.business_name}. WhatsApp: +${s.whatsapp}`)}`,
  `LOCATION:${esc(s.address)}`,
  'END:VEVENT',
  'END:VCALENDAR',
].join('\r\n');
const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
---

<Base title={`Cita ${cancelled ? 'cancelada' : 'confirmada'} · ${s.business_name}`} description="Detalle de tu cita." noindex>
  <Header minimal />
  <main id="contenido" class="wrap ok">
    <div class="intro">
      <div class:list={['seal', { off: cancelled }]} aria-hidden="true"><Icon name={cancelled ? 'close' : 'check'} size={30} /></div>
      <h1>{cancelled ? 'Esta cita fue cancelada' : <>¡Tu cita está <em>confirmada</em>!</>}</h1>
      <p class="lead">
        {cancelled ? 'Si quieres reprogramar, agenda un nuevo horario.' : `Gracias, ${appt.customer_name.split(' ')[0]}. Te espero para dejarte espectacular.`}
      </p>
    </div>

    <article class:list={['ticket', { off: cancelled }]} aria-label="Resumen de tu cita">
      <div class="stub" aria-hidden="true">
        <small>{month}</small>
        <strong>{day}</strong>
        <small class="stub-time">{prettyTime(appt.starts_at)}</small>
      </div>
      <div class="tbody">
        <svg class="press" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="press-ring" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0"></path></defs>
          <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="3"></circle>
          <circle cx="60" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <text><textPath href="#press-ring" textLength="270">{cancelled ? 'CANCELADA • BETSY PEINADOS •' : 'CONFIRMADA • BETSY PEINADOS •'}</textPath></text>
          <text x="60" y="68" text-anchor="middle" class="press-b">B</text>
        </svg>
        <p class="t-kicker">Reserva #{code}</p>
        <h2>{appt.service_name}</h2>
        <dl>
          <div><dt>Fecha</dt><dd class="cap">{prettyDate(appt.starts_at)}</dd></div>
          <div><dt>Hora</dt><dd>{prettyTime(appt.starts_at)}</dd></div>
          <div><dt>Lugar</dt><dd>{s.address}</dd></div>
          <div><dt>A nombre de</dt><dd>{appt.customer_name}</dd></div>
        </dl>
      </div>
    </article>

    {
      !cancelled && (
        <div class="cta">
          <a class="btn btn-clay" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> Avisar por WhatsApp</a>
          <a class="btn btn-ghost" href={gcal} target="_blank" rel="noopener"><Icon name="google" /> Google Calendar</a>
          <a class="btn btn-ghost" href={icsHref} download={`cita-betsy-${code.toLowerCase()}.ics`}><Icon name="calendar" /> Descargar .ics</a>
        </div>
      )
    }
    {cancelled && <div class="cta"><a class="btn btn-clay" href="/reservar">Agendar de nuevo</a></div>}
    <p class="small">¿Necesitas cambiar o cancelar? Escríbeme por WhatsApp con al menos 24 horas de anticipación.</p>
  </main>
</Base>

<style>
  .ok {
    max-width: 680px;
    padding: 1.5rem 0 5rem;
    text-align: center;
  }
  .seal {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin: 0 auto 1.2rem;
    border-radius: 46% 54% 60% 40% / 45% 45% 55% 55%;
    background: var(--sage);
    color: var(--white);
    animation: pop 0.7s var(--ease);
  }
  .seal.off {
    background: var(--muted);
  }
  @keyframes pop {
    from {
      transform: scale(0.4) rotate(-20deg);
      opacity: 0;
    }
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    margin-inline: auto;
  }

  /* Boleto perforado (inspirado en el componente "Meeting Booking Calendar" de 21st.dev) */
  .ticket {
    --stub: 116px;
    position: relative;
    display: grid;
    grid-template-columns: var(--stub) minmax(0, 1fr);
    margin: 2.2rem 0 1.8rem;
    text-align: left;
    border-radius: 26px;
    filter: drop-shadow(0 26px 40px rgb(42 28 22 / 0.18));
    -webkit-mask:
      radial-gradient(circle 13px at var(--stub) 0, transparent 97%, #000 100%) top / 100% 51% no-repeat,
      radial-gradient(circle 13px at var(--stub) 100%, transparent 97%, #000 100%) bottom / 100% 51% no-repeat;
    mask:
      radial-gradient(circle 13px at var(--stub) 0, transparent 97%, #000 100%) top / 100% 51% no-repeat,
      radial-gradient(circle 13px at var(--stub) 100%, transparent 97%, #000 100%) bottom / 100% 51% no-repeat;
    animation: ticket-in 0.9s var(--ease) 0.15s both;
  }
  @keyframes ticket-in {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(-1.5deg);
    }
  }
  .stub {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    padding: 1.6rem 0.5rem;
    border-radius: 26px 0 0 26px;
    border-right: 2px dashed rgb(255 250 244 / 0.35);
    background: linear-gradient(160deg, var(--clay), var(--clay-deep));
    color: var(--white);
  }
  .ticket.off .stub {
    background: linear-gradient(160deg, var(--muted), var(--cocoa-2));
  }
  .stub small {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .stub strong {
    font-family: var(--font-display);
    font-size: 3.6rem;
    font-weight: 500;
    line-height: 1;
  }
  .tbody {
    position: relative;
    overflow: hidden;
    padding: 1.6rem 1.6rem 1.3rem 1.7rem;
    border-radius: 0 26px 26px 0;
    background: var(--white);
  }
  .press {
    position: absolute;
    overflow: hidden;
    right: 0.9rem;
    top: 0.7rem;
    width: 104px;
    height: 104px;
    color: var(--clay);
    opacity: 0.85;
    transform: rotate(-14deg);
    mix-blend-mode: multiply;
    pointer-events: none;
    animation: press 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.85s both;
  }
  .ticket.off .press {
    color: var(--muted);
  }
  @keyframes press {
    from {
      opacity: 0;
      transform: rotate(-30deg) scale(1.9);
    }
  }
  .press text {
    fill: currentColor;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .press .press-b {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    letter-spacing: 0;
  }
  .t-kicker {
    margin: 0 0 0.3rem;
    padding-right: 100px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .tbody h2 {
    margin: 0 0 0.9rem;
    padding-right: 100px;
    font-size: clamp(1.7rem, 4vw, 2.2rem);
  }
  dl {
    margin: 0;
    display: grid;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px dashed var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 0.92rem;
  }
  dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .cap::first-letter {
    text-transform: uppercase;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }
  .small {
    margin: 1.5rem auto 0;
    max-width: 44ch;
    font-size: 0.88rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .ticket {
      --stub: 86px;
    }
    .stub strong {
      font-size: 2.6rem;
    }
    .stub-time {
      display: none;
    }
    .tbody {
      padding: 1.3rem 1.1rem 1.1rem 1.2rem;
    }
    .press {
      width: 78px;
      height: 78px;
      right: 0.4rem;
    }
    .t-kicker,
    .tbody h2 {
      padding-right: 70px;
    }
    dl div {
      flex-direction: column;
      gap: 0.1rem;
    }
    dd {
      text-align: left;
    }
    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
