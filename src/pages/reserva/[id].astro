---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { getAppointment, getService, getSettings, saveReceipt } from '../../lib/db';
import { publicStorageUrl } from '../../lib/supabase';
import { limited } from '../../lib/http';
import { DEPOSIT_PCT, POLICIES, hairLabel } from '../../lib/defaults';
import { cupoLiberado, plazoDeAbono, resumenDeCita, tiempoRestante } from '../../lib/cita';
import { formatCOP, localDate, prettyDate, prettyTime } from '../../lib/time';

const { id = '' } = Astro.params;
const appt = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id) ? await getAppointment(id) : null;
if (!appt) return Astro.redirect('/reservar', 303);

// La clienta sube el comprobante del abono desde esta misma página.
let upMsg = Astro.url.searchParams.has('subido') ? '¡Comprobante recibido! Te abrimos WhatsApp para que se lo envíes a Betsy.' : '';
let upErr = false;
if (Astro.request.method === 'POST') {
  upErr = true;
  if (await limited(Astro.request, Astro.clientAddress, 'receipt', 6, 3600)) upMsg = 'Has intentado varias veces. Envíalo por WhatsApp, por favor.';
  else if (appt.status !== 'pendiente') upMsg = 'Esta cita ya no está esperando abono.';
  else {
    const f = (await Astro.request.formData()).get('receipt');
    if (!(f instanceof File) || f.size === 0) upMsg = 'Elige la foto o el PDF del comprobante.';
    else if (f.size > 4 * 1024 * 1024) upMsg = 'El archivo pesa más de 4 MB. Prueba con una captura de pantalla.';
    else if (!['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'application/pdf'].includes(f.type)) upMsg = 'Sube una foto (JPG, PNG) o un PDF.';
    else {
      try {
        if (await saveReceipt(appt, f)) return Astro.redirect(`${Astro.url.pathname}?subido=1`, 303);
        upMsg = 'Esta cita ya no está esperando abono. Escríbeme por WhatsApp y lo miramos.';
      } catch (e) {
        console.error('Comprobante', e);
        upMsg = 'No pudimos subir el archivo. Envíalo por WhatsApp, por favor.';
      }
    }
  }
}
const [s, service] = await Promise.all([getSettings(), appt.service_id ? getService(appt.service_id) : null]);
const pending = appt.status === 'pendiente';
const resumen = resumenDeCita(appt, service);
const { price, deposit, saldo, travel } = resumen;
const plazo = plazoDeAbono(appt);
const queda = plazo ? tiempoRestante(plazo, new Date()) : null;
const released = cupoLiberado(appt);
const place = appt.home_service && appt.home_address ? appt.home_address : s.address;
const qr = s.pay_qr_path ? publicStorageUrl(s.pay_qr_path) : null;
const hasReceipt = Boolean(appt.receipt_path);

const stamp = (iso: string) => iso.replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const gcal = `https://calendar.google.com/calendar/render?${new URLSearchParams({
  action: 'TEMPLATE',
  text: `${appt.service_name} con ${s.business_name}`,
  dates: `${stamp(appt.starts_at)}/${stamp(appt.ends_at)}`,
  location: s.address,
  details: `Cita en ${s.business_name}. WhatsApp: +${s.whatsapp}`,
})}`;
// Sin WhatsApp automático: la clienta le manda a Betsy, desde su propio WhatsApp, la cita completa
// y el enlace al comprobante (un toque: abre el chat de Betsy con el mensaje escrito).
const origin = Astro.url.origin;
const firstName = appt.customer_name.split(' ')[0];
const lines = [
  `¡Hola Betsy! Soy ${appt.customer_name} y acabo de reservar en la web ✨`,
  '',
  `• Servicio: ${appt.service_name}`,
  `• Fecha: ${prettyDate(appt.starts_at)}`,
  `• Hora: ${prettyTime(appt.starts_at)}`,
  appt.home_service && appt.home_address ? `• Domicilio: ${appt.home_address}` : null,
  appt.hair_length ? `• Largo: ${hairLabel(appt.hair_length)}` : null,
  price != null ? `• Valor${resumen.exacto ? '' : ' desde'}: ${formatCOP(price)}` : null,
  deposit ? `• Abono (${DEPOSIT_PCT}%): ${formatCOP(deposit)}` : null,
  `• Reserva #${appt.id.slice(0, 8).toUpperCase()}`,
  '',
  hasReceipt ? `Comprobante del abono: ${origin}/reserva/${appt.id}/comprobante` : `Ya te transfiero el abono del ${DEPOSIT_PCT}% y te envío el comprobante.`,
  `Ver la cita en tu panel: ${origin}/admin?desde=${localDate(new Date(appt.starts_at))}&abrir=${appt.id}`,
].filter((l) => l !== null);
const wa = `https://wa.me/${s.whatsapp}?text=${encodeURIComponent(
  pending ? lines.join('\n') : `¡Hola Betsy! Soy ${firstName}. Tengo cita de ${appt.service_name} para el ${prettyDate(appt.starts_at)} a las ${prettyTime(appt.starts_at)} ✨`,
)}`;
const cancelled = appt.status === 'cancelada';

// Talón del boleto: día y mes en hora de Colombia
const tz = 'America/Bogota';
const day = new Intl.DateTimeFormat('es-CO', { timeZone: tz, day: 'numeric' }).format(new Date(appt.starts_at));
const month = new Intl.DateTimeFormat('es-CO', { timeZone: tz, month: 'short' }).format(new Date(appt.starts_at)).replace('.', '');
const code = appt.id.slice(0, 8).toUpperCase();

// Archivo .ics para cualquier app de calendario (Apple, Outlook, Google)
const esc = (v: string) => v.replace(/\\/g, '\\\\').replace(/\r?\n/g, '\\n').replace(/([,;])/g, '\\$1');
const ics = [
  'BEGIN:VCALENDAR',
  'VERSION:2.0',
  'PRODID:-//Betsy Peinados//Reservas//ES',
  'CALSCALE:GREGORIAN',
  'METHOD:PUBLISH',
  'BEGIN:VEVENT',
  `UID:${appt.id}@betsypeinados`,
  `DTSTAMP:${stamp(new Date().toISOString())}`,
  `DTSTART:${stamp(new Date(appt.starts_at).toISOString())}`,
  `DTEND:${stamp(new Date(appt.ends_at).toISOString())}`,
  `SUMMARY:${esc(`${appt.service_name} con ${s.business_name}`)}`,
  `DESCRIPTION:${esc(`Cita en ${s.business_name}. WhatsApp: +${s.whatsapp}`)}`,
  `LOCATION:${esc(s.address)}`,
  'END:VEVENT',
  'END:VCALENDAR',
].join('\r\n');
const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
---

<Base title={`Cita ${cancelled ? 'cancelada' : pending ? 'apartada' : 'confirmada'} · ${s.business_name}`} description="Detalle de tu cita." noindex>
  <Header minimal />
  <main id="contenido" class="wrap ok">
    <div class="intro">
      <div class:list={['seal', { off: cancelled, wait: pending }]} aria-hidden="true"><Icon name={cancelled ? 'close' : pending ? 'clock' : 'check'} size={30} /></div>
      <h1>{cancelled ? 'Esta cita fue cancelada' : pending ? <>¡Tu cupo está <em>apartado</em>!</> : <>¡Tu cita está <em>confirmada</em>!</>}</h1>
      <p class="lead">
        {
          cancelled
            ? released
              ? 'Tu cupo se liberó porque no recibimos el comprobante del abono a tiempo. Si aún quieres tu cita, agenda un nuevo horario o escríbeme por WhatsApp.'
              : 'Si quieres reprogramar, agenda un nuevo horario.'
            : pending
              ? hasReceipt
                ? `Gracias, ${appt.customer_name.split(' ')[0]}. Ya recibimos tu comprobante: Betsy lo revisa y esta página cambia sola cuando confirme tu cita.`
                : `Gracias, ${appt.customer_name.split(' ')[0]}. Transfiere el abono del ${DEPOSIT_PCT}%${deposit ? ` (${formatCOP(deposit)})` : ''} y sube el comprobante para confirmar tu cita.`
              : `Gracias, ${appt.customer_name.split(' ')[0]}. Te espero para dejarte espectacular.`
        }
      </p>
    </div>


    {
      pending && (
        <section class="pay" aria-labelledby="pay-t">
          {upMsg && (
            <p class:list={['notice', upErr ? 'error' : 'ok']} role="status">
              {upMsg}
            </p>
          )}
          {!hasReceipt && appt.receipt_rejected_reason && (
            <p class="notice error" role="alert">
              Betsy no pudo validar tu comprobante: <b>{appt.receipt_rejected_reason}</b>. Súbelo de nuevo para confirmar tu cita.
            </p>
          )}
          {!hasReceipt && (
            <>
              {plazo && (
                <p class="pay-deadline" role="note">
                  <Icon name="clock" size={16} />
                  {queda ? (
                    <span>
                      Te quedan <b>{queda}</b> para enviar el comprobante (hasta el {prettyDate(plazo.toISOString()).toLowerCase()} a las {prettyTime(plazo.toISOString())}). Después el cupo se libera.
                    </span>
                  ) : (
                    <span>El plazo para enviar el comprobante ya venció y el cupo se liberará en unos minutos. Si ya transferiste, súbelo ahora o escríbeme por WhatsApp.</span>
                  )}
                </p>
              )}
              <p class="pay-step">Paso 1 · Transfiere</p>
              <p class="pay-txt">
                Escanea el QR o usa la llave desde Nequi, Bancolombia, Daviplata o tu banco. Escribe <b>{code}</b> en la descripción.
              </p>
              <div class:list={['pay-grid', { noqr: !qr }]}>
                {qr && <img class="pay-qr" src={qr} alt="Código QR para transferir el abono" width="160" height="160" />}
                <div class="pay-data">
                  <div>
                    <p class="pay-lbl">Valor a transferir ({DEPOSIT_PCT}%)</p>
                    <p id="pay-t" class="pay-amount">{deposit ? formatCOP(deposit) : `${DEPOSIT_PCT}% del valor`}</p>
                    {!deposit && <p class="pay-hint">Betsy te confirma el valor exacto por WhatsApp.</p>}
                  </div>
                  {s.pay_key ? (
                    <div>
                      <p class="pay-lbl">{s.pay_bank ? `Llave · ${s.pay_bank}` : 'Llave Bre-B'}</p>
                      <div class="pay-key">
                        <code data-key>{s.pay_key}</code>
                        <button type="button" class="btn btn-ghost btn-sm" data-copy>
                          Copiar
                        </button>
                      </div>
                      {s.pay_holder && <p class="pay-lbl">A nombre de {s.pay_holder}</p>}
                    </div>
                  ) : (
                    !qr && <p class="pay-hint">Betsy te comparte los datos para transferir por WhatsApp.</p>
                  )}
                </div>
              </div>
              <p class="pay-step step2">Paso 2 · Sube el comprobante</p>
              <form method="post" enctype="multipart/form-data" class="pay-up" data-up>
                <label class="btn btn-clay pay-file">
                  <Icon name="upload" /> <span data-file-label>Adjuntar comprobante</span>
                  <input type="file" name="receipt" accept="image/*,application/pdf" required data-file />
                </label>
              </form>
              <p class="pay-hint center" data-up-msg role="status" aria-live="polite">
                Foto o PDF de la transferencia. Después te dejamos el mensaje listo para enviárselo a Betsy por WhatsApp.
              </p>
            </>
          )}
          {hasReceipt && (
            <>
              <p class="pay-wait">
                <span class="dot" aria-hidden="true" /> Comprobante en revisión. Esta página cambia sola cuando Betsy confirme tu cita.
              </p>
            </>
          )}
        </section>
      )
    }

    <article
      class:list={['ticket', { off: cancelled }]}
      aria-label="Resumen de tu cita"
      data-status-watch={cancelled || appt.status === 'completada' ? undefined : appt.id}
      data-firma={resumen.firma}
      data-every={appt.status === 'pendiente' ? 15 : 60}
    >
      <div class="stub" aria-hidden="true">
        <small>{month}</small>
        <strong>{day}</strong>
        <small class="stub-time">{prettyTime(appt.starts_at)}</small>
      </div>
      <div class="tbody">
        <svg class="press" viewBox="0 0 120 120" aria-hidden="true">
          <defs><path id="press-ring" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0"></path></defs>
          <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="3"></circle>
          <circle cx="60" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <text><textPath href="#press-ring" textLength="270">{cancelled ? 'CANCELADA • BETSY PEINADOS •' : pending ? 'EN ESPERA • BETSY PEINADOS •' : 'CONFIRMADA • BETSY PEINADOS •'}</textPath></text>
          <text x="60" y="68" text-anchor="middle" class="press-b">B</text>
        </svg>
        <p class="t-kicker">Reserva #{code}</p>
        <h2>{appt.service_name}</h2>
        <dl>
          <div><dt>Fecha</dt><dd class="cap">{prettyDate(appt.starts_at)}</dd></div>
          <div><dt>Hora</dt><dd>{prettyTime(appt.starts_at)}</dd></div>
          <div><dt>{appt.home_service ? 'Domicilio' : 'Lugar'}</dt><dd>{place}</dd></div>
          {appt.hair_length && <div><dt>Largo</dt><dd>{hairLabel(appt.hair_length)}</dd></div>}
          {price != null && <div><dt>{resumen.exacto ? 'Valor' : 'Valor desde'}</dt><dd>{formatCOP(price)}{travel > 0 && <small class="t-sub">incluye desplazamiento {formatCOP(travel)}</small>}</dd></div>}
          {resumen.abono && <div><dt>{resumen.abono === 'pagado' ? 'Abono pagado' : 'Abono a pagar'}</dt><dd>{formatCOP(deposit)}</dd></div>}
          {saldo != null && <div><dt>Saldo el día de la cita</dt><dd>{formatCOP(saldo)}</dd></div>}
          {pending && <div><dt>Estado</dt><dd>{hasReceipt ? 'Comprobante en revisión' : 'Esperando abono'}</dd></div>}
          <div><dt>A nombre de</dt><dd>{appt.customer_name}</dd></div>
        </dl>
      </div>
    </article>

    {
      !cancelled && (
        <div class="cta">
          {!pending && <a class="btn btn-clay" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> Escribir por WhatsApp</a>}
          <a class="btn btn-ghost" href={gcal} target="_blank" rel="noopener"><Icon name="google" /> Google Calendar</a>
          <a class="btn btn-ghost" href={icsHref} download={`cita-betsy-${code.toLowerCase()}.ics`}><Icon name="calendar" /> Descargar .ics</a>
        </div>
      )
    }
    {cancelled && <div class="cta"><a class="btn btn-clay" href="/reservar">Agendar de nuevo</a></div>}
    {
      !cancelled && (
        <ul class="rules">
          {POLICIES.map((x) => <li>{x}</li>)}
        </ul>
      )
    }
    <p class="small">¿Necesitas cambiar la fecha? Escríbeme por WhatsApp con al menos 24 horas de anticipación.</p>
    {
      pending && (
        <aside class="pin" aria-labelledby="pin-t" data-pin data-auto={upMsg && !upErr && hasReceipt ? '1' : undefined}>
          <details class="pin-in" open={hasReceipt ? true : undefined}>
            <summary>
              <span class="pin-ico" aria-hidden="true"><Icon name="whatsapp" size={18} /></span>
              <span id="pin-t" class="pin-t">{hasReceipt ? 'Envíale tu comprobante a Betsy' : 'Tu mensaje para Betsy'}</span>
              <span class="pin-more" aria-hidden="true">▾</span>
            </summary>
            <div class="pin-bubble">
              {lines.map((l) => (l ? <p>{l}</p> : <br />))}
            </div>
          </details>
          <div class="pin-acts">
            <a class="btn btn-wa-big" href={wa} target="_blank" rel="noopener" data-send-betsy>
              <Icon name="whatsapp" /> {hasReceipt ? 'Enviar a Betsy' : 'Escribirle a Betsy'}
            </a>
            {hasReceipt && (
              <button type="button" class="btn btn-ghost pin-photo" data-share-photo data-src={`/reserva/${appt.id}/comprobante`} hidden>
                Enviar también la foto
              </button>
            )}
          </div>
        </aside>
      )
    }
  </main>
</Base>

<script>
  // Copiar la llave
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(document.querySelector('[data-key]')?.textContent?.trim() ?? '');
      copy.textContent = '¡Copiada!';
      setTimeout(() => (copy.textContent = 'Copiar'), 2000);
    } catch {
      /* sin portapapeles */
    }
  });
  // Adjuntar comprobante: se envía apenas se elige el archivo.
  // Vercel rechaza peticiones de más de ~4,5 MB y una foto de celular suele pasarlas,
  // así que las fotos se reducen aquí (JPEG de 1800 px, legible y de pocos cientos de KB).
  const MAX = 4 * 1024 * 1024;
  const shrink = async (f: File): Promise<File> => {
    if (!f.type.startsWith('image/') || f.size < 1024 * 1024) return f;
    try {
      const img = await createImageBitmap(f);
      const k = Math.min(1, 1800 / Math.max(img.width, img.height));
      const c = document.createElement('canvas');
      c.width = Math.round(img.width * k);
      c.height = Math.round(img.height * k);
      c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height);
      const blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', 0.85));
      if (!blob || blob.size >= f.size) return f;
      return new File([blob], f.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' });
    } catch {
      return f; // el navegador no sabe abrirla (p. ej. HEIC fuera de Safari): se envía tal cual
    }
  };
  const file = document.querySelector<HTMLInputElement>('[data-file]');
  file?.addEventListener('change', async () => {
    const original = file.files?.[0];
    if (!original) return;
    const msg = document.querySelector<HTMLElement>('[data-up-msg]')!;
    const label = document.querySelector('[data-file-label]')!;
    label.textContent = 'Subiendo…';
    file.closest('label')!.classList.add('busy');
    let f = await shrink(original);
    if (f !== original) {
      try {
        const dt = new DataTransfer();
        dt.items.add(f);
        file.files = dt.files;
      } catch {
        f = original; // navegador viejo sin DataTransfer: va el original si cabe
      }
    }
    if (f.size > MAX) {
      label.textContent = 'Adjuntar comprobante';
      file.closest('label')!.classList.remove('busy');
      file.value = '';
      msg.textContent = 'El archivo pesa más de 4 MB. Prueba con una captura de pantalla o envíalo por WhatsApp.';
      return;
    }
    msg.textContent = original.name;
    document.querySelector<HTMLFormElement>('[data-up]')!.submit();
  });
  // Mensaje fijado para Betsy: tras subir el comprobante se abre WhatsApp de una vez con todo escrito.
  const pin = document.querySelector<HTMLElement>('[data-pin]');
  const sendLink = pin?.querySelector<HTMLAnchorElement>('[data-send-betsy]');
  if (pin?.dataset.auto && sendLink) {
    const u = new URL(location.href);
    u.searchParams.delete('subido');
    history.replaceState(null, '', u.pathname + u.search);
    setTimeout(() => location.assign(sendLink.href), 900);
  }
  // En celulares que lo permiten, también se puede mandar la foto misma (se elige el chat de Betsy).
  const photoBtn = pin?.querySelector<HTMLButtonElement>('[data-share-photo]');
  if (photoBtn && 'canShare' in navigator) {
    fetch(photoBtn.dataset.src!, { cache: 'no-store' })
      .then((r) => (r.ok ? r.blob() : null))
      .then((b) => {
        if (!b) return;
        const ext = b.type === 'application/pdf' ? 'pdf' : b.type.split('/')[1] || 'jpg';
        const f = new File([b], `comprobante.${ext}`, { type: b.type });
        if (!navigator.canShare({ files: [f] })) return;
        photoBtn.hidden = false;
        photoBtn.addEventListener('click', () => navigator.share({ files: [f], title: 'Comprobante del abono' }).catch(() => {}));
      })
      .catch(() => {});
  }
  // Cuando Betsy confirme el abono o ajuste el valor, la página se actualiza sola
  // (cada 15 s mientras espera el abono; cada minuto después, para no agotar el límite de consultas).
  const watch = document.querySelector<HTMLElement>('[data-status-watch]');
  if (watch) {
    const id = watch.dataset.statusWatch!;
    const tick = async () => {
      if (document.hidden) return;
      try {
        const r = await fetch(`/api/estado?id=${id}`, { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const j = await r.json();
        if (j.firma && j.firma !== watch.dataset.firma) location.replace(location.pathname);
      } catch {
        /* sin conexión: se reintenta */
      }
    };
    setInterval(tick, Number(watch.dataset.every) * 1000);
    document.addEventListener('visibilitychange', tick);
  }
</script>

<style>
  .pay-deadline {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin: 0 0 1rem;
    text-align: left;
  }
  .t-sub {
    display: block;
    font-size: 0.8em;
    font-weight: 400;
    opacity: 0.75;
  }
  .ok {
    max-width: 680px;
    padding: 1.5rem 0 5rem;
    text-align: center;
  }
  .seal {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin: 0 auto 1.2rem;
    border-radius: 46% 54% 60% 40% / 45% 45% 55% 55%;
    background: var(--sage);
    color: var(--white);
    animation: pop 0.7s var(--ease);
  }
  .seal.off {
    background: var(--muted);
  }
  .seal.wait {
    background: #c39a2e;
  }
  .pay {
    max-width: 560px;
    margin: 0 auto 1.8rem;
    padding: 1.4rem;
    border-radius: 24px;
    background: var(--white, #fff);
    box-shadow: var(--shadow);
    text-align: left;
  }
  .pay .notice {
    margin: 0 0 1rem;
  }
  .pay-step {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .pay-step.step2 {
    margin-top: 1.4rem;
  }
  .pay-txt {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted, #7a6a60);
  }
  .pay-amount {
    margin: 0.1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 7vw, 2.3rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--clay);
  }
  .pay-grid {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
  }
  .pay-grid.noqr {
    grid-template-columns: 1fr;
  }
  .pay-qr {
    width: 160px;
    height: 160px;
    object-fit: contain;
    padding: 6px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line, #eadccf);
  }
  .pay-data {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }
  .pay-lbl {
