---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import HeroArt from '../components/HeroArt.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { getGallery, getHours, getServices, getSettings } from '../lib/db';
import { FAQ, WEEKDAYS } from '../lib/defaults';
import { formatCOP, formatDuration } from '../lib/time';
import { businessJsonLd, faqJsonLd } from '../lib/seo';

const [s, services, hours, gallery] = await Promise.all([getSettings(), getServices(), getHours(), getGallery()]);

// Caché en el CDN: la página se regenera cada 5 minutos (los cambios del panel se ven rápido).
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');

const wa = (text: string) => `https://wa.me/${s.whatsapp}?text=${encodeURIComponent(text)}`;
const hero = gallery[0] ?? null;
const hero2 = gallery[1] ?? null;
const shown = gallery.slice(0, 9);
const pad = (n: number) => String(n).padStart(2, '0');
const placeholders = [
  { label: 'Ondas', k: 't1' },
  { label: 'Quinceañeras', k: 't2' },
  { label: 'Coletas', k: 't3' },
  { label: 'Niñas', k: 't4' },
  { label: 'Recogidos', k: 't5' },
  { label: 'Novias', k: 't6' },
];
const hourRows = [1, 2, 3, 4, 5, 6, 0].map((d) => hours.find((h) => h.weekday === d)!).filter(Boolean);
const marquee = ['Ondas', 'Quinceañeras', 'Coletas', 'Niñas', 'Recogidos', 'Novias', 'Grados', 'Maquillaje + peinado'];

const title = `${s.business_name} · Peinados para grados, bodas y eventos en ${s.city}`;
const description = `Peinados profesionales en ${s.city}: ondas, recogidos, rizos definidos y combos de maquillaje. Agenda tu cita online en segundos con ${s.business_name}.`;
---

<Base title={title} description={description} image={hero?.url} jsonLd={[businessJsonLd(s, services, hours, Astro.site), faqJsonLd(FAQ)]}>
  <Header />
  <main id="contenido">
    <!-- ───────── HERO ───────── -->
    <section class="hero">
      <svg class="hero-line" viewBox="0 0 1400 700" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-40 520C160 380 300 640 520 520S820 240 1010 360s300 60 440-120" pathLength="1" />
        <path d="M-40 580C200 460 330 690 560 570S860 300 1040 420s280 40 420-110" pathLength="1" />
      </svg>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow reveal">{s.city} · Peinados de autor</p>
          <h1 class="reveal" data-delay="1">
            {s.hero_title.split(' ').slice(0, -1).join(' ')} <em>{s.hero_title.split(' ').slice(-1)}</em>
          </h1>
          <p class="lead reveal" data-delay="2">{s.hero_subtitle}</p>
          <div class="hero-cta reveal" data-delay="3">
            <a href="/reservar" class="btn btn-clay">
              <Icon name="calendar" /> Reservar mi cita
            </a>
            <a href={wa('¡Hola Betsy! Quiero información sobre un peinado ✨')} class="btn btn-ghost" target="_blank" rel="noopener">
              <Icon name="whatsapp" /> Escribir por WhatsApp
            </a>
          </div>
          <ul class="perks reveal" data-delay="3" aria-label="Lo que encuentras aquí">
            <li>
              <span class="perk-ic"><Icon name="calendar" size={18} /></span>
              <span><strong>Reserva online</strong>a cualquier hora</span>
            </li>
            <li>
              <span class="perk-ic"><Icon name="sparkle" size={18} /></span>
              <span><strong>Grados, novias</strong>y eventos</span>
            </li>
            {
              s.home_service && (
                <li>
                  <span class="perk-ic"><Icon name="home" size={18} /></span>
                  <span><strong>A domicilio</strong>en {s.city}</span>
                </li>
              )
            }
          </ul>
        </div>
        <div class="hero-art reveal" data-delay="2">
          <HeroArt photo={hero?.url} alt={hero?.alt} photo2={hero2?.url} alt2={hero2?.alt} />
        </div>
      </div>
    </section>

    <!-- ───────── CINTAS ───────── -->
    <div class="ribbons" aria-hidden="true">
      <div class="ribbon back">
        <div class="track rev">
          {[...marquee, ...marquee].map((m) => <span>{m}<Icon name="sparkle" size={16} /></span>)}
        </div>
      </div>
      <div class="ribbon front">
        <div class="track">
          {[...marquee, ...marquee].map((m) => <span>{m}<Icon name="sparkle" size={18} /></span>)}
        </div>
      </div>
    </div>

    <!-- ───────── SERVICIOS ───────── -->
    <section id="servicios" class="section">
      <div class="wrap">
        <div class="head">
          <div>
            <p class="eyebrow reveal">Servicios</p>
            <h2 class="reveal">Un peinado para cada <em>momento</em></h2>
          </div>
          <p class="lead reveal">Elige tu servicio, reserva el horario que te quede mejor y llega tranquila: yo me encargo del resto.</p>
        </div>
        <ul class="services">
          {
            services.map((sv, i) => (
              <li class:list={['service reveal', { featured: sv.featured }]} data-delay={String(i % 3)}>
                <div class="service-top">
                  <span class="idx" aria-hidden="true">{pad(i + 1)}</span>
                  <span class="cat">{sv.category}</span>
                </div>
                <h3>{sv.name}</h3>
                <p>{sv.description}</p>
                <div class="meta">
                  <div class="meta-info">
                    <span class="dur">
                      <Icon name="clock" size={15} /> {formatDuration(sv.duration_min)}
                    </span>
                    <span class="price">
                      {sv.price_from != null && <small>desde</small>} {formatCOP(sv.price_from)}
                    </span>
                  </div>
                  <a href={`/reservar?servicio=${sv.slug}`} class="service-link">
                    <span class="sr-only">Reservar {sv.name}</span>
                    <Icon name="arrow" size={20} />
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ───────── A DOMICILIO ───────── -->
    {
      s.home_service && (
        <section id="domicilio" class="home-sec on-dark">
          <span class="glow g-a" aria-hidden="true" />
          <span class="glow g-b" aria-hidden="true" />
          <div class="wrap home-grid">
            <div>
              <p class="eyebrow reveal">Servicio a domicilio</p>
              <h2 class="reveal">Voy hasta tu <em>casa</em></h2>
              <p class="lead reveal">
                ¿Te estás arreglando con tu familia o tus damas de honor? Llevo todo lo necesario para peinarte donde estés en {s.city}, para
                que te prepares con calma y sin desplazamientos.
              </p>
              <ul class="values reveal">
                <li><Icon name="check" /> Ideal para novias, quinceañeras y grupos</li>
                <li><Icon name="check" /> Llego puntual con mis herramientas y productos</li>
                <li><Icon name="check" /> El recargo depende del sector; lo confirmamos por WhatsApp</li>
              </ul>
              <div class="hero-cta reveal">
                <a href={wa('¡Hola Betsy! Quiero un peinado a domicilio 🏡')} class="btn btn-light" target="_blank" rel="noopener">
                  <Icon name="whatsapp" /> Pedir servicio a domicilio
                </a>
              </div>
            </div>
            <div class="orbit reveal" data-fx="zoom" aria-hidden="true">
              <span class="orbit-ring r1" />
              <span class="orbit-ring r2" />
              <span class="orbit-core"><Icon name="home" size={64} /></span>
              <span class="tag t-a">Novias</span>
              <span class="tag t-b">Quinceañeras</span>
              <span class="tag t-c">Grupos</span>
              <span class="pin"><Icon name="pin" size={20} /></span>
            </div>
          </div>
        </section>
      )
    }

    <!-- ───────── GALERÍA ───────── -->
    <section id="galeria" class="section gallery-sec">
      <div class="wrap">
        <div class="head">
          <div>
            <p class="eyebrow reveal">Galería</p>
            <h2 class="reveal">Trabajos que <em>enamoran</em></h2>
          </div>
          <div class="g-tools reveal">
            <button type="button" class="g-arrow prev" data-g-prev aria-label="Fotos anteriores"><Icon name="chevron" size={22} /></button>
            <button type="button" class="g-arrow" data-g-next aria-label="Más fotos"><Icon name="chevron" size={22} /></button>
            <a href={`https://www.instagram.com/${s.instagram}`} target="_blank" rel="noopener" class="btn btn-ghost">
              <Icon name="instagram" /> Ver más en Instagram
            </a>
          </div>
        </div>
      </div>
      <div class="g-rail" data-g-rail>
        <div class="gallery">
          {
            shown.length > 0
              ? shown.map((g, i) => (
                  <figure class="g-item reveal" data-fx="zoom" data-delay={String(i % 3)}>
                    <button type="button" class="g-btn" data-lb-open={String(i)} aria-label={`Ampliar foto: ${g.alt || 'peinado'}`}>
                      <img src={g.url} alt={g.alt} loading="lazy" decoding="async" width="600" height="800" />
                      <span class="g-zoom" aria-hidden="true">
                        <Icon name="plus" size={22} />
                      </span>
                    </button>
                  </figure>
                ))
              : placeholders.map((p, i) => (
                  <figure class={`g-item ph ${p.k} reveal`} data-fx="zoom" data-delay={String(i % 3)}>
                    <svg viewBox="0 0 300 400" preserveAspectRatio="none" aria-hidden="true">
                      {Array.from({ length: 7 }, (_, j) => (
                        <path
                          d={`M${20 + j * 42} -10 C ${60 + j * 42} 100, ${-10 + j * 42} 220, ${40 + j * 42} 410`}
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-opacity=".35"
                        />
                      ))}
                    </svg>
                    <figcaption>{p.label}</figcaption>
                  </figure>
                ))
          }
        </div>
      </div>
      <p class="wrap g-hint" aria-hidden="true">Desliza para ver más →</p>
    </section>

    <!-- ───────── SOBRE MÍ ───────── -->
    <section id="sobre-mi" class="section about">
      <div class="wrap about-grid">
        <figure class="about-art reveal" data-fx="left">
          <div class="pebble p2" aria-hidden="true"></div>
          <div class="pebble p3" aria-hidden="true"></div>
          <div class="pebble p1 photo">
            <img src="/betsy.webp" alt="Betsy, estilista de Betsy Peinados en Valledupar" width="360" height="450" loading="lazy" decoding="async" />
          </div>
          <svg class="about-spark" viewBox="0 0 120 120" aria-hidden="true">
            <path d="M60 6c3 24 13 34 38 38-25 4-35 14-38 38-3-24-13-34-38-38 25-4 35-14 38-38Z"></path>
          </svg>
          <figcaption class="quote">
            <span class="quote-mark" aria-hidden="true">“</span>
            Cada peinado es una historia que se cuenta con las manos.
          </figcaption>
        </figure>
        <div>
          <p class="eyebrow reveal">Sobre mí</p>
          <h2 class="reveal">Hola, soy <em>Betsy</em></h2>
          <p class="lead about-lead reveal">{s.about}</p>
          <ul class="values reveal">
            <li><Icon name="check" /> Atención personalizada y sin afán</li>
            <li><Icon name="check" /> Productos profesionales y fijación duradera</li>
            <li><Icon name="check" /> Alianzas con maquilladoras para tu look completo</li>
          </ul>
          <p class="sign reveal">
            <span>Betsy</span>
            <a href={`https://www.instagram.com/${s.instagram}`} target="_blank" rel="noopener">
              <Icon name="instagram" size={18} /> @{s.instagram}
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- ───────── CÓMO FUNCIONA ───────── -->
    <section class="section steps-sec">
      <div class="wrap">
        <div class="steps-head">
          <p class="eyebrow reveal">Así de fácil</p>
          <h2 class="reveal">Tu cita en tres <em>pasos</em></h2>
        </div>
        <ol class="steps">
          <li class="reveal">
            <span class="num" aria-hidden="true">01</span>
            <span class="step-ic"><Icon name="sparkle" size={24} /></span>
            <h3>Elige tu peinado</h3>
            <p>Mira los servicios y escoge el que va con tu ocasión.</p>
          </li>
          <li class="reveal" data-delay="2">
            <span class="num" aria-hidden="true">02</span>
            <span class="step-ic"><Icon name="calendar" size={24} /></span>
            <h3>Reserva el horario</h3>
            <p>Ves en tiempo real los espacios libres y apartas el tuyo.</p>
          </li>
          <li class="reveal" data-delay="4">
            <span class="num" aria-hidden="true">03</span>
            <span class="step-ic"><Icon name="check" size={24} /></span>
            <h3>Llega y brilla</h3>
            <p>Recibes la confirmación y yo me encargo de que luzcas increíble.</p>
          </li>
        </ol>
        <div class="center reveal">
          <a href="/reservar" class="btn btn-clay"><Icon name="calendar" /> Empezar mi reserva</a>
        </div>
      </div>
    </section>

    <!-- ───────── FAQ ───────── -->
    <section class="section faq-sec">
      <div class="wrap faq-grid">
        <div class="faq-aside">
          <p class="eyebrow reveal">Preguntas frecuentes</p>
          <h2 class="reveal">Todo lo que necesitas <em>saber</em></h2>
          <p class="lead reveal">¿No encuentras tu respuesta? Escríbeme y te cuento todo antes de reservar.</p>
          <a href={wa('¡Hola Betsy! Tengo una pregunta 💬')} class="btn btn-ghost reveal" target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Preguntar por WhatsApp
          </a>
        </div>
        <div class="faq" data-faq>
          {
            FAQ.map((f, i) => (
              <details class:list={['reveal', { 'is-open': i === 0 }]} data-delay={String(Math.min(i, 5))} open={i === 0}>
                <summary>
                  <span class="q-num" aria-hidden="true">{pad(i + 1)}</span>
                  <span class="q-text">{f.q}</span>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <div class="faq-body">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ───────── CONTACTO ───────── -->
    <section id="contacto" class="section contact">
      <div class="wrap contact-grid">
        <div class="contact-card reveal">
          <p class="eyebrow">Contacto</p>
          <h2>¿Lista para tu <em>nuevo look</em>?</h2>
          <ul class="contact-list">
            <li><span class="c-ic"><Icon name="pin" size={18} /></span> <span>{s.address}</span></li>
            <li>
              <span class="c-ic"><Icon name="whatsapp" size={18} /></span>
              <a href={wa('¡Hola Betsy! ✨')} target="_blank" rel="noopener">{s.phone}</a>
            </li>
            <li>
              <span class="c-ic"><Icon name="instagram" size={18} /></span>
              <a href={`https://www.instagram.com/${s.instagram}`} target="_blank" rel="noopener">@{s.instagram}</a>
            </li>
            <li><span class="c-ic"><Icon name="mail" size={18} /></span> <a href={`mailto:${s.email}`}>{s.email}</a></li>
          </ul>
          <h3 class="hours-title"><Icon name="clock" /> Horario</h3>
          <dl class="hours" data-hours>
            {
              hourRows.map((h) => (
                <div data-wd={String(h.weekday)} class:list={[{ closed: !h.enabled }]}>
                  <dt>{WEEKDAYS[h.weekday]}</dt>
                  <dd>{h.enabled ? `${h.open_time.slice(0, 5)} – ${h.close_time.slice(0, 5)}` : 'Cerrado'}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="map reveal" data-delay="1">
          <iframe
            title={`Mapa: ${s.address}`}
            src={`https://www.google.com/maps?q=${encodeURIComponent(s.maps_query)}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <!-- ───────── CTA FINAL ───────── -->
    <section class="final">
      <div class="wrap">
        <div class="final-inner reveal" data-fx="zoom">
          <span class="f-blob fb1" aria-hidden="true"></span>
          <span class="f-blob fb2" aria-hidden="true"></span>
          <svg class="f-spark" viewBox="0 0 120 120" aria-hidden="true">
            <path d="M60 6c3 24 13 34 38 38-25 4-35 14-38 38-3-24-13-34-38-38 25-4 35-14 38-38Z"></path>
          </svg>
          <p class="final-kicker">Agenda abierta</p>
          <h2>Tu próximo gran día empieza con un <em>gran peinado</em></h2>
          <div class="final-cta">
            <a href="/reservar" class="btn btn-light">Reservar ahora <Icon name="arrow" /></a>
            <a href={wa('¡Hola Betsy! Quiero agendar un peinado ✨')} class="btn btn-outline-light" target="_blank" rel="noopener">
              <Icon name="whatsapp" /> WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── VISOR DE FOTOS ───────── -->
    {
      shown.length > 0 && (
        <dialog class="lb" data-lb aria-label="Foto ampliada">
          <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Cerrar">
            <Icon name="close" size={22} />
          </button>
          <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Foto anterior">
            <Icon name="chevron" size={24} />
          </button>
          <img data-lb-img alt="" />
          <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Foto siguiente">
            <Icon name="chevron" size={24} />
          </button>
          <p class="lb-count" data-lb-count aria-live="polite" />
        </dialog>
      )
    }
  </main>
  <Footer s={s} />
  <WhatsAppFab number={s.whatsapp} />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Acordeón de preguntas frecuentes: abre y cierra con altura animada ──
  const faq = document.querySelector<HTMLElement>('[data-faq]');
  if (faq) {
    faq.classList.add('js');
    const items = [...faq.querySelectorAll<HTMLDetailsElement>('details')];
    const anims = new WeakMap<HTMLDetailsElement, Animation>();
    const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

    const setOpen = (d: HTMLDetailsElement, open: boolean) => {
      const body = d.querySelector<HTMLElement>('.faq-body');
      if (!body || d.classList.contains('is-open') === open) return;
      d.classList.toggle('is-open', open);
      if (reduce) {
        d.open = open;
        return;
      }
      const from = d.open ? body.getBoundingClientRect().height : 0;
      anims.get(d)?.cancel();
      d.open = true;
      const to = open ? body.scrollHeight : 0;
      const a = body.animate(
        { height: [`${from}px`, `${to}px`], opacity: [open ? 0 : 1, open ? 1 : 0] },
        { duration: Math.min(520, 260 + Math.abs(to - from) * 1.2), easing: EASE },
      );
      anims.set(d, a);
      a.onfinish = () => {
        anims.delete(d);
        if (!open) d.open = false;
      };
    };

    for (const d of items) {
      d.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        const open = !d.classList.contains('is-open');
        if (open) items.forEach((o) => o !== d && setOpen(o, false));
        setOpen(d, open);
      });
      // Si el navegador lo abre solo (por ejemplo al buscar en la página), sincroniza el estado.
      d.addEventListener('toggle', () => {
        if (d.open && !d.classList.contains('is-open') && !anims.has(d)) d.classList.add('is-open');
      });
    }
  }

  // ── Horario: resalta el día de hoy (hora de Colombia) ──
  const hours = document.querySelector<HTMLElement>('[data-hours]');
  if (hours) {
    const short = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Bogota', weekday: 'short' }).format(new Date());
    const wd = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(short);
    hours.querySelector(`[data-wd="${wd}"]`)?.classList.add('today');
  }

  // ── Galería: arrastrar con el mouse y flechas ──
  const rail = document.querySelector<HTMLElement>('[data-g-rail]');
  if (rail) {
    const prev = document.querySelector<HTMLButtonElement>('[data-g-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-g-next]');
    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth - 2;
      if (prev) prev.disabled = rail.scrollLeft <= 2;
      if (next) next.disabled = rail.scrollLeft >= max;
    };
    const step = () => Math.max(260, rail.clientWidth * 0.7);
    prev?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
    next?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
    let startX = 0;
    let startLeft = 0;
    let down = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      startX = e.clientX;
      startLeft = rail.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) rail.classList.add('dragging');
      if (rail.classList.contains('dragging')) rail.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      down = false;
      // deja pasar un instante para que el clic del arrastre no abra la foto
      requestAnimationFrame(() => rail.classList.remove('dragging'));
    });
  }

  // ── Visor de fotos de la galería ──
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-lb-open]')];
    let idx = 0;
    const show = (i: number) => {
      idx = (i + thumbs.length) % thumbs.length;
      const src = thumbs[idx].querySelector('img');
      if (!src) return;
      img.classList.remove('ready');
      img.src = src.currentSrc || src.src;
      img.alt = src.alt;
      count.textContent = `${idx + 1} / ${thumbs.length}`;
      requestAnimationFrame(() => img.classList.add('ready'));
    };
    thumbs.forEach((b, i) =>
      b.addEventListener('click', () => {
        show(i);
        lb.showModal();
        // Bloquea el scroll de la página de fondo mientras el visor está abierto.
        document.documentElement.classList.add('no-scroll');
      }),
    );
    lb.addEventListener('close', () => document.documentElement.classList.remove('no-scroll'));
    lb.querySelector('[data-lb-close]')?.addEventListener('click', () => lb.close());
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) lb.close();
    });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    let x0: number | null = null;
    lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>

