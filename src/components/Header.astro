---
import Icon from './Icon.astro';
interface Props {
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const links = [
  { href: '/#paquetes', label: 'Paquetes' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#domicilio', label: 'A domicilio' },
  { href: '/#galeria', label: 'Galería' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Betsy Peinados, inicio">
      <img src="/logo.webp" alt="" width="52" height="52" class="logo-img" />
      <span class="logo-text"><span class="logo-mark">Betsy</span><span class="logo-sub">peinados</span></span>
    </a>
    {
      !minimal && (
        <nav aria-label="Principal" class="nav" id="menu" data-menu>
          <ul>
            {links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
          <a href="/reservar" class="btn btn-clay nav-cta">
            Reservar cita <Icon name="arrow" />
          </a>
        </nav>
      )
    }
    {
      !minimal && (
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
          <span class="sr-only">Abrir menú</span>
          <Icon name="menu" size={24} />
        </button>
      )
    }
    {
      minimal && (
        <a href="/" class="back">
          ← Volver al inicio
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.35rem;
    transition: padding 0.4s var(--ease);
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    gap: 1rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background-color 0.35s, box-shadow 0.35s, border-color 0.35s, padding 0.4s var(--ease), min-height 0.4s var(--ease);
  }
  /* al bajar, la barra se convierte en una píldora flotante */
  .site-header.scrolled {
    padding-block: 0.6rem;
  }
  .site-header.scrolled .bar {
    min-height: 62px;
    padding-inline: 0.9rem 0.6rem;
    background: color-mix(in oklab, var(--white) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-color: color-mix(in oklab, var(--cocoa) 9%, transparent);
    box-shadow: 0 14px 40px -22px rgb(42 28 22 / 0.5);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    line-height: 1;
  }
  .logo-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    box-shadow: 0 6px 18px -8px rgba(42, 28, 22, 0.35);
    transition: transform 0.5s var(--ease);
  }
  .logo:hover .logo-img {
    transform: rotate(-8deg) scale(1.04);
  }
  .logo-text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .logo-mark {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.8rem;
    font-weight: 420;
    color: var(--cocoa);
  }
  .logo-sub {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--clay);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    display: block;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--cocoa-2);
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    transition: background-color 0.3s, color 0.3s;
  }
  .nav ul a:hover {
    background: color-mix(in oklab, var(--blush) 38%, transparent);
    color: var(--cocoa);
  }
  .nav ul a.active {
    background: var(--cocoa);
    color: var(--cream);
  }
  .nav-cta {
    min-height: 46px;
    padding-inline: 1.3rem;
  }
  .menu-btn {
    display: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: var(--white);
    color: var(--cocoa);
    place-items: center;
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease);
  }
  .menu-btn[aria-expanded='true'] {
    background: var(--cocoa);
    color: var(--cream);
    transform: rotate(90deg);
  }
  .back {
    font-weight: 600;
    text-decoration: none;
    color: var(--cocoa-2);
  }
  @media (max-width: 940px) {
    .menu-btn {
      display: grid;
    }
    .nav {
      position: absolute;
      inset: calc(100% + 0.6rem) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.2rem;
      padding: 1.4rem 1.4rem 1.6rem;
      border-radius: 30px;
      background: var(--white);
      border: 1px solid color-mix(in oklab, var(--cocoa) 9%, transparent);
      box-shadow: 0 40px 60px -30px rgb(42 28 22 / 0.5);
      transform: translateY(-10px) scale(0.98);
      transform-origin: top;
      opacity: 0;
      visibility: hidden;
      transition: transform 0.4s var(--ease), opacity 0.3s, visibility 0.3s;
    }
    .nav.open {
      transform: none;
      opacity: 1;
      visibility: visible;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul li {
      border-bottom: 1px solid var(--line);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    }
    .nav.open ul li {
      opacity: 1;
      transform: none;
    }
    .nav.open ul li:nth-child(2) {
      transition-delay: 0.04s;
    }
    .nav.open ul li:nth-child(3) {
      transition-delay: 0.08s;
    }
    .nav.open ul li:nth-child(4) {
      transition-delay: 0.12s;
    }
    .nav.open ul li:nth-child(5) {
      transition-delay: 0.16s;
    }
    .nav ul a,
    .nav ul a.active,
    .nav ul a:hover {
      font-family: var(--font-display);
      font-size: 1.55rem;
      font-weight: 400;
      padding: 0.7rem 0.2rem;
      border-radius: 0;
      background: none;
      color: var(--cocoa);
    }
    .nav ul a.active {
      font-style: italic;
      color: var(--clay);
    }
  }
  @media (max-width: 420px) {
    .logo-sub {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
  };
  btn?.addEventListener('click', () => setMenu(!menu?.classList.contains('open')));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('open') && !header?.contains(e.target as Node)) setMenu(false);
  });

  // Resalta en el menú la sección que se está viendo.
  const links = new Map<string, HTMLAnchorElement>();
  menu?.querySelectorAll<HTMLAnchorElement>('ul a[href*="#"]').forEach((a) => links.set(a.hash.slice(1), a));
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('active'));
          links.get(e.target.id)?.classList.add('active');
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((el) => spy.observe(el));
    const top = document.querySelector('.hero');
    if (top) {
      new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) links.forEach((a) => a.classList.remove('active'));
        },
        { rootMargin: '-45% 0px -50% 0px' },
      ).observe(top);
    }
  }
</script>
