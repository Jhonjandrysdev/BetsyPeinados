---
import Icon from './Icon.astro';
interface Props {
  href: string;
  label?: string;
  whatsapp: string;
}
const { href, label = 'Apartar mi fecha', whatsapp } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta>
  <a href={href} class="btn btn-clay sc-main"><Icon name="calendar" /> {label}</a>
  <a
    href={`https://wa.me/${whatsapp}?text=${encodeURIComponent('¡Hola Betsy! Quiero agendar un peinado ✨')}`}
    class="sc-wa"
    target="_blank"
    rel="noopener"
    aria-label="Escribir por WhatsApp"><Icon name="whatsapp" size={24} /></a
  >
</div>

<script>
  // Aparece al bajar del hero y se esconde cuando el pie de página está a la vista.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  if (bar) {
    const update = () => {
      const footer = document.querySelector('footer');
      const nearEnd = footer ? footer.getBoundingClientRect().top < window.innerHeight : false;
      bar.classList.toggle('on', window.scrollY > window.innerHeight * 0.6 && !nearEnd);
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .sticky-cta {
    display: none;
  }
  @media (max-width: 760px) {
    .sticky-cta {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 61;
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding: 0.7rem max(1rem, env(safe-area-inset-right)) max(0.7rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
      background: color-mix(in oklab, var(--cream) 92%, transparent);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
      transform: translateY(110%);
      transition: transform 0.35s var(--ease);
    }
    .sticky-cta.on {
      transform: none;
    }
    .sc-main {
      flex: 1;
      justify-content: center;
    }
    .sc-wa {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #1faa59;
      color: #fff;
    }
    /* La barra ya trae WhatsApp: se oculta el botón flotante en celular. */
    :global(.fab) {
      display: none !important;
    }
  }
</style>
