# URL pública del sitio (sin / final)
PUBLIC_SITE_URL=https://betsypeinados.com

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa sin service_role: clave cuyo hash SHA-256 está en private.server_keys
SUPABASE_SERVER_KEY=

# Correos con acceso al panel /admin (separados por coma)
ADMIN_EMAILS=betsy@gmail.com

# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web)
# URI de redirección autorizado: https://TU-DOMINIO/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para cifrar el token de Google (genera con: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=
# Sal para anonimizar IPs en el anti-spam (cualquier texto largo aleatorio)
RATE_LIMIT_SALT=

# WhatsApp automático (Meta → WhatsApp Cloud API). Guía: docs/whatsapp-automatico.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Idioma de las plantillas en Meta (todas en el mismo) y su prefijo
WHATSAPP_LANG=es_CO
WHATSAPP_TEMPLATE_PREFIX=betsy_
# ID de la cuenta de WhatsApp Business (WABA), para ver el costo real que reporta Meta
WHATSAPP_WABA_ID=
# Clave del recordatorio automático del día anterior (Vercel la manda al cron)
CRON_SECRET=
